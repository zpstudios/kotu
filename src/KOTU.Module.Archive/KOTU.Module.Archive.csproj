<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>압축 모듈: 해제(zip·7z·rar·tar·gz 등)/생성(zip·7z)/내부 탐색/암호/CP949 자동 대응.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <!-- 7z.dll 래퍼(LGPL 준수: dll 동적 로드만, 코드 복사 금지) -->
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.*" />
    <!-- zip 항목명 CP949 재시도 경로 -->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      7z.dll(x64)은 LGPL이라 NuGet에 동봉하지 않는다.
      7-Zip 설치본(C:\Program Files\7-Zip\7z.dll) 또는 7-zip.org의 "7z extra"에서
      x64용 7z.dll을 이 프로젝트의 runtimes\win-x64\ 에 두면 빌드 시 출력 폴더로 복사된다.
      (없어도 빌드는 되고, 실행 시 안내 예외가 뜬다 — README 참고)
    -->
    <None Include="runtimes\win-x64\7z.dll"
          Condition="Exists('runtimes\win-x64\7z.dll')"
          Link="7z.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
