<UserControl
    x:Class="KOTU.Module.Archive.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.Module.Archive"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (v0.40.0 — 전 모듈 전체화면 지원).
         버튼 단독 문자 키(E 여기에 풀기 · T 폴더 지정 풀기 · C 새 압축 · O 열기 · U 상위 폴더)는
         A34에서 코드(SetupHotkeys)가 건다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들기 위해서다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 툴바 -->
            <RowDefinition Height="Auto" />
            <!-- 브레드크럼 -->
            <RowDefinition Height="Auto" />
            <!-- 열 머리글 -->
            <RowDefinition Height="*" />
            <!-- 항목 목록 -->
            <RowDefinition Height="Auto" />
            <!-- 진행/상태 -->
        </Grid.RowDefinitions>

        <!-- 상단 툴바 (열기 버튼은 셸 하단 바 좌측으로 이동 — v0.40.0 사용자 요청).
             A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExtractToButton" Content="Extract..." Click="OnExtractToClick" IsEnabled="False" />
            <Button x:Name="ExtractHereButton" Content="Extract here" Click="OnExtractHereClick" IsEnabled="False" />
            <Button x:Name="CreateButton" Content="New archive">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="As ZIP..." Click="OnCreateZipClick" />
                        <MenuFlyoutItem Text="As 7z..." Click="OnCreate7zClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- 브레드크럼 + 뒤로가기 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" Click="OnBackClick" IsEnabled="False">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="BreadcrumbText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 열 머리글 -->
        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontSize="12" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="Size" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" FontSize="12" Opacity="0.6" />
        </Grid>

        <!-- 항목 목록 -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="EntryList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="Extended"
                IsDoubleTapEnabled="True"
                DoubleTapped="OnEntryDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ArchiveRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="PlaceholderText"
                Text="Open an archive, or drop files here to create one"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6" />
        </Grid>

        <!-- 하단 상태바: 열기 · 상태 · 진행/취소 · 전체화면.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.40.0 —
             열기 버튼이 메뉴 버튼 바로 우측에 오도록, 이미지 v0.27.0과 동일 통합). -->
        <Border x:Name="StatusBar" Grid.Row="4" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- 상태 텍스트(작업 중·파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(40×40)·2칸(84×40) 두 규격만 —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다.
                     상단 툴바(Extract 등)는 본문 버튼이라 대상이 아니다. -->
                <Button x:Name="OpenButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnOpenClick">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 아카이브가 있는 드라이브" 텍스트를 대체한다 —
                     상태 텍스트와 같은 칸을 쓰고, 상태 문구가 있으면 그쪽이 우선이다. -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="1"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <ProgressBar x:Name="OperationProgress" Grid.Column="2" Width="160"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <!-- "Cancel"은 1칸(40)에 안 들어가는 텍스트라 2칸 규격 -->
                <Button x:Name="CancelButton" Grid.Column="3" Style="{StaticResource BottomBarWideButtonStyle}"
                        Content="Cancel"
                        Click="OnCancelClick" Visibility="Collapsed" />
                <!-- 1칸(40×40) = 이미지/영상 ⛶와 통일 (v0.53.0 → A27에서 전역 스타일) -->
                <Button Grid.Column="4" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
