<UserControl
    x:Class="KOTU.Module.Archive.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.Module.Archive"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 전체화면 계열(F11·Esc 액셀러레이터, v0.40.0)은 A151에서 제거 — 전체화면은 셸의
         3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다.
         버튼 단독 문자 키(E 여기에 풀기 · T 폴더 지정 풀기 · C 새 압축 · U 상위 폴더)는
         A34에서 코드(SetupHotkeys)가 건다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들기 위해서다.
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. -->

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 브레드크럼 -->
            <RowDefinition Height="Auto" />
            <!-- 열 머리글 -->
            <RowDefinition Height="*" />
            <!-- 항목 목록 -->
            <RowDefinition Height="Auto" />
            <!-- 진행/상태 -->
        </Grid.RowDefinitions>

        <!-- A296: 상단 툴바 행은 제거 — A271(New archive 이동)에 이어 잔여 버튼 전부
             (Extract 2종·Back)를 하단 바로 옮기고 행 자체를 걷어 목록이 그 높이를 얻는다.
             근거는 A271과 동일: ① 빈 상태(S1)에서는 셸 썸네일 탐색기(A93)가 본문을 통째로 덮어
             상단 툴바가 보이지 않고 ② 다른 파일 모듈은 액션 버튼을 전부 하단 바에 둔다.
             브레드크럼은 버튼이 아니라 본문 정보(현재 위치)라 여기 남는다. -->
        <TextBlock x:Name="BreadcrumbText" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- 열 머리글 -->
        <Grid Grid.Row="1" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontSize="12" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="Size" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" FontSize="12" Opacity="0.6" />
        </Grid>

        <!-- 항목 목록 -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="EntryList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="Extended"
                IsDoubleTapEnabled="True"
                DoubleTapped="OnEntryDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ArchiveRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="PlaceholderText"
                Text="Open an archive, or drop files here to create one"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6" />
        </Grid>

        <!-- 하단 상태바: 좌측 액션군 · 상태 · 진행/취소.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.40.0, 이미지 v0.27.0과 동일 통합).
             열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
             전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.

             A271(v0.269.0)이 공통군 c0 New archive(활성) · c1 Print(영구 비활성) · 우측 끝 Fit
             조절기(영구 비활성)를 신설했으나, A296(정정)에서 Print·Fit은 **제거**했다(사용자 확정 —
             압축 모듈에 인쇄·맞춤이 생길 일이 없어 "시각 정렬용 영구 비활성" 제3층 자체를 접는다.
             A271의 층 구분 주석도 함께 소멸). 대신 상단 툴바의 실동작 버튼 전부(Back·Extract 2종)가
             이 바로 내려와 좌측군을 이룬다(A296) — 좌측군 순서(확정) = Back · New archive ·
             Extract... · Extract here(탐색 → 생성 → 추출).
             쓸 수 없는 상황의 버튼은 숨기지 않고 비활성만 한다(A249 층 구분 유지).
             Cancel·진행 막대·상태 텍스트는 현행 그대로다(Cancel의 busy 한정 표시 = A249 확정 예외 —
             ArchiveView.xaml.cs SetBusy 주석). -->
        <Border x:Name="StatusBar" Grid.Row="3" Padding="0,2,0,2">
            <!-- ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- c0 A296: Back(구 상단 브레드크럼 옆 — 좌측군 1번째) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c1 New archive(A271에서 상단 툴바로부터 이동 — A296 재계수로 c0 → c1) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c2 A296: Extract...(상단 툴바에서 이동) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c3 A296: Extract here(상단 툴바에서 이동) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c4 상태 텍스트(작업 중·파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 —
                         이 바의 **유일한 star 칸**이다(구 c2 — A296 재계수). 다른 칸은 전부 Auto라
                         남는 폭을 계속 여기가 흡수한다(폭 임계 축약 로직이 없는 바 = 파생 수치 0). -->
                    <ColumnDefinition Width="*" />
                    <!-- c5 진행 막대(busy 한정 — 구 c3) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c6 Cancel(busy 한정 — A249 확정 예외. 구 c4) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다 —
                     그래서 아래 좌측군 버튼들에는 ToolTipService.ToolTip을 적지 않는다
                     (적으면 키 표기와 두 출처가 생긴다). -->
                <!-- A296 c0: 뒤로가기(구 브레드크럼 옆 BackButton — x:Name·핸들러·U 키(A34) 그대로
                     이동, 글리프 E72B 그대로). A159: 이 버튼은 **항상 활성**이다(IsEnabled 갱신
                     없음 — UpdateToolbarState 주석). 클릭 = 폴더 안이면 한 층 위(NavigateBack),
                     루트면 셸에 콘텐츠 닫기 요청(IContentCloseRequestSource — Esc 말단 층과 같은
                     결과). U 키는 '위로' 의미만 유지해 루트에서는 무동작이다(OnBackClick 주석). -->
                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnBackClick">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <!-- A271 c0 → A296 c1: 새 압축. 상단 툴바에 있던 CreateButton을 그대로 옮긴 것이라
                     Content 텍스트만 1칸 규격 아이콘으로 바뀌었다 — 글리프 F012(ZipFolder)는
                     압축 모듈 자신의 아이콘(ArchiveModule.IconGlyph)과 같은 값이다.
                     플라이아웃에 Placement="Top"을 더했다: 하단 바에서 열리는 메뉴는 위로
                     펴져야 한다(오디오 DevicesFlyout·EqFlyout·영상 SubtitleFlyout과 같은 형).
                     C 키(SetupHotkeys)의 동작 = 이 플라이아웃 열기 그대로.
                     활성 = 작업 중이 아님(UpdateToolbarState) — 아카이브가 없어도 활성이다
                     (빈 상태에서 새 압축을 시작하는 것이 이 버튼의 주 용도). -->
                <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}">
                    <FontIcon Glyph="&#xF012;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="As ZIP..." Click="OnCreateZipClick" />
                            <MenuFlyoutItem Text="As 7z..." Click="OnCreate7zClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- A296 c2·c3: 풀기 2종(상단 툴바에서 이동 — x:Name·핸들러·E/T 키(A34)·활성 조건
                     (UpdateToolbarState: 아카이브 열림이고 작업 중 아님) 전부 그대로).
                     텍스트("Extract...", "Extract here")는 1칸 규격(32×32)에 안 들어가 아이콘으로
                     바꿨다 — A271의 CreateButton 전환과 같은 형(문구는 A34 툴팁이 그대로 나른다).
                     글리프: E8DA(OpenLocal — 폴더를 골라 그리로 풀기) ·
                     E896(Download — 지금 이 자리에 내려놓기. 셸 트레이 메뉴 'Min to tray'와 같은
                     글리프지만 표면이 달라 충돌하지 않는다). -->
                <Button x:Name="ExtractToButton" Grid.Column="2" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnExtractToClick" IsEnabled="False">
                    <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                </Button>
                <Button x:Name="ExtractHereButton" Grid.Column="3" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnExtractHereClick" IsEnabled="False">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="4" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 아카이브가 있는 드라이브" 텍스트를 대체한다 —
                     상태 텍스트와 같은 칸을 쓰고, 상태 문구가 있으면 그쪽이 우선이다. -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="4"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <ProgressBar x:Name="OperationProgress" Grid.Column="5" Width="160"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <!-- "Cancel"은 1칸(32)에 안 들어가는 텍스트라 2칸 규격 -->
                <Button x:Name="CancelButton" Grid.Column="6" Style="{StaticResource BottomBarWideButtonStyle}"
                        Content="Cancel"
                        Click="OnCancelClick" Visibility="Collapsed" />
                <!-- A271의 우측 끝 Fit 조절기(영구 비활성 2버튼)는 A296에서 제거됨 —
                     압축 모듈에 확대·맞춤 개념이 없고, 시각 정렬용 영구 비활성층을 접기로 확정. -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
