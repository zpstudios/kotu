<UserControl
    x:Class="KOTU.Module.Archive.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.Module.Archive"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (v0.40.0 — 전 모듈 전체화면 지원) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 툴바 -->
            <RowDefinition Height="Auto" />
            <!-- 브레드크럼 -->
            <RowDefinition Height="Auto" />
            <!-- 열 머리글 -->
            <RowDefinition Height="*" />
            <!-- 항목 목록 -->
            <RowDefinition Height="Auto" />
            <!-- 진행/상태 -->
        </Grid.RowDefinitions>

        <!-- 상단 툴바 (열기 버튼은 셸 하단 바 좌측으로 이동 — v0.40.0 사용자 요청) -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExtractToButton" Content="Extract..." Click="OnExtractToClick" IsEnabled="False"
                    ToolTipService.ToolTip="Choose a folder to extract into (only selected items, if any)" />
            <Button x:Name="ExtractHereButton" Content="Extract here" Click="OnExtractHereClick" IsEnabled="False"
                    ToolTipService.ToolTip="Extract into a folder named after the archive, next to it" />
            <Button x:Name="CreateButton" Content="New archive">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="As ZIP..." Click="OnCreateZipClick" />
                        <MenuFlyoutItem Text="As 7z..." Click="OnCreate7zClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- 브레드크럼 + 뒤로가기 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" Click="OnBackClick" IsEnabled="False"
                    ToolTipService.ToolTip="Up one level">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="BreadcrumbText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 열 머리글 -->
        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontSize="12" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="Size" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" FontSize="12" Opacity="0.6" />
        </Grid>

        <!-- 항목 목록 -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="EntryList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="Extended"
                IsDoubleTapEnabled="True"
                DoubleTapped="OnEntryDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ArchiveRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="PlaceholderText"
                Text="Open an archive, or drop files here to create one"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6" />
        </Grid>

        <!-- 하단 상태바: 열기 · 상태 · 진행/취소 · 전체화면.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.40.0 —
             열기 버튼이 메뉴 버튼 바로 우측에 오도록, 이미지 v0.27.0과 동일 통합). -->
        <Border x:Name="StatusBar" Grid.Row="4" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Grid.Column="0" Click="OnOpenClick"
                        ToolTipService.ToolTip="Open archive">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- 현재 아카이브가 있는 드라이브 요약 (v0.47.0 사용자 요청) -->
                <TextBlock x:Name="DriveInfoText" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.6" />
                <ProgressBar x:Name="OperationProgress" Grid.Column="3" Width="160"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel"
                        Click="OnCancelClick" Visibility="Collapsed" VerticalAlignment="Center" />
                <!-- 40×40 정사각 아이콘 = 이미지/영상 ⛶와 통일 (v0.53.0) -->
                <Button Grid.Column="5" Width="40" Height="40" Padding="4"
                        Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
