<UserControl
    x:Class="KOTU.Module.Archive.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.Module.Archive"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 전체화면 계열(F11·Esc 액셀러레이터, v0.40.0)은 A151에서 제거 — 전체화면은 셸의
         3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다.
         버튼 단독 문자 키(E 여기에 풀기 · T 폴더 지정 풀기 · C 새 압축 · U 상위 폴더)는
         A34에서 코드(SetupHotkeys)가 건다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들기 위해서다.
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. -->

    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 툴바 -->
            <RowDefinition Height="Auto" />
            <!-- 브레드크럼 -->
            <RowDefinition Height="Auto" />
            <!-- 열 머리글 -->
            <RowDefinition Height="*" />
            <!-- 항목 목록 -->
            <RowDefinition Height="Auto" />
            <!-- 진행/상태 -->
        </Grid.RowDefinitions>

        <!-- 상단 툴바 (열기 버튼은 v0.40.0에 하단 바로 이동한 뒤 A99에서 제거 — 셸 S4로 일원화).
             A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다.
             A271(v0.269.0): "New archive"(CreateButton)도 하단 바 c0으로 옮겼다 — 미러가 아니라
             이동이다. 근거 2가지: ① 압축 모듈도 파일 모듈이라 아카이브가 없는 빈 상태(S1)에서는
             셸 썸네일 탐색기(A93)가 이 본문을 통째로 덮어 상단 툴바가 보이지 않는다 — 정작 새
             압축을 시작할 상태에서 진입점이 사라지는 자리였다(문서 모듈이 New를 하단 바에 둔
             것과 같은 이유). ② 상하 병존은 중복 진입점이라 저장소가 이미 두 번 정리한 형태다
             (A99 열기 버튼·A256 Open 버튼). 이동이므로 x:Name·플라이아웃·클릭 핸들러·C 키
             (SetupHotkeys)·IsEnabled 갱신(UpdateToolbarState)은 전부 그대로다. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExtractToButton" Content="Extract..." Click="OnExtractToClick" IsEnabled="False" />
            <Button x:Name="ExtractHereButton" Content="Extract here" Click="OnExtractHereClick" IsEnabled="False" />
        </StackPanel>

        <!-- 브레드크럼 + 뒤로가기 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" Click="OnBackClick" IsEnabled="False">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="BreadcrumbText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 열 머리글 -->
        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontSize="12" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="Size" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" FontSize="12" Opacity="0.6" />
        </Grid>

        <!-- 항목 목록 -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="EntryList"
                ItemsSource="{x:Bind Rows}"
                SelectionMode="Extended"
                IsDoubleTapEnabled="True"
                DoubleTapped="OnEntryDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ArchiveRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="PlaceholderText"
                Text="Open an archive, or drop files here to create one"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6" />
        </Grid>

        <!-- 하단 상태바: 공통군 버튼 · 상태 · 진행/취소.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.40.0, 이미지 v0.27.0과 동일 통합).
             열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
             전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.

             A271(v0.269.0): 이 바에는 상시 노출 버튼이 하나도 없어(진행 중에만 뜨는 Cancel뿐)
             모듈을 오갈 때 하단 바가 혼자 텅 비어 보였다. 타 모듈 하단 바와 전수 대조해 얻은
             **공통군**만 신설한다 — 좌측군 c0 New archive(활성) · c1 Print(영구 비활성),
             우측군 c5 Fit 조절기 2버튼(영구 비활성). 회전(이미지 유일)·저장·재생계는 공통이
             아니라 제외했다(2026-08-27 사용자 협의 확정 = "공통군만").

             ※ 층 구분(A249·A236과 섞지 말 것):
               · A249 = "현재 모듈에서 **쓰는** 버튼은 숨기지 말고 비활성만" — 상태에 따라
                 켜졌다 꺼지는 버튼의 이야기다(여기서는 c0 New archive가 그 부류).
               · A236 = "그 화면에서 **아예 안 쓰는 셸 전역** 버튼은 노출 자체를 접는다".
               · 여기 Print·Fit은 그 둘 어디도 아닌 제3의 층이다 — 압축 모듈에서는 **영원히**
                 동작하지 않지만 3모듈 공통 배치의 **시각 정렬을 위해 비활성으로 표시**하는 것이
                 사양이다(A271 확정). 그러니 "안 쓰니 숨기자"(A236)로 되돌리지 말 것이고,
                 "언젠가 켜지는 값"(A249)으로 읽고 갱신 코드를 찾지도 말 것 — 활성 갱신 코드는
                 처음부터 없다.
             Cancel·진행 막대·상태 텍스트는 현행 그대로다(Cancel의 busy 한정 표시 = A249 확정 예외 —
             ArchiveView.xaml.cs SetBusy 주석). -->
        <Border x:Name="StatusBar" Grid.Row="4" Padding="0,2,0,2">
            <!-- ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10).
                 상단 툴바(ColumnSpacing 12)는 본문이라 대상이 아니다. -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- c0 A271: New archive(상단 툴바에서 이동 — 좌측군 1번째) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c1 A271: Print(영구 비활성 — 좌측군 2번째) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c2 상태 텍스트(작업 중·파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 —
                         이 바의 **유일한 star 칸**이다. A271이 좌우로 더한 칸은 전부 Auto라
                         남는 폭을 계속 여기가 흡수한다(폭 임계 축약 로직이 없는 바 = 파생 수치 0). -->
                    <ColumnDefinition Width="*" />
                    <!-- c3 진행 막대(busy 한정) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c4 Cancel(busy 한정 — A249 확정 예외) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c5 A271: Fit 조절기 2버튼(영구 비활성 — 우측 끝, 3모듈 공통 자리) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다.
                     상단 툴바(Extract 등)는 본문 버튼이라 대상이 아니다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다 —
                     그래서 아래 New archive 버튼에는 ToolTipService.ToolTip을 적지 않는다
                     (적으면 C 키 표기와 두 출처가 생긴다). -->
                <!-- A271 c0: 새 압축. 상단 툴바에 있던 CreateButton을 그대로 옮긴 것이라
                     Content 텍스트만 1칸 규격 아이콘으로 바뀌었다 — 글리프 F012(ZipFolder)는
                     압축 모듈 자신의 아이콘(ArchiveModule.IconGlyph)과 같은 값이다.
                     플라이아웃에 Placement="Top"을 더했다: 하단 바에서 열리는 메뉴는 위로
                     펴져야 한다(오디오 DevicesFlyout·EqFlyout·영상 SubtitleFlyout과 같은 형).
                     C 키(SetupHotkeys)의 동작 = 이 플라이아웃 열기 그대로.
                     활성 = 작업 중이 아님(UpdateToolbarState) — 아카이브가 없어도 활성이다
                     (빈 상태에서 새 압축을 시작하는 것이 이 버튼의 주 용도). -->
                <Button x:Name="CreateButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}">
                    <FontIcon Glyph="&#xF012;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="As ZIP..." Click="OnCreateZipClick" />
                            <MenuFlyoutItem Text="As 7z..." Click="OnCreate7zClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- A271 c1: 인쇄 — 규격 정본은 셸 인쇄 절 주석(MainWindow.xaml.cs, 부록 B 78 확정):
                     1칸(32×32) · 글리프 E749 · 툴팁 "Print (Ctrl+P)" · A34 문자 핫키 없음.
                     이미지/문서와 다른 점은 IsEnabled="False"가 **초기값이 아니라 최종값**이라는
                     것뿐이다: 압축 모듈은 IPrintPageProvider를 구현하지 않아(목록 인쇄 미구현)
                     셸의 Ctrl+P도 여기서는 무동작이고, UpdatePrintButton에 해당하는 갱신 코드가
                     없다. 인쇄를 실제로 붙이는 날 할 일 = IPrintPageProvider 구현 + 이 버튼에
                     x:Name·Click을 달고 CanPrintNow로 갱신(지금은 코드가 참조하지 않으므로
                     이름을 붙이지 않는다 — 쓰지 않는 x:Name 선례가 저장소에 0건이고,
                     TreatWarningsAsErrors 환경에서 굳이 첫 사례를 만들 이유가 없다). -->
                <Button Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" FontSize="18" />
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 아카이브가 있는 드라이브" 텍스트를 대체한다 —
                     상태 텍스트와 같은 칸을 쓰고, 상태 문구가 있으면 그쪽이 우선이다. -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="2"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <ProgressBar x:Name="OperationProgress" Grid.Column="3" Width="160"
                             Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                <!-- "Cancel"은 1칸(32)에 안 들어가는 텍스트라 2칸 규격 -->
                <Button x:Name="CancelButton" Grid.Column="4" Style="{StaticResource BottomBarWideButtonStyle}"
                        Content="Cancel"
                        Click="OnCancelClick" Visibility="Collapsed" />
                <!-- A271 c5: Fit 조절기 = 정사각형 버튼 2개(32+32 = 64×32, 간격 0) — A144 규격을
                     이미지/영상/문서 XAML에서 그대로 복제했다(본체 CornerRadius 4,0,0,4 +
                     화살표 왼쪽 테두리 0으로 한 몸처럼 보인다. DropDownButton은 키 있는 기본
                     스타일이 없어 BasedOn 불가(v0.113.1 실기기 이력)라 인라인 값으로 적는다).
                     압축 모듈에는 확대·맞춤 개념이 없어 **영구 비활성**이다(위 층 구분 주석).
                     그래서 타 모듈과 두 곳이 다르다: ① 화살표에 Flyout을 달지 않는다 — 비활성
                     이라 열릴 일이 없고, 4옵션을 흉내 내면 존재하지 않는 Click 핸들러
                     (OnFitContainClick 등)를 요구해 빌드가 깨진다. ② 본체에 Click·A/F 키가 없다
                     (SetupHotkeys에 등록 0건 — 키 누출도 0). 본체 글리프 E9A6은 타 모듈의 초기값
                     (Contain)과 같은 값이고, 여기서는 바뀌지 않는 고정 표시다. -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BottomBarButtonStyle}"
                            CornerRadius="4,0,0,4" IsEnabled="False"
                            ToolTipService.ToolTip="Fit">
                        <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    </Button>
                    <DropDownButton Width="32" Height="32" Padding="4"
                                    BorderThickness="0,1,1,1" CornerRadius="0,4,4,0"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Fit options" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
