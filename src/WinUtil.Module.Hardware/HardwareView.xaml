<UserControl
    x:Class="WinUtil.Module.Hardware.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (v0.42.0 — 전 모듈 전체화면 지원) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 일반 모드: 라벨-값 리스트 (섹션·항목은 코드에서 채운다) -->
        <ScrollViewer x:Name="ListScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="Root"
                Spacing="2"
                Padding="16,4,16,16"
                MaxWidth="760"
                HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- 전체화면 모드: 섹션 카드 대시보드 (v0.42.0 — 코드 RenderDashboard가 채운다) -->
        <ScrollViewer x:Name="DashboardScroller" Grid.Row="0" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DashboardRoot" MaxWidth="1500" Padding="32,24,32,32"
                        Spacing="16" HorizontalAlignment="Center" />
        </ScrollViewer>

        <!-- 센서 스트립(A17→v0.64.2 개편): 평소엔 비어 있고(Collapsed), ① 비관리자 안내(AdminRow)가
             필요할 때 ② 전체화면(하단 바가 숨는 동안 SensorGrid가 여기로 옮겨온다)일 때만 나타난다.
             카드 자체는 코드(BuildSensorCards)가 만들어 하단 바 안 SensorGrid에 얹는다. -->
        <Border x:Name="SensorStrip" Grid.Row="1" Padding="16,4,16,8" Visibility="Collapsed">
            <StackPanel x:Name="StripPanel" Spacing="6">
                <Grid x:Name="AdminRow" Visibility="Collapsed" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" Opacity="0.65"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="CPU temperature, power, fan and drive sensors need administrator rights." />
                    <Button Grid.Column="1" FontSize="12" Padding="10,2,10,3"
                            Content="Restart as admin" Click="OnElevateClick" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 하단 바: 셸이 TakeBottomBar()로 떼어가 한 줄에 얹는다(v0.42.0).
             센서 카드 10개는 이 줄의 가운데 공간(SensorGrid)에 산다(v0.64.2 사용자 지시 —
             별도 줄 금지, 기본 1줄. 창이 좁으면 카드만 2·3줄로 접혀 바가 세로로 자란다).
             우측 끝 ⛶ = 전체화면(전 모듈 공통 배치, 사용자 요청). -->
        <Border x:Name="ControlBar" Grid.Row="2" Padding="0,2,0,2">
            <Grid x:Name="BarGrid" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RefreshButton" Grid.Column="0" Content="Refresh"
                        VerticalAlignment="Center" Click="OnRefreshClick" />
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy all"
                        VerticalAlignment="Center" Click="OnCopyClick" />
                <ProgressRing x:Name="Busy" Grid.Column="2" IsActive="False"
                              Width="20" Height="20" VerticalAlignment="Center" />
                <Grid x:Name="SensorGrid" Grid.Column="3" ColumnSpacing="8" RowSpacing="4"
                      VerticalAlignment="Center" />
                <!-- 맥박(EKG) 그래프(A29): 폴링 스냅샷이 실제 도착한 타이밍마다 스파이크 —
                     주기를 바꾸면 박동 간격이 눈에 보이게 달라진다. 센서 카드와 같은 36px 높이. -->
                <Grid x:Name="PulseHost" Grid.Column="4" Width="90" Height="36"
                      VerticalAlignment="Center"
                      ToolTipService.ToolTip="Refresh pulse — one beat per sensor poll">
                    <Polyline x:Name="PulseLine" Stroke="#2E9E6B" StrokeThickness="1.5" />
                </Grid>
                <!-- 리프레시 주기 선택(A29): 100/300/1000ms — 2칸(90×40) 규격, 우측 정렬.
                     v0.51.0 고정 200ms 표기를 대체. 플라이아웃은 코드에서 채운다. -->
                <DropDownButton x:Name="IntervalButton" Grid.Column="5" Width="90" Height="40"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Sensor refresh interval">
                    <TextBlock x:Name="IntervalText" FontSize="12" Text="300 ms" />
                </DropDownButton>
                <!-- Always on top 토글(A39) — ⛶ 바로 왼쪽, 켜짐 상태가 보이는 ToggleButton -->
                <ToggleButton x:Name="TopToggle" Grid.Column="6" Width="40" Height="40" Padding="4"
                              VerticalAlignment="Center"
                              Checked="OnTopToggleChanged" Unchecked="OnTopToggleChanged"
                              ToolTipService.ToolTip="Always on top">
                    <FontIcon Glyph="&#xE718;" FontSize="18" />
                </ToggleButton>
                <!-- 40×40 정사각 아이콘 = 다른 모듈 ⛶와 통일 (v0.53.0) -->
                <Button Grid.Column="7" Width="40" Height="40" Padding="4"
                        VerticalAlignment="Center" Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen dashboard (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
