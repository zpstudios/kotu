<UserControl
    x:Class="KOTU.Module.Audio.AudioPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 단축키: Space 재생/일시정지, ←/→ 5초 점프, ↑/↓ 볼륨.
         전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 — 전체화면은 셸의 3단 모드 체계
         (Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다.
         버튼에 걸린 단독 문자 키(M 음소거 · S 배속)는 A34에서 코드(SetupHotkeys)로
         옮겼다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들고, 텍스트 입력·파일 리스트
         포커스에서는 통과시켜야 하기 때문. 비디오 플레이어와 동일 배치(A10 분리 — 자막·핏 계열만 없음).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Space" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePlayInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardInvoked" />
        <KeyboardAccelerator Key="Up" Invoked="OnVolumeUpInvoked" />
        <KeyboardAccelerator Key="Down" Invoked="OnVolumeDownInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 시각화 표면: libvlc 시각화(A268 스타일 선택 — 기본 scope 파형, Off면 검은 표면)가 채운다.
             클릭 = 재생/일시정지, 휠 = 볼륨 (핸들러는 코드에서 연결) -->
        <Grid x:Name="AudioSurface" Grid.Row="0" Background="Black" Tapped="OnSurfaceTapped">
            <vlc:VideoView x:Name="Vlc" />
            <!-- 상단에 ♪ + 파일명 (파형이 표면을 채우므로 가리지 않게 작게, 입력 통과) -->
            <StackPanel
                x:Name="TitleOverlay"
                Visibility="Collapsed"
                Orientation="Horizontal"
                Spacing="8"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="Gray"
                          VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleText"
                    Foreground="Gray"
                    FontSize="14"
                    MaxWidth="520"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="PlaceholderText"
                Text="Open a music file, or drop one onto the window&#x0A;▶ = built-in sample tune"
                Visibility="Collapsed"
                Foreground="Gray"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 트랜스포트 바 — 셸이 TakeBottomBar()로 떼어가 하단 바(44px) 한 줄에 얹는다(비디오와 동일).
             ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
        <Grid x:Name="TransportBar" Grid.Row="1" Padding="0,2" ColumnSpacing="6">
            <!-- 열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
                 전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.
                 EQ·장치 칸은 A163·A164에서 신설(비디오 자막 버튼+플라이아웃 규격).
                 루프 칸은 A11(v0.212.0)에서 c9에 신설 → A217에서 재생 버튼 왼쪽(c0)으로 이동
                 (영상 A216과 동형 — 두 모듈에서 루프는 항상 재생 왼쪽).
                 A217(v0.229.0) 공통 클러스터 정렬: 영상↔오디오 전환 시 공통 UI(재생·위치·시크·
                 길이·음소거·볼륨·배속 = c1~c7)가 하단 바에서 같은 x에 오도록, 클러스터 양옆
                 고정 폭을 영상 바와 등식으로 맞춘다(시크는 star 유지 — 체감 레이아웃 변화 최소).
                   좌군(두 모듈 동일): 루프 32 + 간격 6 = 38.
                   우군 등식: 영상 = 간격 6 + 자막 32 + 간격 6 + Fit 64 = 108
                             오디오(A268 전) = 간격 6 + EQ 32 + 간격 6 + 장치 32 + 간격 6 + 스페이서 c10(26) = 108.
                 폭 재계수(A40 방식): 고정 폭 합 = 1칸 버튼 5개(루프·재생·음소거·EQ·장치) 160 +
                 볼륨 101 + 배속 84 + 스페이서 26 + 간격 6×10 = 431 — 영상(431)과 정확히 같다
                 (정렬의 목적 그대로). A250(v0.246.0)에서 볼륨이 96→101이 되어 두 모듈이 나란히
                 426 → 431이 됐다(스페이서 26·우군 등식은 불변 — 볼륨은 공통 클러스터 안이라
                 양쪽이 같은 +5를 받아 정렬이 그대로 성립한다).
                 ⚠️ A268 잠정: c10 스페이서(26)가 비주얼라이저 버튼(32)으로 바뀌어 오디오 우군
                 108 → 114, 고정 폭 합 431 → 437 — 공통 클러스터가 영상과 6px 어긋난 상태다.
                 재계수(영상 우군 끝 0폭 스페이서 추가·축약 임계 645→651)와 EQ↔장치 스왑은
                 직렬 다음 배치 A269 몫(등재문 확정)이라 여기서는 칸만 확보했다.
                 종전 "비디오보다 32 작아 축약 불요" 판정은 그래서 소멸 —
                 영상의 축약 로직(UpdateCompactTransport, 임계 645·볼륨/시간 숨김)을 동형 이식했다.
                 숨김 대상까지 같아야 좁은 창(축약 후)에서도 클러스터가 어긋나지 않는다. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                 (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                 치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
            <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
            <!-- A11(v0.212.0) 루프: 영상의 동형 이식(A163 EQ 칸과 같은 1칸 32×32).
                 A255(v0.255.0) 개편: 본체 클릭·L 키 = 단일 모드 순환(루프 없음 → 목록 →
                 한 파일 — 상호 배타)이라 Button.Flyout을 떼고 Click을 건다. 횟수(1×/3×/∞)
                 플라이아웃은 코드가 만들어 ContextFlyout(우클릭)으로 걸고 열 때마다 채운다
                 (생성자 배선·BuildLoopFlyout). 본체 아이콘 3상태(끔 = E8EE 흐림 / 목록 = E8EE /
                 한 파일 = E8ED)·툴팁(L 키 표기 포함)은 UpdateLoopButton()이 상태형으로
                 갱신한다 — 아래 FontIcon은 초기값일 뿐이다. 칸 규격·폭은 불변(영상과 동형).
                 A217: 위치를 c9(맨 끝)에서 재생 버튼 왼쪽(c0)으로 이동(영상 A216과 동형) — 총폭 불변. -->
            <Button x:Name="LoopButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnLoopClicked">
                <FontIcon Glyph="&#xE8EE;" FontSize="18" />
            </Button>
            <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}"
                    Content="▶"
                    ToolTipService.ToolTip="Play/Pause (Space)" Click="OnPlayClicked" />
            <TextBlock x:Name="PositionText" Grid.Column="2" Text="0:00"
                       VerticalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="3" Minimum="0" Maximum="1000"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="OnSeekSliderChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="4" Text="0:00"
                       VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Column="5" Style="{StaticResource BottomBarButtonStyle}"
                    Content="🔊" Click="OnMuteClicked" />
            <!-- A250(v0.246.0): 볼륨 슬라이더 폭 96 → 101(영상과 동일 값·동일 근거) — 0~100은
                 값이 101개라 "1px = 1단위"로 잡은 폭이다(사용자 확정). WinUI Slider의 썸 크기·트랙
                 좌우 패딩 때문에 실제 픽셀↔단위 대응은 1:1이 아니다 — 101은 명목치다.
                 파생 재계수: 고정 폭 합 426 → 431(위 헤더 주석), 축약 임계 640 → 645
                 (UpdateCompactTransport — 산식 정본은 영상 쪽 주석). -->
            <Slider x:Name="VolumeSlider" Grid.Column="6" Width="101" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Volume (↑/↓)"
                    ValueChanged="OnVolumeSliderChanged" />
            <!-- 배속 콤보는 압축 표시(비디오와 동일 규격 — A27에서 2칸, A97에서 84×36, A106에서 84×32) -->
            <ComboBox x:Name="SpeedBox" Grid.Column="7" Style="{StaticResource BottomBarWideComboBoxStyle}"
                      SelectionChanged="OnSpeedChanged" />
            <!-- A163: 이퀄라이저 — libvlc 내장 프리셋 라디오 플라이아웃(비디오 자막 버튼 규격).
                 항목은 코드(FillEqualizerFlyout)가 채운다 — 프리셋 열거가 libvlc 네이티브 호출이라
                 플레이어 생성(EnsurePlayerAsync) 뒤에만 가능해서 그때까지 비활성이다. -->
            <Button x:Name="EqButton" Grid.Column="8" Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False" ToolTipService.ToolTip="Equalizer">
                <FontIcon Glyph="&#xE9E9;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="EqFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <!-- A164: 오디오 장치 — 서브메뉴 2개(출력 / Windows 기본 입력)는 코드가 만들고
                 목록은 열 때마다 새로 채운다(장치 꽂힘·뽑힘 추종 — 생성자 주석 참고). -->
            <Button x:Name="DevicesButton" Grid.Column="9" Style="{StaticResource BottomBarButtonStyle}"
                    ToolTipService.ToolTip="Audio devices">
                <FontIcon Glyph="&#xE7F5;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="DevicesFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <!-- A268: 비주얼라이저 스타일 — EQ 버튼 규격(1칸 32×32 + 라디오 플라이아웃 Top).
                 c10은 구 A217 정렬 스페이서(고정 26) 자리로, A269 최종 배치(장치→EQ→비주얼라이저)의
                 끝 칸을 미리 차지했다(스페이서 소멸 — 정렬 6px 어긋남·재계수는 위 헤더 주석의
                 A268 잠정 단락 참고). 항목은 코드(FillVisualizerFlyout)가 열 때마다 채운다
                 (선택 상태 반영 — 장치 플라이아웃의 Opening 재구성 관례). 항상 활성 — 선택은
                 플레이어가 없어도 저장돼 첫 생성 인스턴스 옵션에 반영된다. -->
            <Button x:Name="VisualizerButton" Grid.Column="10" Style="{StaticResource BottomBarButtonStyle}"
                    ToolTipService.ToolTip="Visualizer">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="VisualizerFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
