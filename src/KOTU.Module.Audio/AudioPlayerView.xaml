<UserControl
    x:Class="KOTU.Module.Audio.AudioPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 단축키: Space 재생/일시정지, ←/→ 5초 점프, ↑/↓ 볼륨, M 음소거, Enter/F11 전체화면.
         비디오 플레이어와 동일 배치(A10 분리 — 자막·핏 계열만 없음).
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Space" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePlayInvoked" />
        <KeyboardAccelerator Key="Enter" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardInvoked" />
        <KeyboardAccelerator Key="Up" Invoked="OnVolumeUpInvoked" />
        <KeyboardAccelerator Key="Down" Invoked="OnVolumeDownInvoked" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 파형 표면: libvlc 파형 시각화가 채운다. 클릭 = 재생/일시정지, 휠 = 볼륨 (핸들러는 코드에서 연결) -->
        <Grid x:Name="AudioSurface" Grid.Row="0" Background="Black" Tapped="OnSurfaceTapped">
            <vlc:VideoView x:Name="Vlc" />
            <!-- 상단에 ♪ + 파일명 (파형이 표면을 채우므로 가리지 않게 작게, 입력 통과) -->
            <StackPanel
                x:Name="TitleOverlay"
                Visibility="Collapsed"
                Orientation="Horizontal"
                Spacing="8"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="Gray"
                          VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleText"
                    Foreground="Gray"
                    FontSize="14"
                    MaxWidth="520"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="PlaceholderText"
                Text="Open a music file, or drop one onto the window&#x0A;▶ = built-in sample tune"
                Visibility="Collapsed"
                Foreground="Gray"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 트랜스포트 바 — 셸이 TakeBottomBar()로 떼어가 하단 바(44px) 한 줄에 얹는다(비디오와 동일) -->
        <Grid x:Name="TransportBar" Grid.Row="1" Padding="0,2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    ToolTipService.ToolTip="Open music file" Click="OnOpenClicked">
                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
            </Button>
            <Button x:Name="PlayButton" Grid.Column="1" MinWidth="44" Content="▶"
                    ToolTipService.ToolTip="Play/Pause (Space)" Click="OnPlayClicked" />
            <TextBlock x:Name="PositionText" Grid.Column="2" Text="0:00"
                       VerticalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="3" Minimum="0" Maximum="1000"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="OnSeekSliderChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="4" Text="0:00"
                       VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Column="5" Content="🔊"
                    ToolTipService.ToolTip="Mute (M)" Click="OnMuteClicked" />
            <Slider x:Name="VolumeSlider" Grid.Column="6" Width="96" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Volume (↑/↓)"
                    ValueChanged="OnVolumeSliderChanged" />
            <!-- 배속 콤보는 압축 표시(비디오 v0.49.0과 동일 규격) -->
            <ComboBox x:Name="SpeedBox" Grid.Column="7" MinWidth="60"
                      ToolTipService.ToolTip="Playback speed" SelectionChanged="OnSpeedChanged" />
            <Button Grid.Column="8" Width="40" Height="40" Padding="4"
                    ToolTipService.ToolTip="Full screen (Enter)" Click="OnFullScreenClicked">
                <FontIcon Glyph="&#xE740;" FontSize="18" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
