<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>오디오 플레이어 모듈 (A10, 비디오에서 분리): libvlc 재생 + 파형 시각화, 시킹·볼륨·배속, 이어듣기, 전체화면.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibVLCSharp.WinUI는 WindowsAppSDK 1.8+를 요구한다 (전 프로젝트 1.8로 통일) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
    <!-- A300: EQ·비주얼라이저 코드 조립 아이콘 팩토리(FitIcons의 A298 소스 링크 공유와 같은 방식). -->
    <Compile Include="..\Shared\MediaIcons.cs" Link="MediaIcons.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      내장 샘플 곡(A66): C 메이저 펜타토닉 아르페지오 멜로디, 18초 128kbps 약 282KB.
      numpy 합성 + ffmpeg 인코딩 — 생성: docs/gen_test_audio.py sample 모드 참고.
      Content라 참조하는 App의 출력·publish에 Assets\ 경로 그대로 복사된다 (비디오 test-clip.mp4와 동일 패턴).
    -->
    <Content Include="Assets\sample.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
