<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>동영상 플레이어 모듈: libvlc 재생, 시킹·볼륨·배속, 자막(srt·smi, CP949 자동 변환), 이어보기, 전체화면.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibVLCSharp.WinUI는 WindowsAppSDK 1.8+를 요구한다 (전 프로젝트 1.8로 통일) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.0" />
    <!-- CP949 자막 인코딩 변환용 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinUtil.Core\WinUtil.Core.csproj" />
  </ItemGroup>
</Project>
