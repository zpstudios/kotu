<UserControl
    x:Class="WinUtil.Module.Video.VideoPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    IsTabStop="True"
    DoubleTapped="OnDoubleTapped">

    <!-- 단축키: Space 재생/일시정지, ←/→ 5초 점프, ↑/↓ 볼륨, M 음소거, F11 전체화면 -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePlayInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardInvoked" />
        <KeyboardAccelerator Key="Up" Invoked="OnVolumeUpInvoked" />
        <KeyboardAccelerator Key="Down" Invoked="OnVolumeDownInvoked" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 영상 표면: 클릭 = 재생/일시정지, 휠 = 볼륨 (핸들러는 코드에서 연결) -->
        <Grid x:Name="VideoSurface" Grid.Row="0" Background="Black" Tapped="OnSurfaceTapped">
            <vlc:VideoView x:Name="Vlc" />
            <!-- 음악 파일 재생 시 검은 화면 대신 표시 (탭/휠 입력은 그대로 VideoSurface로 버블링) -->
            <StackPanel
                x:Name="AudioOverlay"
                Visibility="Collapsed"
                Spacing="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="52" Foreground="Gray" />
                <TextBlock
                    x:Name="AudioTitleText"
                    Foreground="Gray"
                    FontSize="16"
                    MaxWidth="520"
                    TextTrimming="CharacterEllipsis"
                    HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="PlaceholderText"
                Text="동영상·음악 파일을 열거나 창으로 끌어다 놓으세요"
                Visibility="Collapsed"
                Foreground="Gray"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 트랜스포트 바 -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="열기..."
                    ToolTipService.ToolTip="동영상·음악 파일 열기" Click="OnOpenClicked" />
            <Button x:Name="PlayButton" Grid.Column="1" MinWidth="44" Content="▶"
                    ToolTipService.ToolTip="재생/일시정지 (Space)" Click="OnPlayClicked" />
            <TextBlock x:Name="PositionText" Grid.Column="2" Text="0:00"
                       VerticalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="3" Minimum="0" Maximum="1000"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="OnSeekSliderChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="4" Text="0:00"
                       VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Column="5" Content="🔊"
                    ToolTipService.ToolTip="음소거 (M)" Click="OnMuteClicked" />
            <Slider x:Name="VolumeSlider" Grid.Column="6" Width="96" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ToolTipService.ToolTip="볼륨 (↑/↓)"
                    ValueChanged="OnVolumeSliderChanged" />
            <ComboBox x:Name="SpeedBox" Grid.Column="7" MinWidth="84"
                      ToolTipService.ToolTip="배속" SelectionChanged="OnSpeedChanged" />
            <ComboBox x:Name="SubtitleBox" Grid.Column="8" MinWidth="120"
                      ToolTipService.ToolTip="자막" SelectionChanged="OnSubtitleChanged" />
            <Button Grid.Column="9" Content="⛶"
                    ToolTipService.ToolTip="전체화면 (F11)" Click="OnFullScreenClicked" />
        </Grid>
    </Grid>
</UserControl>
