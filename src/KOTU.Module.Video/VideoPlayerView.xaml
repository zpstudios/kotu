<UserControl
    x:Class="KOTU.Module.Video.VideoPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 단축키: Space 재생/일시정지, ←/→ 5초 점프, ↑/↓ 볼륨.
         전체화면 계열(Enter·F11·Esc 액셀러레이터)은 A151에서 전부 제거 — 전체화면은 셸의
         3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다. 특히 영상 전용
         Enter=전체화면 가로채기를 없애야 셸의 순환이 영상에서도 동작한다(부록 B 68 ④).
         버튼에 걸린 단독 문자 키(M 음소거 · S 배속 · C 자막 · A 100% · F Fit · L 루프)는
         A34에서 코드(SetupHotkeys)로 옮겼다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들고,
         텍스트 입력·파일 리스트 포커스에서는 통과시켜야 하기 때문.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         더블클릭 전체화면은 제거(v0.23.0 사용자 요청) — 클릭 재생/일시정지와 오동작 겹침.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Space" 등) 툴팁을 화면 중앙에 띄운다.
         A349(2026-09-04): 이전/다음 "파일" 이동 키 4개 추가 — Ctrl+←/→ 와 PageUp/PageDown.
         수식 없는 ←/→ 는 종전대로 5초 시킹이다(부록 B 110 불변) — 액셀러레이터는 수식 조합까지
         정확히 일치해야 발동하므로 두 쌍이 서로를 삼키지 않는다. 이미지 뷰에서 ←/→ 가 뜻하는
         "이웃 파일"이 영상·오디오에서는 Ctrl 조합·PageUp/Down이라는 뜻이다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePlayInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardInvoked" />
        <KeyboardAccelerator Key="Up" Invoked="OnVolumeUpInvoked" />
        <KeyboardAccelerator Key="Down" Invoked="OnVolumeDownInvoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="OnPreviousFileInvoked" />
        <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="OnNextFileInvoked" />
        <KeyboardAccelerator Key="PageUp" Invoked="OnPreviousFileInvoked" />
        <KeyboardAccelerator Key="PageDown" Invoked="OnNextFileInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 영상 표면: 클릭 = 재생/일시정지, 휠 = 볼륨 (핸들러는 코드에서 연결) -->
        <Grid x:Name="VideoSurface" Grid.Row="0" Background="Black" Tapped="OnSurfaceTapped">
            <vlc:VideoView x:Name="Vlc" />
            <!-- 음악 재생 ♪ 오버레이는 오디오 모듈로 이관 (A10) -->
            <!-- A12: 재생 시작 시 파일명+해상도(1080p 등) 좌상단 3초 표시
                 (libvlc 기본 타이틀은 v0.19.0부터 꺼둔 상태 — 자체 오버레이로 대체, 입력 통과) -->
            <Border
                x:Name="StartOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                CornerRadius="4"
                Background="#CC202020"
                Padding="10,6">
                <TextBlock
                    x:Name="StartOverlayText"
                    Foreground="White"
                    FontSize="13"
                    MaxWidth="520"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <!-- A13: 전체화면 조작 피드백 칩 (볼륨·시킹·재생/일시정지) — 하단 바가 숨어
                 상태가 안 보일 때만(전체화면) 코드에서 잠깐 표시, 입력 통과 -->
            <Border
                x:Name="FeedbackOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="6"
                Background="#CC202020"
                Padding="18,10">
                <TextBlock
                    x:Name="FeedbackText"
                    Foreground="White"
                    FontSize="20"
                    TextAlignment="Center" />
            </Border>
            <TextBlock
                x:Name="PlaceholderText"
                Text="Open a video file, or drop one onto the window&#x0A;▶ = built-in display and speaker test clip"
                Visibility="Collapsed"
                Foreground="Gray"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 트랜스포트 바 — 셸이 TakeBottomBar()로 떼어가 하단 바(44px) 한 줄에 얹는다(v0.21.0).
             ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
        <Grid x:Name="TransportBar" Grid.Row="1" Padding="0,2" ColumnSpacing="6">
            <!-- 열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
                 1:1 버튼 칸은 A111에서 제거 — 100%가 Fit 플라이아웃 4옵션에 들어갔다.
                 전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.
                 A217(v0.229.0) 정렬 계약: 공통 클러스터(재생·위치·시크·길이·음소거·볼륨·배속 =
                 A349 재계수 후 c2~c9 · 그 안쪽에 ⏮ c1·⏭ c3이 대칭으로 끼어 있다)의 시작·끝 x가
                 오디오 바와 일치한다 — 좌군(루프) 32+간격 6 = 38,
                 우군은 두 모듈이 같은 값이어야 한다.
                 이 바의 양옆 구성·폭을 바꾸면 오디오 바(AudioPlayerView.xaml)도 함께 재계수할 것.
                 A249(v0.246.0): A230이 달아 둔 "이 등식은 콘텐츠 열림 상태에만 걸린다"는 한정은
                 소멸했다 — 빈 상태에서도 Fit 조절기를 접지 않고 비활성으로만 두므로(항상 표시)
                 우군 폭이 상태와 무관하게 유지된다. 등식은 다시 무조건 성립한다.
                 A269(v0.267.0) 재계수(A217 등식의 첫 개정): 오디오 우군이 비주얼라이저 버튼
                 신설(A268)로 108 → 114가 되어 이 바가 6 모자라졌다. 그래서 우군 끝에
                 0폭 스페이서 칸 c10을 더해 ColumnSpacing 6만 받는다 — 종전 오디오가 쓰던
                 "요소 없는 칸" 관용구를 방향만 바꿔 이쪽에 적용한 것이다.
                   우군 등식(양쪽 114):
                     영상   = 간격 6 + 자막 32 + 간격 6 + Fit 64 + 간격 6 + 0폭 c10 = 114
                     오디오 = 간격 6 + 장치 32 + 간격 6 + EQ 32 + 간격 6 + 비주얼라이저 32 = 114
                 고정 폭 합은 두 모듈 나란히 431 → 437, 축약 임계는 645 → 651
                 (UpdateCompactTransport 주석이 산식 정본 — 오디오도 같은 값).
                 A349(2026-09-04) 재계수: 재생 버튼 양옆에 ⏮ ⏭ 칸 2개(각 32 + 간격 6 = 38 → 합 76)를
                 두 모듈에 똑같이 끼워 넣었다 — 좌군·우군이 아니라 공통 클러스터 안쪽의 대칭 증설이라
                 A217 등식(좌군 38 · 우군 114)은 손대지 않는다. 파생: 고정 폭 합 437 → 513,
                 축약 임계 651 → 727. 열 인덱스는 c1 이후 전부 +2다(구 c1 재생 → 신 c2 …
                 구 c10 스페이서 → 신 c12). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <!-- c12 = A269 정렬 스페이서(A349 재계수 전 c10). 요소를 두지 않으므로 칸 자체는
                     0폭이고, 이 바가 얻는 것은 c11과의 ColumnSpacing 6뿐이다 — 오디오 우군이
                     비주얼라이저 버튼(A268)으로 6 커진 만큼을 여기서 갚는다. 이 칸에 무엇이든 넣으면
                     A217 정렬이 그 폭만큼 깨진다(넣어야 하면 양쪽 우군 등식을 함께 재계수할 것). -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                 (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                 치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
            <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
            <!-- A11(v0.211.0) 루프 칸: A163 EQ 칸과 같은 1칸(32×32). A255(v0.255.0) 개편:
                 본체 클릭·L 키 = 단일 모드 순환(루프 없음 → 목록 → 한 파일 — 상호 배타)이라
                 Button.Flyout을 떼고 Click을 건다. 횟수(1×/3×/∞) 플라이아웃은 코드가 만들어
                 ContextFlyout(우클릭)으로 걸고 열 때마다 채운다(생성자 배선·BuildLoopFlyout).
                 본체 아이콘 3상태(A318: 끔 = E8EE + 금지 사선 겹침 / 목록 = E8EE /
                 한 파일 = E8ED — 셋 다 같은 밝기다. 흐림 표지는 비활성으로 읽힌다는
                 사용자 보고로 폐지)·툴팁(L 키
                 표기 포함)은 UpdateLoopButton()이 상태형으로 갱신한다 — 아래 FontIcon은
                 초기값일 뿐이다. 폭 계수: 이 칸(32+간격 6 = 38)은 A151이 전체화면 칸을
                 제거하며 남긴 여유 38을 정확히 소진한다 — 그래서 당시 축약 임계는 640
                 그대로였다(현재 값은 A250의 볼륨 +5·A269의 스페이서 +6으로 651 — UpdateCompactTransport
                 산식 주석이 정본, 설계 A11-playlist-design.md §4.1). A255도 폭 불변(칸 규격
                 유지 — 플라이아웃 진입만 우클릭으로 이동).
                 A216(2026-08-24): 위치를 c9(맨 끝)에서 재생 버튼 왼쪽(c0)으로 이동 — 총폭 불변. -->
            <Button x:Name="LoopButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnLoopClicked">
                <FontIcon Glyph="&#xE8EE;" FontSize="18" />
            </Button>
            <!-- A349(2026-09-04) 이전/다음 파일 — 재생 버튼 양옆(⏮ ▶ ⏭). 규격은 루프 버튼과 같은
                 1칸(32×32) + FontIcon 18(E892 Previous / E893 Next). 툴팁은 키 2조합을 병기해야 해서
                 SetupHotkeys가 직접 대입한다(HotkeySupport.Bind는 키 1개용이고, 가속기는 이미
                 UserControl.KeyboardAccelerators에 있어 이중 등록이 된다 — 그 자리 주석 참조).
                 ⚠ 이 두 버튼은 "하단 바 버튼은 항상 살아 있다"(A238·A318) 관례의 명시적 예외다
                 (2026-09-04 사용자 확정 ⓐ): 갈 곳이 없으면 IsEnabled=False로 보인다 — 목록 끝이면
                 ⏭만, 목록 처음이면 ⏮만(목록 루프가 켜져 있으면 둘 다 살아 있다).
                 초기값 False = 아직 재생 목록이 없는 상태(빈 상태·테스트 클립)의 정답이고,
                 UpdateNeighborButtons()가 목록·루프 모드가 정해질 때마다 확정한다. -->
            <Button x:Name="PrevButton" Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False" Click="OnPrevClicked">
                <FontIcon Glyph="&#xE892;" FontSize="18" />
            </Button>
            <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource BottomBarButtonStyle}"
                    Content="▶"
                    ToolTipService.ToolTip="Play/Pause (Space)" Click="OnPlayClicked" />
            <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False" Click="OnNextClicked">
                <FontIcon Glyph="&#xE893;" FontSize="18" />
            </Button>
            <TextBlock x:Name="PositionText" Grid.Column="4" Text="0:00"
                       VerticalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="5" Minimum="0" Maximum="1000"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="OnSeekSliderChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="6" Text="0:00"
                       VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Column="7" Style="{StaticResource BottomBarButtonStyle}"
                    Content="🔊" Click="OnMuteClicked" />
            <!-- A250(v0.246.0): 볼륨 슬라이더 폭 96 → 101 — 0~100은 값이 101개라 "1px = 1단위"로
                 잡은 폭이다(사용자 확정). 다만 WinUI Slider는 썸 크기·트랙 좌우 패딩이 있어
                 실제 픽셀↔단위 대응은 1:1이 아니다 — 101은 명목치다.
                 당시 파생 재계수: 고정 폭 합 426 → 431, 축약 임계 640 → 645
                 (UpdateCompactTransport 주석이 정본). 오디오 바도 같은 +5를 함께 받았다.
                 현재 값은 A269 재계수로 437·651 — 위 헤더 주석. -->
            <Slider x:Name="VolumeSlider" Grid.Column="8" Width="101" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Volume (↑/↓)"
                    ValueChanged="OnVolumeSliderChanged" />
            <!-- 배속 콤보는 압축 표시(v0.49.0 사용자 요청 — 공간 절약).
                 A27(v0.107.0)에서 2칸 규격(A97에서 84×36 → A106에서 84×32) — "1.0×"가 1칸에 안 들어간다. -->
            <ComboBox x:Name="SpeedBox" Grid.Column="9" Style="{StaticResource BottomBarWideComboBoxStyle}"
                      SelectionChanged="OnSpeedChanged" />
            <!-- 자막: 콤보 → 아이콘 버튼 + 라디오 플라이아웃 (v0.53.0 사용자 요청 — 공간 절약) -->
            <Button x:Name="SubtitleButton" Grid.Column="10" Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False">
                <FontIcon Glyph="&#xE190;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="SubtitleFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): Fit — 이미지/문서 모듈과 동일 규격.
                 1:1 별도 버튼은 A111에서 제거 — 100%가 Fit 플라이아웃 옵션이 됐다.
                 전체화면 ⛶은 A151에서 셸 모드 버튼으로 이관. -->
            <!-- A30: 상태형 Fit — 마지막으로 고른 옵션이 본체에 표시되고 본체 클릭 =
                 그 옵션 재적용, 화살표 = 옵션 선택. 기억 안 함 — 재생 영상이 바뀌면
                 Contain으로 회귀(사용자 확정). 본체 내용·툴팁은 UpdateFitButton()이 갱신하므로
                 아래 FontIcon은 초기값(Contain)일 뿐이다.
                 A111(v0.133.0): 플라이아웃이 A83 4옵션(100%·Contain·Fit width·Fit height)이 되고
                 본체 표기에 1:1이 추가됐다(구 Auto-fit = 새 Contain, 본체 표기 A는 소멸). -->
            <!-- A144: Fit 조절기 = 정사각형 버튼 2개(32+32 = 64×32, 간격 0) — 구 SplitButton
                 (84×32)은 본체/화살표 분할 폭을 WinUI 기본 템플릿이 정해 비율 통제가 안 됐다.
                 CornerRadius 좌/우 분리 + 화살표의 왼쪽 테두리 0으로 한 몸처럼 보인다(가운데
                 경계선 = 본체의 오른쪽 테두리 1px 하나). DropDownButton은 키 있는 기본 스타일이
                 없어 BasedOn 불가(v0.113.1 실기기 이력)라 구 SplitButton처럼 인라인 값으로 적는다.
                 화살표는 내용 없이 내장 셰브론만 표시하고 A34 키가 없어 툴팁을 XAML에 적는다. -->
            <!-- 본체 툴팁(키 표기 포함)은 UpdateFitButton()이 상태와 함께 갱신한다 — A34 -->
            <!-- A230(v0.234.0) → A249(v0.246.0, 정면 반전): 빈 상태(재생 파일 없음 = 중앙이 셸
                 썸네일 탐색기)에서 조절기 2개를 접던 것을 되돌려 **항상 표시 + 비활성**으로 간다
                 (A145 "항상 보이되 비활성" 원칙의 전 모듈 복원 — 2026-08-27 사용자 지시).
                 초기 IsEnabled=False가 그 기본 상태고, 생성자의 UpdateFitEnabled()가 파일 인자
                 유무로 곧바로 확정한다(첫 프레임 정합. 3모듈 일관). A·F 키 차단은 가시성이 아니라
                 IsEnabled가 진다 — HotkeySupport의 통과 게이트가 IsEnabled와 Visibility를 함께
                 보기 때문이다(Shared/HotkeySupport.cs:61). 빈 상태 ▶ = 테스트 클립(A207) 등
                 다른 버튼은 빈 상태에도 그대로 쓰이므로 종전대로 손대지 않는다. -->
            <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FitButton" Style="{StaticResource BottomBarButtonStyle}"
                        CornerRadius="4,0,0,4" IsEnabled="False" Click="OnFitClicked">
                    <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                </Button>
                <DropDownButton x:Name="FitOptionsButton"
                                Width="32" Height="32" Padding="4"
                                BorderThickness="0,1,1,1" CornerRadius="0,4,4,0"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Fit options">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <!-- 계보 = "1:1" 글자 도형(A143) → 네 모서리 꺾쇠 + 중앙 사각(A184) →
                                 텍스트 "100%"·아이콘 없음(A231) → FontIcon(Segoe UI, 두 글자 "OR")
                                 (A253) → A260(5차·확정, 2026-08-27 사용자 지시) → A310(본체와 통일).
                                 A253의 다문자 Glyph는 저장소 선례 0건의 1순위 위험 후보였고 그대로
                                 현실화됐다 — 실기기에서 아이콘 칸이 비어 나온다는 사용자 보고.
                                 그래서 FontIcon 다문자 형태는 폐기하고 PathIcon 도형으로 갔다.
                                 A310: 그 PathIcon의 Data 인라인 문자열(정사각 링 + 세로 막대 2 + 점 2)을
                                 지우고 아이콘 자체를 코드에서 대입한다 — 도형이 본체 버튼의 상자와
                                 달라 "위아래 1:1이 미세하게 다르다"는 사용자 보고가 났기 때문이다.
                                 이제 두 그림 모두 Shared/FitIcons 한 파일이 그린다
                                 (본체 = BuildOriginalRatioBox · 여기 = BuildOriginalRatioIcon).
                                 x:Name은 그 대입을 위해 붙였다(대입 지점 = 생성자 한 줄.
                                 문서 모듈의 FitHeightItem과 같은 형태다).
                                 ⚠ 아이콘은 항목마다 새 인스턴스여야 한다 — Geometry·요소를 공유
                                 리소스로 두고 여러 부모에 걸면 런타임에 앱이 죽는다(v0.174.1 실사례.
                                 App.xaml의 경고 주석 참고). 팩토리가 호출마다 새로 만들어 돌려주므로
                                 그 규칙은 지켜진다.
                                 최소 복구법 = 생성자의 Icon 대입 한 줄을 지우기(A231의 "아이콘 없음"
                                 으로 되돌아간다. 다른 변경 무관). -->
                            <MenuFlyoutItem x:Name="FitOriginalItem" Text="Original" Click="OnFitActualSizeClicked" />
                            <MenuFlyoutItem Text="Contain" Click="OnFitContainClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE9A6;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <!-- A216: 루프 버튼은 재생 버튼 왼쪽(c0)으로 이동 — 선언도 바 맨 앞으로 옮겼다. -->
        </Grid>
    </Grid>
</UserControl>
