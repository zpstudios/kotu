<UserControl
    x:Class="KOTU.Module.Video.VideoPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 단축키: Space 재생/일시정지, ←/→ 5초 점프, ↑/↓ 볼륨, Enter/F11 전체화면.
         버튼에 걸린 단독 문자 키(M 음소거 · S 배속 · C 자막 · A 1:1 · F Fit)는
         A34에서 코드(SetupHotkeys)로 옮겼다 — 툴팁 "(키)" 표기를 키와 한 값에서 만들고,
         텍스트 입력·파일 리스트 포커스에서는 통과시켜야 하기 때문.
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         더블클릭 전체화면은 제거(v0.23.0 사용자 요청) — 클릭 재생/일시정지와 오동작 겹침.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Space" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnTogglePlayInvoked" />
        <KeyboardAccelerator Key="Enter" Invoked="OnFullScreenEnterInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekForwardInvoked" />
        <KeyboardAccelerator Key="Up" Invoked="OnVolumeUpInvoked" />
        <KeyboardAccelerator Key="Down" Invoked="OnVolumeDownInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 영상 표면: 클릭 = 재생/일시정지, 휠 = 볼륨 (핸들러는 코드에서 연결) -->
        <Grid x:Name="VideoSurface" Grid.Row="0" Background="Black" Tapped="OnSurfaceTapped">
            <vlc:VideoView x:Name="Vlc" />
            <!-- 음악 재생 ♪ 오버레이는 오디오 모듈로 이관 (A10) -->
            <!-- A12: 재생 시작 시 파일명+해상도(1080p 등) 좌상단 3초 표시
                 (libvlc 기본 타이틀은 v0.19.0부터 꺼둔 상태 — 자체 오버레이로 대체, 입력 통과) -->
            <Border
                x:Name="StartOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                CornerRadius="4"
                Background="#CC202020"
                Padding="10,6">
                <TextBlock
                    x:Name="StartOverlayText"
                    Foreground="White"
                    FontSize="13"
                    MaxWidth="520"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <!-- A13: 전체화면 조작 피드백 칩 (볼륨·시킹·재생/일시정지) — 하단 바가 숨어
                 상태가 안 보일 때만(전체화면) 코드에서 잠깐 표시, 입력 통과 -->
            <Border
                x:Name="FeedbackOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="6"
                Background="#CC202020"
                Padding="18,10">
                <TextBlock
                    x:Name="FeedbackText"
                    Foreground="White"
                    FontSize="20"
                    TextAlignment="Center" />
            </Border>
            <TextBlock
                x:Name="PlaceholderText"
                Text="Open a video file, or drop one onto the window&#x0A;▶ = built-in display and speaker test clip"
                Visibility="Collapsed"
                Foreground="Gray"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 트랜스포트 바 — 셸이 TakeBottomBar()로 떼어가 하단 바(44px) 한 줄에 얹는다(v0.21.0).
             ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
        <Grid x:Name="TransportBar" Grid.Row="1" Padding="0,2" ColumnSpacing="6">
            <!-- 열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A27(v0.107.0): 하단 바 버튼은 1칸(36×36)·2칸(84×36) 두 규격만 (A97/v0.116.0에서 40→36) —
                 치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
            <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
            <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                    Content="▶"
                    ToolTipService.ToolTip="Play/Pause (Space)" Click="OnPlayClicked" />
            <TextBlock x:Name="PositionText" Grid.Column="1" Text="0:00"
                       VerticalAlignment="Center" />
            <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1000"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="OnSeekSliderChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="3" Text="0:00"
                       VerticalAlignment="Center" />
            <Button x:Name="MuteButton" Grid.Column="4" Style="{StaticResource BottomBarButtonStyle}"
                    Content="🔊" Click="OnMuteClicked" />
            <Slider x:Name="VolumeSlider" Grid.Column="5" Width="96" Minimum="0" Maximum="100"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Volume (↑/↓)"
                    ValueChanged="OnVolumeSliderChanged" />
            <!-- 배속 콤보는 압축 표시(v0.49.0 사용자 요청 — 공간 절약).
                 A27(v0.107.0)에서 2칸 규격(A97에서 84×36) — "1.0×"가 1칸에 안 들어간다. -->
            <ComboBox x:Name="SpeedBox" Grid.Column="6" Style="{StaticResource BottomBarWideComboBoxStyle}"
                      SelectionChanged="OnSpeedChanged" />
            <!-- 자막: 콤보 → 아이콘 버튼 + 라디오 플라이아웃 (v0.53.0 사용자 요청 — 공간 절약) -->
            <Button x:Name="SubtitleButton" Grid.Column="7" Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False">
                <FontIcon Glyph="&#xE190;" FontSize="18" />
                <Button.Flyout>
                    <MenuFlyout x:Name="SubtitleFlyout" Placement="Top" />
                </Button.Flyout>
            </Button>
            <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): 1:1·전체화면 = 1칸, Auto-fit = 2칸 +
                 핏 옵션 전부 아이콘. 이미지/문서 모듈과 동일 규격(A27에서 확정 → A97에서 84×36). -->
            <Button x:Name="ActualSizeButton" Grid.Column="8" Style="{StaticResource BottomBarButtonStyle}"
                    Content="1:1" FontSize="13" Click="OnActualSizeClicked" />
            <!-- A30: 상태형 Fit 버튼 — 마지막으로 고른 옵션(A/좌우/상하)이 본체에 표시되고
                 본체 클릭 = 그 옵션 재적용, 화살표 = 3옵션 선택. 기억 안 함 — 재생 영상이
                 바뀌면 A(자동)로 회귀(사용자 확정). 본체 내용·툴팁은 UpdateFitButton()이 갱신. -->
            <!-- SplitButton은 WinUI가 키 있는 기본 스타일을 노출하지 않아(BasedOn 대상 없음)
                 전역 스타일 대신 2칸 값(84×36)을 그대로 적는다 — A27(v0.107.0),
                 높이는 A97(v0.116.0)에서 40→36. 폭 84는 유지. -->
            <!-- 툴팁(키 표기 포함)은 UpdateFitButton()이 상태와 함께 갱신한다 — A34 -->
            <SplitButton x:Name="FitButton" Grid.Column="9" Width="84" Height="36"
                         VerticalAlignment="Center" CornerRadius="4" Click="OnFitClicked">
                <TextBlock Text="A" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <SplitButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Text="Auto-fit" Click="OnFitAutoClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClicked">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button Grid.Column="10" Style="{StaticResource BottomBarButtonStyle}"
                    ToolTipService.ToolTip="Full screen (Enter / F11)" Click="OnFullScreenClicked">
                <FontIcon Glyph="&#xE740;" FontSize="18" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
