<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>동영상 플레이어 모듈: libvlc 재생, 시킹·볼륨·배속, 자막(srt·smi, CP949 자동 변환), 이어보기, 전체화면.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibVLCSharp.WinUI는 WindowsAppSDK 1.8+를 요구한다 (전 프로젝트 1.8로 통일) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.0" />
    <!-- CP949 자막 인코딩 변환용 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
    <!-- A298: Fit 원본 배율 "1:1" 상자 조립 팩토리(A260 디자인 한 벌). 같은 이유로 소스 링크 공유. -->
    <Compile Include="..\Shared\FitIcons.cs" Link="FitIcons.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      내장 테스트 클립(화면 색감 + 스피커 테스트 음악, 32초 1.3MB).
      ffmpeg(lavfi)+numpy로 생성 — 생성 스크립트: docs/gen_test_audio.py 참고.
      Content라 참조하는 App의 출력·publish에 Assets\ 경로 그대로 복사된다.
    -->
    <Content Include="Assets\test-clip.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
