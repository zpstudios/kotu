<UserControl
    x:Class="KOTU.App.ExplorerPathBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A417: same path/home/up/filter appearance, independent of the legacy list. -->
    <Grid ColumnSpacing="8" Padding="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="OnUpClicked" ToolTipService.ToolTip="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <!-- A282: 사용자 프로필 폴더로 한 번에 복귀. 비활성화하지 않는다(이미 홈이면 무동작) -->
            <Button x:Name="HomeButton" Grid.Column="1" Click="OnHomeClicked"
                    ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
            <!-- 항목은 담당 확장자에 따라 코드에서 채운다(EnsureFilterFlyout) -->
            <DropDownButton x:Name="FilterButton" Grid.Column="3" Padding="8,5"
                            ToolTipService.ToolTip="Filter file types">
                <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="13" />
            </DropDownButton>
        </Grid>
</UserControl>
