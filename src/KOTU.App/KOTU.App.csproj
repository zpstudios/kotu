<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <!-- unpackaged 배포 (설계 문서 2장 참고: HW 센서 드라이버 제약 때문) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 단일 인스턴스 처리를 위해 Program.Main 직접 정의 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 아이콘(작업표시줄·탐색기 표시). 모양은 추후 확정 — 일단 W 플레이스홀더 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!--
      exe·어셈블리 이름 (A64, v0.88.0). 프로젝트는 KOTU.App이지만 산출물은 "KOTU.exe"다 —
      UAC 대화상자·작업 관리자에 "KOTU.exe"로 보여야 하기 때문(구 WinUtil.App.exe 노출이 A64의 계기).
      ※ TargetName이 바뀌므로 아래 CopyPriToPublish의 $(TargetName).pri 폴백과
        release.yml의 mainExe 인자도 함께 KOTU.exe 기준이어야 한다.
        (XML 주석 안에는 하이픈 두 개를 연달아 쓸 수 없어 인자명을 그대로 적지 못한다.)
    -->
    <AssemblyName>KOTU</AssemblyName>
    <RootNamespace>KOTU.App</RootNamespace>
    <!-- 표시 이름 "KOTU": 탐색기 '연결 프로그램' 목록·작업 관리자 등에 노출 -->
    <Product>KOTU</Product>
    <AssemblyTitle>KOTU</AssemblyTitle>
    <!--
      이름과 달리 MSIX 패키징이 아니라 단일 프로젝트 도구(특히 resources.pri 생성·병합)를 켜는 속성.
      WinUI 템플릿 기본값인데 누락돼 있었고, 그 결과 publish에 resources.pri가 없어
      실행 시 XamlParseException으로 즉사했다(v0.5.5~0.5.6 실기기 진단).
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      unpackaged 앱의 리소스 로더는 exe 옆의 "resources.pri" 고정 이름만 찾는다.
      기본 생성 이름이 KOTU.App.pri라 시작 시 XamlParseException으로 죽었음(v0.5.7 CI 로그로 확정).
      생성 단계에서부터 이름을 맞춘다.
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 1.8: LibVLCSharp.WinUI(동영상 모듈)의 최소 요구 버전에 맞춰 전 프로젝트 통일 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- libvlc 네이티브 엔진(LGPL, dll 동적 링크) — 빌드 출력에 자동 복사됨 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.*" />
    <!-- 설치본(Setup.exe)·자동 업데이트 (설계 2장: unpackaged + Velopack) -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- 센서 트레이 아이콘 동적 렌더링(A18) — Windows 전용 TFM이라 경고 없음 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
    <!-- A233: 썸네일 텍스트 프리뷰의 CP949 폴백. 문서·압축·동영상 모듈과 같은 버전 —
         모듈 경유 전이 참조에 기대지 않고 소비 프로젝트가 직접 선언한다(저장소 관례) -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 런타임 로드용 .ico 원본: 타이틀바(AppWindow.SetIcon)·트레이 아이콘(TrayIcon)이 exe 옆에서 읽는다.
         app-*.ico = 모듈별 색 변형(v0.26.0, packaging/gen_app_icon.py로 생성) -->
    <Content Include="Assets\app.ico;Assets\app-archive.ico;Assets\app-image.ico;Assets\app-video.ico;Assets\app-audio.ico;Assets\app-hardware.ico;Assets\app-document.ico;Assets\app-allreadable.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- 시작 메뉴 스폰서 자리 로고 (packaging/gen_sponsor_placeholder.py로 생성, 실제 로고로 교체 가능) -->
    <!-- 광고 이미지 로테이션(v0.38.0): sponsor-*.png 전부 동봉, 파일 추가/교체만으로 갱신 -->
    <Content Include="Assets\sponsor-*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 광고 이미지 ↔ 링크 매핑(A67, v0.109.0). 없거나 깨져도 링크 없는 광고로 조용히 넘어간다 -->
    <Content Include="Assets\sponsors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 확장자별 파일 아이콘 (A23, v0.60.0 — packaging/gen_file_icons.py로 생성) -->
    <Content Include="Assets\fileicons\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 브랜드 에셋 조각 (A79, v0.119.0 — packaging/gen_brand_assets.py가 브랜드 시트에서 잘라낸다).
         BrandAssets가 exe 옆 Assets\Brand\에서 파일 이름으로 찾는다. 없어도 앱은 그대로 동작한다
         (레벨 0의 모습으로 조용히 떨어진다). 원본 시트는 동봉하지 않는다 — 조각만. -->
    <Content Include="Assets\Brand\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!--
      A34(v0.112.0): 버튼 핫키 공용 지원. KOTU.Core는 UI 비의존(net8.0)이라 WinUI 타입을 쓸 수 없어
      소스 링크로 공유한다(어셈블리마다 internal 사본). 모듈 프로젝트 전부가 같은 항목을 갖는다.
    -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
    <ProjectReference Include="..\KOTU.Module.Image\KOTU.Module.Image.csproj" />
    <ProjectReference Include="..\KOTU.Module.Archive\KOTU.Module.Archive.csproj" />
    <ProjectReference Include="..\KOTU.Module.Video\KOTU.Module.Video.csproj" />
    <ProjectReference Include="..\KOTU.Module.Audio\KOTU.Module.Audio.csproj" />
    <ProjectReference Include="..\KOTU.Module.Hardware\KOTU.Module.Hardware.csproj" />
    <ProjectReference Include="..\KOTU.Module.Document\KOTU.Module.Document.csproj" />
    <!-- A59(v0.113.0): 통합 모듈. 자식 모듈 뷰는 셸이 넘긴 IModule 계약으로 만든다(직접 참조 없음). -->
    <ProjectReference Include="..\KOTU.Module.AllReadable\KOTU.Module.AllReadable.csproj" />
  </ItemGroup>

  <!--
    dotnet publish가 unpackaged WinUI 앱의 resources.pri(컴파일된 XAML/XBF 병합 리소스)를
    publish 폴더로 복사하지 않는 문제 대응. 없으면 실행 시 MainWindow.InitializeComponent에서
    XamlParseException("XAML parsing failed")으로 조용히 죽는다. (v0.5.5 배포에서 실증)
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <!-- 1) OutDir에 resources.pri가 있으면 publish로 복사 -->
    <Copy SourceFiles="$(OutDir)resources.pri" DestinationFolder="$(PublishDir)"
          Condition="Exists('$(OutDir)resources.pri')" />
    <!-- 2) ProjectPriFileName이 무시되어 기본 이름으로 생성된 경우: publish 안에서 이름을 맞춰 복사 -->
    <Copy SourceFiles="$(PublishDir)$(TargetName).pri" DestinationFiles="$(PublishDir)resources.pri"
          Condition="!Exists('$(PublishDir)resources.pri') And Exists('$(PublishDir)$(TargetName).pri')" />
  </Target>
</Project>
