<UserControl
    x:Class="KOTU.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (v0.50.0 — 전 화면 공통 배치) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- 항목은 코드에서 채운다 (모듈 목록이 런타임에 정해지므로) -->
            <StackPanel
                x:Name="Root"
                Spacing="12"
                Padding="24"
                MaxWidth="680"
                HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- 하단 바: 좌측 Patreon 후원 문구(v0.52.0 — 광고 배너는 사용자 정정으로 철회) + 우측 ⛶.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다. -->
        <Border x:Name="ControlBar" Grid.Row="1" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton Grid.Column="0" Content="Kindly support us on Patreon !"
                                 NavigateUri="https://www.patreon.com/zpstudios/"
                                 VerticalAlignment="Center" Padding="4,2"
                                 ToolTipService.ToolTip="www.patreon.com/zpstudios/" />
                <!-- 폭 40 정사각 = 다른 모듈 ⛶와 통일 (v0.53.0 기준) -->
                <Button Grid.Column="2" Width="40" Height="40" Padding="4"
                        Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
