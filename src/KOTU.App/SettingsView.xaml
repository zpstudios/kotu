<UserControl
    x:Class="KOTU.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- 전체화면 계열(F11·Esc 액셀러레이터, v0.50.0)은 A151에서 제거 — 전체화면은 셸의
         3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다. -->

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- 항목은 코드에서 채운다 (모듈 목록이 런타임에 정해지므로) -->
            <StackPanel
                x:Name="Root"
                Spacing="12"
                Padding="24"
                MaxWidth="680"
                HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- 하단 바: 좌측 Patreon 후원 문구(v0.52.0 — 광고 배너는 사용자 정정으로 철회).
             우측 ⛶(전체화면)은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다. -->
        <Border x:Name="ControlBar" Grid.Row="1" Padding="0,2,0,2">
            <!-- ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton Grid.Column="0" Content="Kindly support us on Patreon !"
                                 NavigateUri="https://www.patreon.com/zpstudios/"
                                 VerticalAlignment="Center" Padding="4,2"
                                 ToolTipService.ToolTip="www.patreon.com/zpstudios/" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
