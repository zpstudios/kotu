<UserControl
    x:Class="KOTU.App.Controls.ThumbnailExplorer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 중앙 썸네일 탐색기 뷰 (A93): S1(콘텐츠 없음·모듈만 실행)의 중앙 구획.
         목록 데이터는 스스로 만들지 않는다 — 좌 도크 리스트(ExplorerPane)가 정렬(A5)·필터(A7)까지
         적용해 다시 그릴 때마다 같은 항목(ViewChanged)을 받아 균일 타일로 그린다(폴더 상태 공유).
         타일 = 이미지 확장자는 실제 축소 미리보기 / 폴더는 글리프 / 그 외 파일은 담당 모듈
         액센트 색 + 확장자 타일. 항목은 전부 코드(ShowEntries)에서 채운다.
         열 수는 셸이 SetColumns로 준다(A213: 8 − 2×열린 도크 수 = 4/6/8 — A63 대체 계보).
         타일 크기 = floor(실폭/열수), SizeChanged마다 재계산(ApplyTileSize).
         드래그 앤 드랍(A94 1차, v0.124.0 — A93의 무동작 소비를 실동작으로 전환):
         빈 영역·파일 타일 드랍 = 현재 폴더로 이동/복사, 폴더 타일 드랍 = 그 폴더로(코드가
         타일 컨테이너에 건다). 루트 Grid가 AllowDrop을 받는 구조는 MainWindow.RootLayout과
         같다(GridView 자체는 AllowDrop 기본 false). SelectionMode=Extended = 다중선택(A94).
         NoticeText = 조작 실패 일시 안내(A92류 — 타이머+Visibility, Storyboard 없음: A90 선례). -->
    <!-- A176: S4('오픈 파일' 탐색) 인스턴스의 반투명 배경 교체(구 UseTranslucentBackground)는
         반투명 축과 함께 철거됐고, A316부터는 방향이 반대다: 이 컨트롤 자체는 배경을 갖지 않고
         (Transparent — DocumentView RootGrid와 같은 형태) 바탕은 호스트가 댄다.
         S1 = ExplorerHost(불투명 SolidBackgroundFillColorBase, MainWindow.xaml) /
         S4 = S4CenterBackdrop(같은 브러시 + 코드 상수 S4TranslucentOpacity 반투명 — 뒤에 열린
         미디어가 비치는 게 사양이다). 인스턴스별 분기 없이 XAML 한 벌이 양쪽에 성립한다.
         Transparent는 null 배경과 달리 히트 테스트에 잡힌다 — 빈 영역 우클릭 메뉴·눌림 구독·드랍
         ("배경 있는 LayoutRoot가 원본" — 코드 A212 주석의 히트 보장)이 종전대로 유지되고,
         S4에서 아래 레이어(미디어)로 포인터가 새지 않는 모달 차단(A313)도 그대로다. -->
    <Grid x:Name="LayoutRoot" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          Background="Transparent">
        <!-- A152: 아래 패딩 44 = 셸 하단 바 두께. 콘텐츠 영역이 창 전체가 되면서(행 분할 폐지)
             모드1에서는 이 그리드의 하단 44px가 바에 덮인다 — 마지막 타일 줄이 바 뒤에 숨지
             않게 스크롤 끝 여백으로 보정한다(모드 불변 상수 — ExplorerPane과 같은 규칙).
             좌우 패딩은 0 그대로 — 타일 폭 계산 floor(실폭/열수)(ApplyTileSize)에 영향 없다. -->
        <GridView x:Name="TileGrid"
                  Padding="0,0,0,44"
                  SelectionMode="Extended"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  SizeChanged="OnSizeChanged" />
        <TextBlock x:Name="EmptyText" Text="No matching files here"
                   Visibility="Collapsed" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- A152: 하단 여백 54 = 종전 10 + 하단 바 44 — 바닥 정렬 일시 안내가 모드1에서
             오버레이 바에 가려지지 않게 띄운다(위 TileGrid 패딩과 같은 보정) -->
        <TextBlock x:Name="NoticeText"
                   Visibility="Collapsed" FontSize="12" Opacity="0.8"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="12,0,12,54" />
    </Grid>
</UserControl>
