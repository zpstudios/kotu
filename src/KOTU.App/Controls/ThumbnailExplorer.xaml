<UserControl
    x:Class="KOTU.App.Controls.ThumbnailExplorer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.App"
    xmlns:controls="using:KOTU.App.Controls">

    <!-- 중앙 썸네일 탐색기 뷰 (A93): S1(콘텐츠 없음·모듈만 실행)의 중앙 구획.
         목록 데이터는 스스로 만들지 않는다 — 좌 도크 리스트(ExplorerPane)가 정렬(A5)·필터(A7)까지
         적용해 다시 그릴 때마다 같은 항목(ViewChanged)을 받아 균일 타일로 그린다(폴더 상태 공유).
         타일 = 이미지 확장자는 실제 축소 미리보기 / 폴더는 글리프 / 그 외 파일은 담당 모듈
         액센트 색 + 확장자 타일.
         A345 배치 3: 타일은 ItemsSource(뷰모델 목록) + 아래 DataTemplate + ContainerContentChanging
         가상화라 화면에 보이는 타일만 실체화된다 — ShowEntries는 목록을 대입할 뿐 컨테이너를
         만들지 않는다(종전 "항목은 전부 코드(ShowEntries)에서 채운다"의 폐기). 미리보기 4갈래는
         코드가 위상 0(폴백 즉시)·위상 1(비동기 요청)로 TilePreviewHost 안에 채운다.
         열 수는 셸이 SetColumns로 준다(A417: 12 − 3×보이는 패널 수 = 6/9/12).
         타일 크기 = floor(실폭/열수), SizeChanged마다 재계산(ApplyTileSize).
         드래그 앤 드랍(A94 1차, v0.124.0 — A93의 무동작 소비를 실동작으로 전환):
         빈 영역·파일 타일 드랍 = 현재 폴더로 이동/복사, 폴더 타일 드랍 = 그 폴더로(코드가
         타일 컨테이너에 건다). 루트 Grid가 AllowDrop을 받는 구조는 MainWindow.RootLayout과
         같다(GridView 자체는 AllowDrop 기본 false). SelectionMode=Extended = 다중선택(A94).
         NoticeText = 조작 실패 일시 안내(A92류 — 타이머+Visibility, Storyboard 없음: A90 선례). -->
    <!-- A176: S4('오픈 파일' 탐색) 인스턴스의 반투명 배경 교체(구 UseTranslucentBackground)는
         반투명 축과 함께 철거됐고, A316부터는 방향이 반대다: 이 컨트롤 자체는 배경을 갖지 않고
         (Transparent — DocumentView RootGrid와 같은 형태) 바탕은 호스트가 댄다.
         S1 = ExplorerHost(불투명 SolidBackgroundFillColorBase, MainWindow.xaml) /
         S4 = S4CenterBackdrop(문서는 불투명, 미디어는 S4TranslucentOpacity 반투명 — 뒤에 열린
         미디어가 비치는 게 사양이다). 인스턴스별 분기 없이 XAML 한 벌이 양쪽에 성립한다.
         Transparent는 null 배경과 달리 히트 테스트에 잡힌다 — 빈 영역 우클릭 메뉴·눌림 구독·드랍
         ("배경 있는 LayoutRoot가 원본" — 코드 A212 주석의 히트 보장)이 종전대로 유지되고,
         S4에서 아래 레이어(미디어)로 포인터가 새지 않는 모달 차단(A313)도 그대로다. -->
    <UserControl.Resources>
                <DataTemplate x:Key="ParentTileTemplate" x:DataType="controls:ExplorerParentTile">
                    <Button Loaded="OnParentTileLoaded" IsDoubleTapEnabled="True"
                            IsEnabled="{x:Bind CanNavigate, Mode=OneWay}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent"
                            AutomationProperties.Name="Up one folder" ToolTipService.ToolTip="Up one folder">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 기존 폴더 윤곽과 같은 글리프를 쓰고 작은 위쪽 화살표는 바깥 모서리에 둔다. -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Width="28" Height="28"
                                              HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <FontIcon Glyph="&#xE74A;" FontSize="12" Width="12" Height="12"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="Up one folder" FontSize="14"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,4,4" />
                        </Grid>
                    </Button>
                </DataTemplate>
                <DataTemplate x:Key="ParentListTemplate" x:DataType="controls:ExplorerParentTile">
                    <Button Loaded="OnParentTileLoaded" IsDoubleTapEnabled="True"
                            IsEnabled="{x:Bind CanNavigate, Mode=OneWay}" MinHeight="{x:Bind ListRowHeight, Mode=OneWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            MinWidth="0" Padding="0" BorderThickness="0" Background="Transparent"
                            AutomationProperties.Name="Up one folder" ToolTipService.ToolTip="Up one folder">
                        <Grid x:Name="ParentListRow" Padding="8,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Width="20" Height="20" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Viewbox Grid.Column="1" Grid.RowSpan="2" Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                <Grid Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Width="28" Height="28"
                                              HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <FontIcon Glyph="&#xE74A;" FontSize="12" Width="12" Height="12"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="ParentListCaption" Grid.Column="2" Text="Up one folder" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
                            <TextBlock Grid.Column="2" Grid.Row="1" Text=" " FontSize="11" Opacity="0"
                                       IsHitTestVisible="False" Visibility="{x:Bind ListSummaryVisibility, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 보기는 왼쪽 첫 행에 고정하고 폭이 모자라면 정렬 묶음만 다음 행 오른쪽으로 보낸다. -->
        <Grid x:Name="ExplorerTools" Background="Transparent" Padding="10,8" SizeChanged="OnToolsSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="ViewGroup" Orientation="Horizontal" Spacing="8"
                        Margin="0" HorizontalAlignment="Left" AutomationProperties.Name="View">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton x:Name="PreviewViewButton" Width="32" Height="32" MinWidth="0" Padding="4" VerticalAlignment="Center"
                                  CornerRadius="4,0,0,4" AutomationProperties.Name="Preview"
                                  ToolTipService.ToolTip="Preview">
                        <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewButton" Width="32" Height="32" MinWidth="0" Padding="4" VerticalAlignment="Center"
                                  CornerRadius="0,4,4,0" AutomationProperties.Name="List"
                                  ToolTipService.ToolTip="List">
                        <FontIcon Glyph="&#xEA37;" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
                <DropDownButton x:Name="ColumnsButton" Content="Columns" Height="32" MinWidth="0" Padding="8,4" VerticalAlignment="Center"
                                Visibility="Collapsed" AutomationProperties.Name="Columns" ToolTipService.ToolTip="Choose columns" />
            </StackPanel>
            <Grid x:Name="SortGroup" Grid.Column="1" ColumnSpacing="8" MaxWidth="260" Margin="16,0,0,0"
                  HorizontalAlignment="Right" AutomationProperties.Name="Sort">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sort" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                <DropDownButton x:Name="SortKeyButton" Grid.Column="1" Height="32" Padding="8,4" MinWidth="0" VerticalAlignment="Center"
                                HorizontalAlignment="Right" AutomationProperties.Name="Sort by"
                                ToolTipService.ToolTip="Sort by">
                    <TextBlock x:Name="SortKeyText" Text="Name" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DropDownButton>
                <Button x:Name="SortDirectionButton" Grid.Column="2" Width="32" Height="32" Padding="4" MinWidth="0" VerticalAlignment="Center"
                        Click="OnSortDirectionClick" AutomationProperties.Name="Sort direction">
                    <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE70E;" FontSize="13" />
                </Button>
            </Grid>
        </Grid>
        <!-- A152: 아래 패딩 44 = 셸 하단 바 두께. 콘텐츠 영역이 창 전체가 되면서(행 분할 폐지)
             모드1에서는 이 그리드의 하단 44px가 바에 덮인다 — 마지막 타일 줄이 바 뒤에 숨지
             않게 스크롤 끝 여백으로 보정한다(모드 불변 상수 — ExplorerPane과 같은 규칙).
             좌우 패딩은 0 그대로 — 타일 폭 계산 floor(실폭/열수)(ApplyTileSize)에 영향 없다. -->
        <GridView x:Name="TileGrid" Grid.Row="1" IsTabStop="True" Background="Transparent"
                  Padding="0,0,0,44"
                  SelectionMode="Extended"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  ContainerContentChanging="OnTileContainerContentChanging"
                  SizeChanged="OnSizeChanged">
            <!-- A93 타일(위 미리보기 + 아래 캡션 1줄)을 그대로 옮긴 템플릿 (A345 배치 3).
                 루트는 반드시 **평평한 Grid 하나**다(중첩 패널 금지) — 인라인 이름변경
                 (ExplorerRenameBox.Begin)이 이 Grid에 편집 상자를 Insert하고 캡션 자리에
                 앉히기 때문이다. x:Name 둘은 코드의 조회 키 상수(TilePreviewHostName·
                 TileCaptionName)와 반드시 같은 값이어야 한다(조회가 이름 기반 — 종전
                 tile.Children[1] 인덱스 계약은 배치 3에서 폐기했다).
                 TilePreviewHost = 미리보기 4갈래가 들어가는 빈 자리(코드가 채우고 비운다.
                 컨테이너가 재활용 큐로 갈 때 비워야 비트맵이 해제된다). -->
            <GridView.Resources>
                <DataTemplate x:Key="FileTileTemplate" x:DataType="local:ExplorerEntryVm">
                    <Grid Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                          Loaded="OnFileTileRootLoaded"
                          ToolTipService.ToolTip="{x:Bind Name}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TilePreviewHost" />
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                  Click="OnTileCheckClick"
                                  MinWidth="0" MinHeight="0" Padding="0" Margin="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  ToolTipService.ToolTip="Check to target file operations (copy, cut, delete, drag, open). No checks = selection." />
                        <!-- A337: 클라우드 전용(온라인 전용) 파일 배지 — 대기 배지(코드
                             MakePendingBadge)와 같은 한 벌이고 자리만 반대쪽 위다. 표시 여부는
                             뷰모델이 정한다(CloudBadgeVisibility) — 종전에는 조립 코드가 배지를
                             만들지 말지로 갈랐다. 히트 테스트에서 빼지 않는 것도 종전 그대로다
                             (툴팁이 이 배지의 존재 이유를 설명하는 유일한 자리). -->
                        <FontIcon x:Name="TileCloudBadge"
                                  Glyph="&#xE753;" FontSize="10" Opacity="0.55"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,12,12,0"
                                  Visibility="{x:Bind CloudBadgeVisibility}"
                                  ToolTipService.ToolTip="Online-only file — preview needs a download" />
                        <TextBlock x:Name="TileCaption" Grid.Row="1"
                                   Text="{x:Bind Name}" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   Margin="4,0,4,4" />
                        <!-- 일반 선택만 표시하며 콘텐츠와 체크의 의미는 바꾸지 않는다. -->
                        <Border x:Name="TileSelectionOutline" Grid.RowSpan="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2" CornerRadius="4"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </DataTemplate>

            </GridView.Resources>
            <GridView.ItemTemplateSelector>
                <controls:ExplorerTileTemplateSelector FileTemplate="{StaticResource FileTileTemplate}"
                                                       ParentTemplate="{StaticResource ParentTileTemplate}" />
            </GridView.ItemTemplateSelector>
            <!-- 종전 MakeTile이 GridViewItem에 직접 대입하던 두 값의 이관 지점 (A345 배치 3):
                 셀(ItemWidth/ItemHeight — ApplyTileSize)을 타일이 꽉 채워야 미리보기 영역이
                 균일해진다. 이 Setter 둘을 지우면 타일이 셀 안에서 가운데로 쪼그라든다. -->
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
        <Grid x:Name="ListHost" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,44">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="ListColumnHeaders" Padding="8,6" ColumnSpacing="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" /><ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SortNameHeader" Grid.Column="2" MinWidth="0" MinHeight="0" Padding="0"
                        BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock x:Name="SortNameHeaderText" Text="Name" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Name="SortSizeHeader" Margin="8,0,0,0" Grid.Column="3" MinWidth="0" MinHeight="0" Padding="0"
                        BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                    <TextBlock x:Name="SortSizeHeaderText" Text="Size" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Name="SortTypeHeader" Margin="8,0,0,0" Grid.Column="4" MinWidth="0" MinHeight="0" Padding="0"
                        BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock x:Name="SortTypeHeaderText" Text="Type" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Name="SortCreatedHeader" Margin="8,0,0,0" Grid.Column="5" MinWidth="0" MinHeight="0" Padding="0"
                        BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock x:Name="SortCreatedHeaderText" Text="Created" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Name="SortModifiedHeader" Margin="8,0,0,0" Grid.Column="6" MinWidth="0" MinHeight="0" Padding="0"
                        BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <TextBlock x:Name="SortModifiedHeaderText" Text="Modified" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Button>
            </Grid>
        <ListView x:Name="DetailList" Grid.Row="1" Visibility="Collapsed" IsTabStop="True"
                  Background="Transparent" SelectionMode="Extended"
                  IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ContainerContentChanging="OnListContainerContentChanging">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.Resources>
                <DataTemplate x:Key="FileListTemplate" x:DataType="local:ExplorerEntryVm">
                    <Grid Opacity="{x:Bind ContentOpacity, Mode=OneWay}" Padding="8,6" ColumnSpacing="0"
                          MinHeight="{x:Bind ListRowHeight, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind Path}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" /><ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="{x:Bind ListSizeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ListTypeWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ListCreatedWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ListModifiedWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <CheckBox Margin="0,0,8,0" Grid.RowSpan="2" IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="OnTileCheckClick"
                                  MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Check to target file operations (copy, cut, delete, drag, open). No checks = selection." />
                        <FontIcon Margin="0,0,8,0" HorizontalAlignment="Left" Grid.Column="1" Grid.RowSpan="2" Glyph="{x:Bind Glyph}" FontSize="13" Width="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="TileCaption" Grid.Column="2" Text="{x:Bind Name}" FontSize="12"
                                   Grid.ColumnSpan="{x:Bind ListNameSpan, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <FontIcon x:Name="RowCloudBadge" Grid.Column="2" Glyph="&#xE753;" FontSize="10" Opacity="0.55"
                                  Grid.ColumnSpan="{x:Bind ListNameSpan, Mode=OneWay}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Visibility="{x:Bind CloudBadgeVisibility}"
                                  ToolTipService.ToolTip="Online-only file — preview needs a download" />
                        <TextBlock x:Name="RowSizeText" Margin="8,0,0,0" Grid.Column="3" Text="{x:Bind ListSize}" FontSize="12"
                                   Visibility="{x:Bind ListSizeVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock x:Name="RowTypeText" Margin="8,0,0,0" Grid.Column="4" Text="{x:Bind ListType}" FontSize="12"
                                   Visibility="{x:Bind ListTypeVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="RowCreatedText" Margin="8,0,0,0" Grid.Column="5" Text="{x:Bind ListCreated}" FontSize="12"
                                   Visibility="{x:Bind ListCreatedVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="RowModifiedText" Margin="8,0,0,0" Grid.Column="6" Text="{x:Bind ListModified}" FontSize="12"
                                   Visibility="{x:Bind ListModifiedVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="RowSummaryText" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="5"
                                   Text="{x:Bind ListSummary, Mode=OneWay}" FontSize="11" Opacity="0.65"
                                   Visibility="{x:Bind ListSummaryVisibility, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.Resources>
            <ListView.ItemTemplateSelector>
                <controls:ExplorerTileTemplateSelector FileTemplate="{StaticResource FileListTemplate}"
                                                       ParentTemplate="{StaticResource ParentListTemplate}" />
            </ListView.ItemTemplateSelector>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        </Grid>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No matching files here"
                   Visibility="Collapsed" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- A152: 하단 여백 54 = 종전 10 + 하단 바 44 — 바닥 정렬 일시 안내가 모드1에서
             오버레이 바에 가려지지 않게 띄운다(위 TileGrid 패딩과 같은 보정) -->
        <TextBlock x:Name="NoticeText" Grid.Row="1"
                   Visibility="Collapsed" FontSize="12" Opacity="0.8"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="12,0,12,54" />
    </Grid>
</UserControl>
