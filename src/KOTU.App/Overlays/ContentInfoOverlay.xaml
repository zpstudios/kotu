<UserControl
    x:Class="KOTU.App.Overlays.ContentInfoOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 콘텐츠 정보 오버레이 (A57 ①②): 기존 MainWindow의 InfoOverlayRoot를 공용 컨트롤로 추출.
         A57 ①에 따라 우측 30%에 배치(기존 좌측에서 스왑) — 폭은 A33 규칙대로 7*/3* 균등 분할.
         키 매핑은 그대로 Ctrl = 정보(입력 처리는 셸 담당, A32 유지 / A58에서 별도 대체 예정).
         정보 항목은 모듈 뷰(IContentInfoProvider)가 주입하고, 없으면 파일 기본 정보로 대체.
         배경은 약한 틴트 아크릴(A33). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="OverlayBorder" Grid.Column="1"
                Background="{ThemeResource OverlayAcrylicBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="16" IsHitTestVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock x:Name="PinnedText" Text="Pinned — press Ctrl twice to unpin"
                               Visibility="Collapsed" FontSize="11" Opacity="0.6" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
