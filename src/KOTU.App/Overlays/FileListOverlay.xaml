<UserControl
    x:Class="KOTU.App.Overlays.FileListOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 파일 리스트 오버레이 (A57 ①②): 기존 MainWindow의 AltOverlayRoot를 공용 컨트롤로 추출.
         A57 ①에 따라 좌측 30%에 배치(기존 우측에서 스왑) — 폭은 A33 규칙대로 3*/7* 균등 분할.
         키 매핑은 그대로 Alt = 리스트(입력 처리는 셸 담당, A32 유지 / A58에서 별도 대체 예정).
         컨텍스트(폴더·확장자 필터)는 모듈이 Show()로 주입한다(A57 ③ — 모듈 필터가 기본값,
         A7 드롭다운은 ExplorerPane 안에서 그 목록을 추가로 좁힌다).
         배경은 약한 틴트 아크릴(A33) — 아래 콘텐츠가 또렷이 비친다. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Background="{ThemeResource OverlayAcrylicBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="ListHost" IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <TextBlock x:Name="PinnedText" Grid.Row="1"
                           Text="Pinned — press Alt twice to unpin"
                           Visibility="Collapsed" FontSize="11" Opacity="0.6"
                           Margin="12,4,12,8" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
