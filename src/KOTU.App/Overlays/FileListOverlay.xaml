<UserControl
    x:Class="KOTU.App.Overlays.FileListOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 파일 리스트 오버레이 (A57 ①②④): 기존 MainWindow의 AltOverlayRoot를 공용 컨트롤로 추출.
         A57 ①에 따라 좌측에 배치(기존 우측에서 스왑). 폭은 코드(SetPanelPercent, A93)가 정한다:
         콘텐츠 상태 = 30%(A33/A57 규칙 그대로) / S1(빈 파일 모듈) = 25%(3구획 25:50:25).
         키 매핑(A86 — A58의 Alt를 Z로 대체) = Z: 홀드 = 반투명 덮기 / 2초 홀드 = 반투명 고정 /
         2연타 = 불투명 밀어내기 / 열림 상태에서 1회 = 닫기.
         입력 처리는 셸(MainWindow) 담당 — 이 컨트롤은 SetState로 모드
         (TranslucentOver/OpaqueDocked)와 안내 문구만 받는다. 불투명일 때의 실제 폭 차지는
         셸의 도크 컬럼 담당(내부 별 분할은 두 모드 공통 — 전폭 기준 같은 %라 도크와 정렬).
         컨텍스트(폴더·확장자 필터)는 모듈이 Show()로 주입한다(A57 ③ — 모듈 필터가 기본값,
         A7 드롭다운은 ExplorerPane 안에서 그 목록을 추가로 좁힌다).
         세로 분할(A57 ④ + A91): 맨 위 = 주소·필터 줄(A91 — 아래 리스트에서 떼어 올린다),
         그 아래 25% = 드라이브/폴더 트리(지연 로드), 나머지 75% = 폴더 파일 리스트.
         스플리터 없이 1*/3* 고정. 트리 선택은 코드에서 ExplorerPane.NavigateTo로 이어진다.
         기본 배경은 약한 틴트 아크릴(A33) — 아래 콘텐츠가 또렷이 비친다.
         패널 드랍(A94 1차, v0.124.0 — A93의 무동작 소비를 실동작으로 전환): 빈 영역·파일 항목·
         트리 영역 = 현재 폴더로 이동/복사(OnPanelDrop), 리스트의 폴더 항목 위 = 그 폴더로
         (ExplorerPane이 항목 컨테이너에 건다). 폴더 트리는 Single·드래그 불가 유지. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="30*" />
            <ColumnDefinition x:Name="RestColumn" Width="70*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="PanelBorder" Grid.Column="0"
                Background="{ThemeResource OverlayAcrylicBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                AllowDrop="True" DragOver="OnPanelDragOver" Drop="OnPanelDrop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 최상단: 주소·필터 줄 자리 (A91, v0.115.0). 비워 두고 Show()에서
                     ExplorerPane.DetachPathBar()로 떼어 온 줄을 Child로 채운다 —
                     그래서 ContentControl이 아니라 Border다(Border.Child 사용). -->
                <Border x:Name="PathBarHost"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" />
                <!-- 그 아래 25%: 디스크 계층 트리 (A57 ④). 폴더만 — 파일은 하단 리스트 담당.
                     노드는 펼침 시점에 지연 로드하고(OnTreeExpanding), 항목 클릭은
                     OnTreeItemInvoked가 하단 리스트를 그 폴더로 이동시킨다. -->
                <Border Grid.Row="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <TreeView x:Name="FolderTree"
                              SelectionMode="Single"
                              CanDragItems="False"
                              CanReorderItems="False"
                              AllowDrop="False"
                              ItemInvoked="OnTreeItemInvoked"
                              Expanding="OnTreeExpanding" />
                </Border>
                <ContentControl x:Name="ListHost" Grid.Row="2" IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <TextBlock x:Name="PinnedText" Grid.Row="3"
                           Text="Pinned - press Z to close"
                           Visibility="Collapsed" FontSize="11" Opacity="0.6"
                           Margin="12,4,12,8" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
