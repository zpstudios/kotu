<UserControl
    x:Class="KOTU.App.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 내장 탐색기(v0.25.0): 좌 70% 썸네일 그리드(바탕화면 느낌) + 우 30% 리스트.
         Alt 오버레이는 ConfigureListOnly()로 리스트만 남긴다. 항목은 코드에서 채운다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 경로 바: 위로 이동 + 현재 경로(우측 정렬 — 리스트 쪽, A8) + 필터(A7) + 정렬(A5) -->
        <Grid Grid.Row="0" ColumnSpacing="8" Padding="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="OnUpClicked" ToolTipService.ToolTip="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
            <!-- 항목은 담당 확장자에 따라 코드에서 채운다(EnsureFilterFlyout) -->
            <DropDownButton x:Name="FilterButton" Grid.Column="2" Padding="8,5"
                            ToolTipService.ToolTip="Filter file types">
                <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="13" />
            </DropDownButton>
            <DropDownButton x:Name="SortButton" Grid.Column="3" Padding="8,5"
                            ToolTipService.ToolTip="Sort by">
                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="SortByName" Text="Name"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                        <RadioMenuFlyoutItem x:Name="SortBySize" Text="Size"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                        <RadioMenuFlyoutItem x:Name="SortByModified" Text="Date modified"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GridColumn" Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 썸네일 아이콘 그리드 (더블클릭 열기 — 판정은 코드) -->
            <GridView x:Name="IconGrid"
                      Padding="12,4"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick" />

            <!-- 우: 리스트 뷰 -->
            <ListView x:Name="ListPane" Grid.Column="1"
                      Padding="4"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      BorderThickness="1,0,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2"
                       Visibility="Collapsed" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
