<UserControl
    x:Class="KOTU.App.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KOTU.App">

    <!-- 내장 탐색기(v0.25.0): 좌 70% 썸네일 그리드(바탕화면 느낌) + 우 30% 리스트.
         좌 리스트 오버레이는 ConfigureListOnly()로 리스트만 남긴다.
         A345 배치 2: 우 리스트(ListPane)는 ItemsSource + DataTemplate + ContainerContentChanging
         가상화라 보이는 행만 실체화된다. 좌 그리드(IconGrid)는 휴면 표면이라 종전대로 코드가
         컨테이너를 직접 만들어 채운다(MakeGridItem).
         A91(v0.115.0): 좌 오버레이는 DetachPathBar()로 경로 바(PathBar)만 떼어 자기 패널
         최상단에 붙인다. ※ A93(v0.120.0)부터 살아 있는 사용처는 그 좌 오버레이(리스트 전용)뿐 —
         S1 중앙은 ThumbnailExplorer가 대체했다. 전체 페인 XAML은 재사용 대비로 그대로 둔다. -->
    <Grid x:Name="PaneRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 경로 바: 위로 이동 + 홈(A282) + 현재 경로(우측 정렬 — 리스트 쪽, A8) + 필터(A7).
             정렬(A5)은 A155에서 드롭다운(SortButton)을 리스트 컬럼 헤더로 대체해 이 줄에서 빠졌다.
             A282(홈 버튼)는 그 빈자리에 열 1개를 새로 끼웠다 — 뒤 열(경로·필터)은 한 칸씩 밀렸다.
             버튼은 반드시 이 PathBar 안에 둔다: 이 줄은 통째로 떼어져 오버레이로 옮겨 가므로
             (DetachPathBar, A91) 밖에 두면 홈 버튼만 옛 자리에 남는다. -->
        <Grid x:Name="PathBar" Grid.Row="0" ColumnSpacing="8" Padding="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="OnUpClicked" ToolTipService.ToolTip="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <!-- A282: 사용자 프로필 폴더로 한 번에 복귀. 비활성화하지 않는다(이미 홈이면 무동작) -->
            <Button x:Name="HomeButton" Grid.Column="1" Click="OnHomeClicked"
                    ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
            <!-- 항목은 담당 확장자에 따라 코드에서 채운다(EnsureFilterFlyout) -->
            <DropDownButton x:Name="FilterButton" Grid.Column="3" Padding="8,5"
                            ToolTipService.ToolTip="Filter file types">
                <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="13" />
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GridColumn" Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 썸네일 아이콘 그리드 (더블클릭 열기 — 판정은 코드).
                 A94(v0.124.0): Extended = 윈도우 관례 다중선택(Ctrl 토글·Shift 범위·Ctrl+A).
                 드래그 아웃·폴더 항목 드랍은 코드가 항목 컨테이너에 건다(AttachDragDrop).
                 A94 6차(v0.153.0): Background=Transparent — 항목이 없는 빈 영역도 히트 테스트가
                 되어야 빈 영역 우클릭 메뉴(코드에서 ContextFlyout으로 건다)가 뜬다.
                 투명은 화면상 종전과 같다(좌 패널 아크릴이 그대로 비친다). -->
            <!-- A152: 아래 패딩 48 = 종전 4 + 셸 하단 바 두께 44. 좌 패널이 콘텐츠 영역
                 (= 창 전체 — 행 분할 폐지) 바닥까지 내려가 모드1에서는 하단 44px가 바에 덮인다.
                 마지막 항목이 바 뒤에 숨지 않게 스크롤 끝 여백으로 보정한다(모드 불변 상수).
                 좌우 패딩은 종전 그대로 — 타일 폭 계산(ApplyTileSize류)·정렬에 영향 없다. -->
            <GridView x:Name="IconGrid"
                      Padding="12,4,12,48"
                      Background="Transparent"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick" />

            <!-- 우: 컬럼 헤더(A155) + 리스트 뷰. 헤더는 이 리스트에만 있다 — 중앙 썸네일
                 (ThumbnailExplorer)은 헤더 없음(현행 유지). 정렬 설정은 전역 1벌이라 두 표면에
                 같은 순서가 반영된다(RefreshView가 ViewChanged로 같은 목록을 흘린다). -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- A155 → A199: 정렬 헤더 5종(Name/Type/Size/Created/Modified) — 정렬 버튼이
                     본체다(값 표시는 A156의 2줄 행이 담당. 표시 전용 Info 헤더는 A199에서 제거).
                     버튼·컬럼 정의는 코드에서 채운다(BuildListHeader — EnsureFilterFlyout처럼
                     조립 지점 1곳). 아래 구분선은 FileListOverlay의 PathBarHost와 같은 Border 관용구. -->
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid x:Name="ListHeader" ColumnSpacing="4" Padding="8,2,8,2" />
                </Border>
                <!-- 다중선택·드래그·드랍·빈 영역 메뉴는 그리드와 같은 규칙 — A94 -->
                <!-- A152: 아래 패딩 48 = 종전 4 + 하단 바 44 (위 IconGrid와 같은 보정) -->
                <ListView x:Name="ListPane" Grid.Row="1"
                          Padding="4,4,4,48"
                          Background="Transparent"
                          SelectionMode="Extended"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick"
                          ContainerContentChanging="OnListContainerContentChanging"
                          BorderThickness="1,0,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <!-- A156 리스트 행(2줄)을 그대로 옮긴 템플릿 (A345 배치 2).
                         루트는 반드시 **평평한 Grid 하나**다(중첩 패널 금지) — 인라인 이름변경
                         (ExplorerRenameBox.Begin)이 이 Grid에 편집 상자를 Insert하고
                         Grid.SetRow/SetColumn으로 이름 자리에 앉히기 때문이다.
                         x:Name 세 개는 코드의 조회 키 상수(ItemNameBlockName·ItemDetailBlockName·
                         ItemCheckBoxName)와 반드시 같은 값이어야 한다(조회가 이름 기반). -->
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExplorerEntryVm">
                            <Grid ColumnSpacing="8"
                                  Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                          VerticalAlignment="Center" Grid.RowSpan="2" />
                                <TextBlock x:Name="ExplorerItemName" Grid.Column="1"
                                           Text="{x:Bind Name}" FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ExplorerItemDetail" Grid.Column="1" Grid.Row="1"
                                           Text="{x:Bind DetailText, Mode=OneWay}"
                                           FontSize="10" Opacity="0.6"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- A179: 체크 = 선택과 분리된 작업 집합의 시각화(진실은 _checkedPaths).
                                     기본 치수를 0으로 눌러야 2줄 행 높이를 체크박스가 먹지 않는다(A198). -->
                                <CheckBox x:Name="ExplorerItemCheck" Grid.Column="2" Grid.RowSpan="2"
                                          IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                          Click="OnItemCheckClick"
                                          MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Check to target file operations (copy, cut, delete, drag, open). No checks = selection." />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <!-- A198 행 높이 압축(트리 행 32px 동급 목표)의 이관 지점 (A345 배치 2):
                         종전 MakeListItem이 컨테이너에 직접 걸던 두 값을 여기로 옮겼다.
                         ① MinHeight 0 = WinUI 기본 ListViewItemMinHeight 40이 진짜 하한이었다,
                         ② Padding 12,1,12,1 = 세로 1px(기본 세로 패딩 승계 차단, 가로는 기본 근사).
                         이 Setter 둘을 지우면 행 높이가 40px로 회귀한다(되돌리기 지점).
                         나머지 압축분(상세 FontSize 10 · 체크박스 MinHeight 0)은 위 템플릿에 있다. -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- v0.336.1: 콘텐츠(행 Grid)를 컨테이너 폭에 펴야 star 열이 늘어나 체크박스가
                                 우측 끝에 붙는다. 명시 스타일을 걸자 기본값이 좌측 정렬로 떨어져(실기기 보고)
                                 종전 모양(체크박스 우측)과 달라졌다. 셸 MainWindow.xaml의 같은 Setter 선례. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="12,1,12,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2"
                       Visibility="Collapsed" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
