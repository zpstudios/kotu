<UserControl
    x:Class="KOTU.App.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 내장 탐색기(v0.25.0): 좌 70% 썸네일 그리드(바탕화면 느낌) + 우 30% 리스트.
         좌 리스트 오버레이는 ConfigureListOnly()로 리스트만 남긴다. 항목은 코드에서 채운다.
         A91(v0.115.0): 좌 오버레이는 DetachPathBar()로 경로 바(PathBar)만 떼어 자기 패널
         최상단에 붙인다. ※ A93(v0.120.0)부터 살아 있는 사용처는 그 좌 오버레이(리스트 전용)뿐 —
         S1 중앙은 ThumbnailExplorer가 대체했다. 전체 페인 XAML은 재사용 대비로 그대로 둔다. -->
    <Grid x:Name="PaneRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 경로 바: 위로 이동 + 현재 경로(우측 정렬 — 리스트 쪽, A8) + 필터(A7) + 정렬(A5) -->
        <Grid x:Name="PathBar" Grid.Row="0" ColumnSpacing="8" Padding="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="OnUpClicked" ToolTipService.ToolTip="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PathText" Grid.Column="1" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
            <!-- 항목은 담당 확장자에 따라 코드에서 채운다(EnsureFilterFlyout) -->
            <DropDownButton x:Name="FilterButton" Grid.Column="2" Padding="8,5"
                            ToolTipService.ToolTip="Filter file types">
                <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="13" />
            </DropDownButton>
            <DropDownButton x:Name="SortButton" Grid.Column="3" Padding="8,5"
                            ToolTipService.ToolTip="Sort by">
                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <RadioMenuFlyoutItem x:Name="SortByName" Text="Name"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                        <RadioMenuFlyoutItem x:Name="SortBySize" Text="Size"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                        <RadioMenuFlyoutItem x:Name="SortByModified" Text="Date modified"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                        <!-- A117(v0.136.0): 만든 날짜 - date modified와 같은 방식으로 병존 -->
                        <RadioMenuFlyoutItem x:Name="SortByCreated" Text="Date created"
                                             GroupName="kotu-explorer-sort" Click="OnSortChanged" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GridColumn" Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 썸네일 아이콘 그리드 (더블클릭 열기 — 판정은 코드).
                 A94(v0.124.0): Extended = 윈도우 관례 다중선택(Ctrl 토글·Shift 범위·Ctrl+A).
                 드래그 아웃·폴더 항목 드랍은 코드가 항목 컨테이너에 건다(AttachDragDrop).
                 A94 6차(v0.153.0): Background=Transparent — 항목이 없는 빈 영역도 히트 테스트가
                 되어야 빈 영역 우클릭 메뉴(코드에서 ContextFlyout으로 건다)가 뜬다.
                 투명은 화면상 종전과 같다(좌 패널 아크릴이 그대로 비친다). -->
            <GridView x:Name="IconGrid"
                      Padding="12,4"
                      Background="Transparent"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick" />

            <!-- 우: 리스트 뷰 (다중선택·드래그·드랍·빈 영역 메뉴는 그리드와 같은 규칙 — A94) -->
            <ListView x:Name="ListPane" Grid.Column="1"
                      Padding="4"
                      Background="Transparent"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      BorderThickness="1,0,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2"
                       Visibility="Collapsed" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
