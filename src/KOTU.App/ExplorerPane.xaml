<UserControl
    x:Class="KOTU.App.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 내장 탐색기(v0.25.0): 좌 70% 썸네일 그리드(바탕화면 느낌) + 우 30% 리스트.
         좌 리스트 오버레이는 ConfigureListOnly()로 리스트만 남긴다. 항목은 코드에서 채운다.
         A91(v0.115.0): 좌 오버레이는 DetachPathBar()로 경로 바(PathBar)만 떼어 자기 패널
         최상단에 붙인다. ※ A93(v0.120.0)부터 살아 있는 사용처는 그 좌 오버레이(리스트 전용)뿐 —
         S1 중앙은 ThumbnailExplorer가 대체했다. 전체 페인 XAML은 재사용 대비로 그대로 둔다. -->
    <Grid x:Name="PaneRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 경로 바: 위로 이동 + 홈(A282) + 현재 경로(우측 정렬 — 리스트 쪽, A8) + 필터(A7).
             정렬(A5)은 A155에서 드롭다운(SortButton)을 리스트 컬럼 헤더로 대체해 이 줄에서 빠졌다.
             A282(홈 버튼)는 그 빈자리에 열 1개를 새로 끼웠다 — 뒤 열(경로·필터)은 한 칸씩 밀렸다.
             버튼은 반드시 이 PathBar 안에 둔다: 이 줄은 통째로 떼어져 오버레이로 옮겨 가므로
             (DetachPathBar, A91) 밖에 두면 홈 버튼만 옛 자리에 남는다. -->
        <Grid x:Name="PathBar" Grid.Row="0" ColumnSpacing="8" Padding="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="OnUpClicked" ToolTipService.ToolTip="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <!-- A282: 사용자 프로필 폴더로 한 번에 복귀. 비활성화하지 않는다(이미 홈이면 무동작) -->
            <Button x:Name="HomeButton" Grid.Column="1" Click="OnHomeClicked"
                    ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="13" />
            </Button>
            <TextBlock x:Name="PathText" Grid.Column="2" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextAlignment="Right"
                       Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
            <!-- 항목은 담당 확장자에 따라 코드에서 채운다(EnsureFilterFlyout) -->
            <DropDownButton x:Name="FilterButton" Grid.Column="3" Padding="8,5"
                            ToolTipService.ToolTip="Filter file types">
                <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="13" />
            </DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GridColumn" Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 썸네일 아이콘 그리드 (더블클릭 열기 — 판정은 코드).
                 A94(v0.124.0): Extended = 윈도우 관례 다중선택(Ctrl 토글·Shift 범위·Ctrl+A).
                 드래그 아웃·폴더 항목 드랍은 코드가 항목 컨테이너에 건다(AttachDragDrop).
                 A94 6차(v0.153.0): Background=Transparent — 항목이 없는 빈 영역도 히트 테스트가
                 되어야 빈 영역 우클릭 메뉴(코드에서 ContextFlyout으로 건다)가 뜬다.
                 투명은 화면상 종전과 같다(좌 패널 아크릴이 그대로 비친다). -->
            <!-- A152: 아래 패딩 48 = 종전 4 + 셸 하단 바 두께 44. 좌 패널이 콘텐츠 영역
                 (= 창 전체 — 행 분할 폐지) 바닥까지 내려가 모드1에서는 하단 44px가 바에 덮인다.
                 마지막 항목이 바 뒤에 숨지 않게 스크롤 끝 여백으로 보정한다(모드 불변 상수).
                 좌우 패딩은 종전 그대로 — 타일 폭 계산(ApplyTileSize류)·정렬에 영향 없다. -->
            <GridView x:Name="IconGrid"
                      Padding="12,4,12,48"
                      Background="Transparent"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick" />

            <!-- 우: 컬럼 헤더(A155) + 리스트 뷰. 헤더는 이 리스트에만 있다 — 중앙 썸네일
                 (ThumbnailExplorer)은 헤더 없음(현행 유지). 정렬 설정은 전역 1벌이라 두 표면에
                 같은 순서가 반영된다(RefreshView가 ViewChanged로 같은 목록을 흘린다). -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- A155 → A199: 정렬 헤더 5종(Name/Type/Size/Created/Modified) — 정렬 버튼이
                     본체다(값 표시는 A156의 2줄 행이 담당. 표시 전용 Info 헤더는 A199에서 제거).
                     버튼·컬럼 정의는 코드에서 채운다(BuildListHeader — EnsureFilterFlyout처럼
                     조립 지점 1곳). 아래 구분선은 FileListOverlay의 PathBarHost와 같은 Border 관용구. -->
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid x:Name="ListHeader" ColumnSpacing="4" Padding="8,2,8,2" />
                </Border>
                <!-- 다중선택·드래그·드랍·빈 영역 메뉴는 그리드와 같은 규칙 — A94 -->
                <!-- A152: 아래 패딩 48 = 종전 4 + 하단 바 44 (위 IconGrid와 같은 보정) -->
                <ListView x:Name="ListPane" Grid.Row="1"
                          Padding="4,4,4,48"
                          Background="Transparent"
                          SelectionMode="Extended"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick"
                          BorderThickness="1,0,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2"
                       Visibility="Collapsed" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
