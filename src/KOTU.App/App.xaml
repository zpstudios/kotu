<Application
    x:Class="KOTU.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- A33: 오버레이 전용 아크릴 — 기본 인앱 아크릴보다 틴트를 크게 약화해
                     배경 콘텐츠가 또렷이 비친다. 아크릴 미지원 시 폴백도 반투명 단색.
                     A57 ②에서 MainWindow 로컬 리소스 → 앱 리소스로 이동: 공용 오버레이
                     컨트롤(Overlays/*)이 창 밖(InitializeComponent 시점)에서도 찾을 수 있어야 한다. -->
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#202020" TintOpacity="0.1"
                                  TintLuminosityOpacity="0.4"
                                  FallbackColor="#B3202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#F9F9F9" TintOpacity="0.1"
                                  TintLuminosityOpacity="0.4"
                                  FallbackColor="#B3F9F9F9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
