<Application
    x:Class="KOTU.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A176: 오버레이 전용 아크릴(A33 OverlayAcrylicBrush)·스왑체인 반투명 폴백
                 (A129 OverlayTranslucentFallbackBrush)의 ThemeDictionaries 2벌을 통째로 철거 —
                 반투명 표시 축 자체가 폐지되어 소비처(OverlayBackdrop.Pick)가 사라졌다.
                 패널 배경은 각 컨트롤이 불투명 SolidBackgroundFillColorBaseBrush(시스템 테마
                 리소스)를 직접 쓴다. -->

            <!-- A27(v0.107.0): 하단 바 버튼 규격을 앱 전역 스타일 2종으로 못 박는다.
                 ⚠️ 치수 이력: A27 40 → A97(v0.116.0) 36 → **A106(v0.132.0) 32**
                 (두 번 다 사용자 "10% 축소" 지시). A27·A97 기록만 보고 40/36으로 되돌리지 말 것.
                 1칸 = 32×32 (재생·볼륨·메뉴 등 아이콘 하나짜리),
                 2칸 = 84×32 (Fit·재생속도·리프레시 주기 등 텍스트·드롭다운).
                 2칸 폭 84는 **유지**한다(사용자 확정: 폭을 줄이는 것은 "1칸 차지해야 한다고 말한
                 버튼들에 한해서"). 그래서 84는 더 이상 "1칸 2개 + 간격"의 계산값이 아니라
                 텍스트가 들어가는 관습 폭이다.
                 하단 바 두께는 A40의 고정 44 — 32 + 위아래 6 여백으로 들어간다(두께는 불변).
                 ⚠️ A106의 Padding 4 → 2(1칸·토글): 버튼 안 콘텐츠 상자는
                 높이 − 테두리 2 − 패딩 2배다. 32에서 패딩 4를 그대로 두면 22px가 남는데
                 FontIcon FontSize 18의 줄 높이는 약 24라 아이콘이 잘린다.
                 패딩 2면 26px로, A97(36 − 2 − 8 = 26)과 **같은 여유**가 유지된다.
                 버튼 사이 간격은 A97에서 **6으로 통일**했다(각 모듈 바의 ColumnSpacing).
                 통일 대상은 치수·테두리·모서리·패딩·수직 정렬뿐이다. 색은 지정하지 않아
                 시스템 기본 Button 룩(테마 리소스)이 그대로 유지된다(재디자인 아님).
                 WinUI는 Style의 TargetType이 정확히 일치해야 해서 타입별로 파생 스타일을 둔다
                 (Button 스타일을 DropDownButton·ToggleButton·ComboBox에 쓸 수 없다).
                 ⚠️ v0.113.1: DropDownButton·ComboBox의 BasedOn을 제거했다.
                 WinAppSDK 1.8이 WinUI 컨트롤(DropDownButton 등)의 키 있는 기본 스타일을
                 지연 로딩으로 쪼개서(DropDownButton_perf2026.xaml), App.xaml 파싱 시점의
                 StaticResource 조회가 실기기에서 XamlParseException으로 죽는다
                 ("Cannot find a Resource with the Name/Key DefaultDropDownButtonStyle").
                 CI는 컴파일만 하므로 이 오류를 못 잡는다 — 런타임 리소스 키 참조 주의.
                 BasedOn이 없어도 기본 ControlTemplate은 유지된다: WinUI는 명시 스타일에
                 Template setter가 없으면 컨트롤의 기본 스타일 템플릿을 그대로 쓴다
                 (구 Fit SplitButton 3곳이 인라인 값만으로 정상 동작했던 것과 같은 원리).
                 Button·ToggleButton의 DefaultButtonStyle·DefaultToggleButtonStyle은
                 파싱 순서상 실기기에서 해석 성공이 확인돼 그대로 둔다 — 이후 같은
                 예외가 이 키들로 나오면 여기와 똑같이 BasedOn만 제거하면 된다.
                 Fit 조절기(A144에서 SplitButton → 본체 Button + 화살표 DropDownButton 32×32
                 2개로 재구성, 3모듈)의 화살표만 예외: CornerRadius 좌/우 분리가 필요해
                 전역 스타일 대신 뷰에서 인라인 값으로 지정한다(위 BasedOn 금지 사유와 동일 계열). -->
            <Style x:Key="BottomBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 Button — Height 32는 위 1칸 스타일에서 상속받는다(폭만 덮어쓴다) -->
            <Style x:Key="BottomBarWideButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomBarButtonStyle}">
                <Setter Property="Width" Value="84" />
            </Style>
            <!-- 1칸 토글(정보 모듈 Always on top) -->
            <Style x:Key="BottomBarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 드롭다운(정보 모듈 리프레시 주기).
                 Padding은 A106에서도 4 유지 — 내용이 FontSize 12 텍스트 + 화살표(줄 높이 약 16)라
                 32 − 테두리 2 − 패딩 8 = 22px 안에 여유 있게 들어간다(아이콘 18과 사정이 다르다). -->
            <Style x:Key="BottomBarWideDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 콤보(재생속도). 콤보는 안쪽 화살표 배치가 기본 Padding·테두리에 묶여 있어
                 치수와 정렬만 맞추고 Padding·BorderThickness는 기본값을 그대로 둔다.
                 A106의 32는 WinUI ComboBox 기본 MinHeight(ComboBoxMinHeight = 32)와 같은 값이라
                 콤보 입장에서는 오히려 표준 높이다 — 여기서 더 줄이면 기본 Padding에 눌려 잘린다.
                 ⚠️ 실기기에서 "1.0×" 글자가 위아래로 잘리면 이 스타일에 Padding 세터를 추가해
                 상하만 줄인다(화살표 칸이 어긋날 수 있으니 좌우 값은 기본값 그대로 옮겨 적을 것). -->
            <Style x:Key="BottomBarWideComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- A143 주의(v0.174.1): Geometry를 여기(전역 리소스)에 두고 StaticResource로 여러
                 곳에서 공유하면 안 된다 — WinUI Geometry는 부모가 하나뿐이라 PathIcon.Data 할당이
                 런타임 XamlParseException으로 죽는다(실기기 크래시 실사례. CI는 컴파일만 하므로
                 못 잡는다). 도형이 필요하면 사용처마다 인라인 Data 문자열이나 코드 빌더로 새
                 인스턴스를 만들 것. ※ 이 경고를 낳았던 100% 아이콘 도형 자체는 A231에서 폐기했다
                 (Fit 본체 버튼의 소형 텍스트 "100%"로 대체 — 저장소에 남은 Geometry 공유 사례 0건). -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
