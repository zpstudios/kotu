<Application
    x:Class="KOTU.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- A33: 오버레이 전용 아크릴 — 기본 인앱 아크릴보다 틴트를 크게 약화해
                     배경 콘텐츠가 또렷이 비친다. 아크릴 미지원 시 폴백도 반투명 단색.
                     A57 ②에서 MainWindow 로컬 리소스 → 앱 리소스로 이동: 공용 오버레이
                     컨트롤(Overlays/*)이 창 밖(InitializeComponent 시점)에서도 찾을 수 있어야 한다. -->
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#202020" TintOpacity="0.1"
                                  TintLuminosityOpacity="0.4"
                                  FallbackColor="#B3202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#F9F9F9" TintOpacity="0.1"
                                  TintLuminosityOpacity="0.4"
                                  FallbackColor="#B3F9F9F9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- A27(v0.107.0): 하단 바 버튼 규격을 앱 전역 스타일 2종으로 못 박는다.
                 1칸 = 40×40 (재생·볼륨·열기·메뉴 등 아이콘 하나짜리),
                 2칸 = 84×40 (Fit·재생속도·리프레시 주기 등 텍스트·드롭다운. 1칸 2개 + 간격 4).
                 40은 v0.53.0부터 "다른 모듈과 통일" 주석과 함께 굳어 있던 정사각 버튼 크기이고,
                 하단 바 두께는 A40의 고정 44 — 40 + 위아래 2 여백으로 그대로 들어간다.
                 통일 대상은 치수·테두리·모서리·패딩·수직 정렬뿐이다. 색은 지정하지 않아
                 시스템 기본 Button 룩(테마 리소스)이 그대로 유지된다(재디자인 아님).
                 WinUI는 Style의 TargetType이 정확히 일치해야 해서 타입별로 파생 스타일을 둔다
                 (Button 스타일을 DropDownButton·ToggleButton·ComboBox에 쓸 수 없다).
                 BasedOn은 필수 — 생략하면 기본 스타일의 ControlTemplate을 잃을 수 있다.
                 SplitButton(Fit)만 예외: WinUI가 키 있는 기본 스타일을 노출하지 않아
                 BasedOn 대상이 없어서 같은 값(84×40)을 뷰에서 직접 지정한다. -->
            <Style x:Key="BottomBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="BottomBarWideButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomBarButtonStyle}">
                <Setter Property="Width" Value="84" />
            </Style>
            <!-- 1칸 토글(정보 모듈 Always on top) -->
            <Style x:Key="BottomBarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 드롭다운(정보 모듈 리프레시 주기) -->
            <Style x:Key="BottomBarWideDropDownButtonStyle" TargetType="DropDownButton" BasedOn="{StaticResource DefaultDropDownButtonStyle}">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 콤보(재생속도). 콤보는 안쪽 화살표 배치가 기본 Padding·테두리에 묶여 있어
                 치수와 정렬만 맞추고 Padding·BorderThickness는 기본값을 그대로 둔다. -->
            <Style x:Key="BottomBarWideComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
