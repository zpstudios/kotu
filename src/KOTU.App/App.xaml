<Application
    x:Class="KOTU.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- A33: 오버레이 전용 아크릴 — 기본 인앱 아크릴보다 틴트를 크게 약화해
                     배경 콘텐츠가 또렷이 비친다. 아크릴 미지원 시 폴백도 반투명 단색.
                     A57 ②에서 MainWindow 로컬 리소스 → 앱 리소스로 이동: 공용 오버레이
                     컨트롤(Overlays/*)이 창 밖(InitializeComponent 시점)에서도 찾을 수 있어야 한다.
                     A108(v0.135.0): 불투명도를 종전의 약 60% 수준으로 한 단계 더 약화 —
                     TintOpacity 0.1 → 0.06, TintLuminosityOpacity 0.4 → 0.24, 폴백 알파 B3 → 6B.
                     오버레이(반투명 홀드·고정)가 사이드바(불투명 도크)와 한눈에 구분되게 하기 위함.
                     ⚠️ 실기기에서 눈으로 보고 미세 조정하는 단일 지점 — 세 값을 같은 비율로 움직이고,
                     Default(다크)/Light 두 딕셔너리를 반드시 같은 값으로 유지할 것(한쪽만 고치면
                     테마 전환에서 원복된 것처럼 보인다). 좌우 패널·S4 중앙이 전부 이 브러시 하나를
                     공유하므로 여기만 고치면 전 오버레이에 일괄 반영된다. -->
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#202020" TintOpacity="0.06"
                                  TintLuminosityOpacity="0.24"
                                  FallbackColor="#6B202020" />
                    <!-- A129(v0.156.0): 스왑체인(libvlc VideoView — 비디오 화면·오디오 파형) 위
                         전용 반투명 단색 폴백.
                         인앱 아크릴(위 OverlayAcrylicBrush)은 같은 XAML 렌더 결과만 배경 샘플하므로,
                         별도 비주얼로 합성되는 D3D 스왑체인의 프레임은 샘플에 안 들어간다.
                         아크릴 출력은 그 샘플의 불투명 합성이라 비디오 위에서 "불투명 판"으로
                         보였다(A129 실기기 보고 — 이미지 모듈은 XAML이 그리므로 정상 반투명).
                         이 브러시는 진짜 알파 합성이라 스왑체인 위에서도 투과가 성립한다
                         (블러는 포기 — 반투명 통일이 기준, A129 사용자 확정).
                         색·알파 = 위 아크릴 FallbackColor와 동일한 #6B + 테마 바탕색(A108의 6B) —
                         아크릴 미지원 폴백과 같은 농도로 보이게 잡은 값이다.
                         브러시 선택은 코드 한 곳(Overlays/OverlayBackdrop.Pick)만 한다.
                         Default/Light 두 딕셔너리의 알파(6B)를 반드시 같게 유지할 것. -->
                    <SolidColorBrush x:Key="OverlayTranslucentFallbackBrush" Color="#6B202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                  TintColor="#F9F9F9" TintOpacity="0.06"
                                  TintLuminosityOpacity="0.24"
                                  FallbackColor="#6BF9F9F9" />
                    <!-- A129: 스왑체인 위 반투명 폴백의 라이트 쌍 — 근거는 Default 쪽 주석.
                         알파(6B)는 두 테마 동일 유지(한쪽만 고치면 테마 전환에서 어긋난다). -->
                    <SolidColorBrush x:Key="OverlayTranslucentFallbackBrush" Color="#6BF9F9F9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- A27(v0.107.0): 하단 바 버튼 규격을 앱 전역 스타일 2종으로 못 박는다.
                 ⚠️ 치수 이력: A27 40 → A97(v0.116.0) 36 → **A106(v0.132.0) 32**
                 (두 번 다 사용자 "10% 축소" 지시). A27·A97 기록만 보고 40/36으로 되돌리지 말 것.
                 1칸 = 32×32 (재생·볼륨·메뉴 등 아이콘 하나짜리),
                 2칸 = 84×32 (Fit·재생속도·리프레시 주기 등 텍스트·드롭다운).
                 2칸 폭 84는 **유지**한다(사용자 확정: 폭을 줄이는 것은 "1칸 차지해야 한다고 말한
                 버튼들에 한해서"). 그래서 84는 더 이상 "1칸 2개 + 간격"의 계산값이 아니라
                 텍스트가 들어가는 관습 폭이다.
                 하단 바 두께는 A40의 고정 44 — 32 + 위아래 6 여백으로 들어간다(두께는 불변).
                 ⚠️ A106의 Padding 4 → 2(1칸·토글): 버튼 안 콘텐츠 상자는
                 높이 − 테두리 2 − 패딩 2배다. 32에서 패딩 4를 그대로 두면 22px가 남는데
                 FontIcon FontSize 18의 줄 높이는 약 24라 아이콘이 잘린다.
                 패딩 2면 26px로, A97(36 − 2 − 8 = 26)과 **같은 여유**가 유지된다.
                 버튼 사이 간격은 A97에서 **6으로 통일**했다(각 모듈 바의 ColumnSpacing).
                 통일 대상은 치수·테두리·모서리·패딩·수직 정렬뿐이다. 색은 지정하지 않아
                 시스템 기본 Button 룩(테마 리소스)이 그대로 유지된다(재디자인 아님).
                 WinUI는 Style의 TargetType이 정확히 일치해야 해서 타입별로 파생 스타일을 둔다
                 (Button 스타일을 DropDownButton·ToggleButton·ComboBox에 쓸 수 없다).
                 ⚠️ v0.113.1: DropDownButton·ComboBox의 BasedOn을 제거했다.
                 WinAppSDK 1.8이 WinUI 컨트롤(DropDownButton 등)의 키 있는 기본 스타일을
                 지연 로딩으로 쪼개서(DropDownButton_perf2026.xaml), App.xaml 파싱 시점의
                 StaticResource 조회가 실기기에서 XamlParseException으로 죽는다
                 ("Cannot find a Resource with the Name/Key DefaultDropDownButtonStyle").
                 CI는 컴파일만 하므로 이 오류를 못 잡는다 — 런타임 리소스 키 참조 주의.
                 BasedOn이 없어도 기본 ControlTemplate은 유지된다: WinUI는 명시 스타일에
                 Template setter가 없으면 컨트롤의 기본 스타일 템플릿을 그대로 쓴다
                 (SplitButton 3곳이 인라인 값만으로 정상 동작하는 것과 같은 원리).
                 Button·ToggleButton의 DefaultButtonStyle·DefaultToggleButtonStyle은
                 파싱 순서상 실기기에서 해석 성공이 확인돼 그대로 둔다 — 이후 같은
                 예외가 이 키들로 나오면 여기와 똑같이 BasedOn만 제거하면 된다.
                 SplitButton(Fit)만 예외: 같은 값(84×32)을 뷰에서 직접 지정한다(3곳). -->
            <Style x:Key="BottomBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 Button — Height 32는 위 1칸 스타일에서 상속받는다(폭만 덮어쓴다) -->
            <Style x:Key="BottomBarWideButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomBarButtonStyle}">
                <Setter Property="Width" Value="84" />
            </Style>
            <!-- 1칸 토글(정보 모듈 Always on top) -->
            <Style x:Key="BottomBarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 드롭다운(정보 모듈 리프레시 주기).
                 Padding은 A106에서도 4 유지 — 내용이 FontSize 12 텍스트 + 화살표(줄 높이 약 16)라
                 32 − 테두리 2 − 패딩 8 = 22px 안에 여유 있게 들어간다(아이콘 18과 사정이 다르다). -->
            <Style x:Key="BottomBarWideDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- 2칸 콤보(재생속도). 콤보는 안쪽 화살표 배치가 기본 Padding·테두리에 묶여 있어
                 치수와 정렬만 맞추고 Padding·BorderThickness는 기본값을 그대로 둔다.
                 A106의 32는 WinUI ComboBox 기본 MinHeight(ComboBoxMinHeight = 32)와 같은 값이라
                 콤보 입장에서는 오히려 표준 높이다 — 여기서 더 줄이면 기본 Padding에 눌려 잘린다.
                 ⚠️ 실기기에서 "1.0×" 글자가 위아래로 잘리면 이 스타일에 Padding 세터를 추가해
                 상하만 줄인다(화살표 칸이 어긋날 수 있으니 좌우 값은 기본값 그대로 옮겨 적을 것). -->
            <Style x:Key="BottomBarWideComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="84" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- A143: Fit "100%"(원본 크기) 아이콘. Segoe에 쓸 만한 글리프가 없다는 것이 A111 판정이라
                 벡터로 직접 그린다. 형태 = 본체 표기로 쓰던 "1:1"을 그대로 도형화한 것(의미 인지 보존).
                 16x16 좌표계 기준 — PathIcon은 도형을 스케일하지 않고 그대로 그리므로 이 크기가 곧 표시 크기다.
                 3곳(이미지·문서·영상 플라이아웃)과 본체 3벌이 이 한 벌을 참조한다. 모양을 바꾸려면 여기만 고친다.
                 도형 6개 = 왼쪽 1(깃발+기둥 / 밑변) · 콜론 점 2개 · 오른쪽 1(깃발+기둥 / 밑변).

                 ⚠️ v0.169.1 실패 교훈: WinUI XAML 컴파일러는 Figures에 path 미니언어 문자열을 못 받는다
                 (WMC0055 "Cannot assign text value into property Figures of type PathFigureCollection" —
                 WPF와 다르다. Data="M ..."처럼 Geometry 타입 속성에 거는 문자열 변환만 성립한다).
                 그래서 요소 구문(PathFigure + LineSegment)으로 쓴다. Point 문자열 변환("x,y")은
                 RenderTransformOrigin 등으로 이미 실증된 것이라 안전하다.
                 Geometry는 여러 PathIcon이 공유해도 되지만 PathIcon 인스턴스(UIElement)는 공유 불가다. -->
            <PathGeometry x:Key="ActualSizeIconGeometry">
                <PathGeometry.Figures>
                    <PathFigure StartPoint="2.3,5.0" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="4.2,3.0" />
                            <LineSegment Point="5.0,3.0" />
                            <LineSegment Point="5.0,11.4" />
                            <LineSegment Point="3.5,11.4" />
                            <LineSegment Point="3.5,5.0" />
                        </PathFigure.Segments>
                    </PathFigure>
                    <PathFigure StartPoint="1.8,11.4" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="6.7,11.4" />
                            <LineSegment Point="6.7,13.0" />
                            <LineSegment Point="1.8,13.0" />
                        </PathFigure.Segments>
                    </PathFigure>
                    <PathFigure StartPoint="7.4,6.0" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="8.8,6.0" />
                            <LineSegment Point="8.8,7.4" />
                            <LineSegment Point="7.4,7.4" />
                        </PathFigure.Segments>
                    </PathFigure>
                    <PathFigure StartPoint="7.4,9.6" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="8.8,9.6" />
                            <LineSegment Point="8.8,11.0" />
                            <LineSegment Point="7.4,11.0" />
                        </PathFigure.Segments>
                    </PathFigure>
                    <PathFigure StartPoint="10.5,5.0" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="12.4,3.0" />
                            <LineSegment Point="13.2,3.0" />
                            <LineSegment Point="13.2,11.4" />
                            <LineSegment Point="11.7,11.4" />
                            <LineSegment Point="11.7,5.0" />
                        </PathFigure.Segments>
                    </PathFigure>
                    <PathFigure StartPoint="10.0,11.4" IsClosed="True" IsFilled="True">
                        <PathFigure.Segments>
                            <LineSegment Point="14.9,11.4" />
                            <LineSegment Point="14.9,13.0" />
                            <LineSegment Point="10.0,13.0" />
                        </PathFigure.Segments>
                    </PathFigure>
                </PathGeometry.Figures>
            </PathGeometry>
        </ResourceDictionary>
    </Application.Resources>
</Application>
