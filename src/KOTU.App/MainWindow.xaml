<Window
    x:Class="KOTU.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:overlays="using:KOTU.App.Overlays">

    <!--
      Windows 시작 메뉴 스타일 셸(v0.18.0, 기존 좌측 NavigationView 대체):
      하단 바 좌측의 메뉴 버튼을 누르면 위로 플라이아웃이 떠오른다.
      항목 순서(아래→위, A96/v0.116.0 기준): All Readable(1) - 사진·영상·오디오·문서 그룹(2~5) -
      압축(6) - H/W(7) - Settings(0) - 스폰서(광고). 실제 조립은 코드(BuildStartMenu)가 한다.
      하단 바 우측 Info·Settings 아이콘은 제거(v0.28.2) — 시작 메뉴로 일원화.
      창 전체 드롭(A93에서 "콘텐츠 영역" 폴백으로 재정의): 우측 인포 드랍 = 열기(오버레이가 소비),
      좌 패널·중앙 썸네일 드랍 = 무동작(A94 몫), 나머지 영역은 콘텐츠 열림 시 같은 종류만
      그 자리에서 열고 다른 종류는 새 인스턴스로(OnWindowDrop).
    -->
    <!-- ScaleHost: UI 스케일 오버라이드(v0.24.0)의 기준 크기. RootLayout에 ScaleTransform을
         걸고 역수 크기를 줘서 창 전체가 선택 배율로 그려지게 한다(ApplyUiScale). -->
    <Grid x:Name="ScaleHost">
    <Grid x:Name="RootLayout" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
        <!-- 오버레이 전용 아크릴(OverlayAcrylicBrush, A33)은 A57 ②에서 App.xaml로 이동 —
             공용 오버레이 컨트롤(Overlays/*)도 같은 브러시를 쓰기 때문. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- 고정 44px 한 줄(A40): 창 크기·모듈 바 내용과 무관하게 두께 일정.
                 v0.64.2의 "내용에 따라 세로로 자람"(Auto+MinHeight)을 대체. H/W 센서 그래프도
                 접히는 대신 1줄 유지다(A60 3차부터 긴 그래프 2개 고정 — 좁으면 맥박만 숨긴다,
                 HardwareView.UpdateBarDensity). 전체화면에서 0으로 만드는 건 코드(AppWindow.Changed) 담당. -->
            <RowDefinition x:Name="BottomBarRow" Height="44" />
        </Grid.RowDefinitions>

        <!-- 중앙 영역 (A58 사이드바 레이아웃): 좌 도크 / 메인 / 우 도크 3컬럼.
             용어(A108): 사이드바 = 불투명, 메인을 줄이며 옆에 선다(OpaqueDocked) /
             오버레이 = 반투명, 메인 위에 덮인다(홀드·고정 — 도크 컬럼을 차지하지 않는다).
             평소에는 도크 폭 0 = 메인이 전폭. 사이드바(OpaqueDocked)면
             코드(ApplyOverlayStates)가 도크 컬럼을 키워 메인(ModuleHost/ExplorerHost)을 축소한다.
             도크 폭은 전 상태 공통 SidebarPercent 25%(A116, v0.135.0 — 종전 "S1 25% / 콘텐츠 30%"
             상태별 2값 폐지: 같은 3구획 화면이 상태에 따라 30:40:30으로 바뀌던 원인).
             패널 컨트롤은 항상 전폭으로 겹치고(ColumnSpan=3) 내부 별 분할(SetPanelPercent)을
             같은 %로 맞춰서 도크 컬럼과 픽셀 단위로 정렬된다. -->
        <Grid x:Name="CenterArea" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftDockColumn" Width="0" />
                <ColumnDefinition x:Name="CenterColumn" Width="10*" />
                <ColumnDefinition x:Name="RightDockColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="ModuleHost"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                <TextBlock Text="Open a file, or use the menu at the bottom left"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6"/>
            </ContentControl>

            <!-- 빈 상태(S1) 중앙 썸네일 뷰 호스트 (v0.25.0 ExplorerPane → A93 ThumbnailExplorer):
                 모듈을 파일 없이 열면 중앙 영역을 채운다. 목록은 좌 도크 리스트와 공유(A93),
                 파일 더블클릭 → 라우팅으로 열리며 자동으로 내려간다. 좌 도크가 열려 있어도
                 숨기지 않는다(A81 중앙 숨김 대체). -->
            <Grid x:Name="ExplorerHost" Grid.Column="1" Visibility="Collapsed"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

            <!-- 좌측 파일 리스트 패널 (v0.25.0 → A57 ②에서 공용 컨트롤로 추출).
                 입력 매핑(A86 — A58의 Alt를 Z로 대체): Z 홀드 = 오버레이 덮기 / 2초 홀드 = 오버레이 고정 /
                 Z 2연타 = 사이드바(A108 용어 — 구 불투명 밀어내기), 열림 상태에서 Z 1회 = 닫기(A86 신설). -->
            <overlays:FileListOverlay x:Name="ListOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" />

            <!-- 우측 정보 패널 (A57 ②에서 공용 컨트롤로 추출. 키는 v0.45.0 Ctrl→Shift,
                 A32 Ctrl 회귀 → A58 Shift → A86(v0.121.0) X로 확정.
                 정보 항목은 모듈 뷰(IContentInfoProvider)가 주입).
                 입력 매핑(A86): X 홀드 = 오버레이 덮기 / 2초 홀드 = 오버레이 고정 /
                 X 2연타 = 사이드바(A108 용어 — 구 불투명 밀어내기), 열림 상태에서 X 1회 = 닫기(A86 신설). -->
            <overlays:ContentInfoOverlay x:Name="InfoOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" />

            <!-- A119 모듈 고유 좌/우 패널 호스트(ISidePanelProvider — 정보 모듈의 큰 그래프/스펙 텍스트).
                 파일 오버레이(위 두 컨트롤)와 같은 층·같은 상태 규칙(반투명/불투명 배경·안내 문구·
                 홀드 중 클릭 통과)을 SidePanelHost가 재현한다. 어느 쪽이 뜰지는 현재 뷰의 계약 구현
                 여부로 코드(ApplyOverlayStates)가 가른다 — 파일 컨텍스트면 위 오버레이, 패널 제공
                 뷰면 이 호스트. 좌/우 방향 조립은 코드 Initialize(생성자 1회)가 한다(자체 XAML 없는
                 코드 전용 컨트롤). 경계 버튼보다 먼저 선언 = 버튼이 위 z순서(파일 오버레이와 동일 —
                 반투명 홀드 중에도 버튼이 눌린다). 모듈 전환 시 코드 ClearModulePanels가 비운다. -->
            <overlays:SidePanelHost x:Name="LeftPanelHost" Grid.ColumnSpan="3" Visibility="Collapsed" />
            <overlays:SidePanelHost x:Name="RightPanelHost" Grid.ColumnSpan="3" Visibility="Collapsed" />

            <!-- A86 경계 버튼(keymap Q7): 좌/우 각각 중간 높이, 패널(사이드바/오버레이)과 메인의
                 경계선에 반씩 걸친다(메인을 살짝 덮음). 동작 = 사이드바(불투명 도크) 토글,
                 마우스가 경계 근처에 왔을 때만 표시(코드 OnRootPointerMoved), 닫힌 상태에서는
                 창 가장자리가 그 자리.
                 크기 20×44: 높이 44 = 터치 타깃 관례(하단 바 두께와 동일), 폭 20 = 하단 바 버튼
                 36의 절반 근처로 좁혀 콘텐츠 가림 최소화. 위치(Margin)·글리프는 코드
                 UpdateEdgeButtons가 도크 폭 계산과 함께 정한다. 패널들보다 나중 선언 = 위
                 z순서라, 반투명 홀드 중(IsHitTestVisible=false인 패널) 위에서도 눌린다.
                 A108: 도크·고정 안내 문구(각 패널 컨트롤의 PinnedText)가 이 버튼의 화면 안쪽 옆에
                 뜬다(좌 = 버튼 오른쪽 / 우 = 버튼 왼쪽, 세로 중앙 동일 — 버튼이 근접 표시로 숨어
                 있어도 문구만 그 자리에 뜨면 된다는 A108 확정).
                 A133(v0.155.0): 그 문구는 다크 반투명 판(PinnedPlate) 안에 든다 — 자리·정렬 규칙은
                 그대로고 판이 그 자리를 차지한다(가독성 목적, A12 칩 규격). -->
            <Button x:Name="LeftEdgeButton" Grid.ColumnSpan="3"
                    Width="20" Height="44" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="Collapsed" IsTabStop="False"
                    ToolTipService.ToolTip="Open or close the left sidebar"
                    Click="OnLeftEdgeToggle">
                <FontIcon x:Name="LeftEdgeGlyph" Glyph="&#xE76C;" FontSize="10" />
            </Button>
            <Button x:Name="RightEdgeButton" Grid.ColumnSpan="3"
                    Width="20" Height="44" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Visibility="Collapsed" IsTabStop="False"
                    ToolTipService.ToolTip="Open or close the right sidebar"
                    Click="OnRightEdgeToggle">
                <FontIcon x:Name="RightEdgeGlyph" Glyph="&#xE76B;" FontSize="10" />
            </Button>

            <!-- A90 S4('오픈 파일' 탐색 모드) 중앙 오버레이: 반투명 썸네일 탐색기(S4 전용 인스턴스,
                 코드 EnsureS4Explorer)가 가운데 스페이서 컬럼(S4CenterHost)에 얹힌다.
                 좌/우 스페이서는 그때 떠 있는 좌/우 패널 폭(%)과 같은 별 값으로
                 코드(ApplyOverlayStates)가 맞춘다 — 반투명 패널(TranslucentPinned)은 도크 컬럼을
                 차지하지 않으므로 이 호스트가 스스로 비켜야 패널과 겹치지 않는다.
                 경계 버튼보다 나중 선언이지만 S4에서 경계 버튼은 표시 안 함(keymap)이라 z순서 무관. -->
            <Grid x:Name="S4Host" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="S4LeftSpacer" Width="0" />
                    <ColumnDefinition x:Name="S4CenterColumn" Width="10*" />
                    <ColumnDefinition x:Name="S4RightSpacer" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="S4CenterHost" Grid.Column="1" />
            </Grid>

            <!-- A90-b "이미 열려 있음" 강조: S1에서 '오픈 파일'을 누르면 중앙 썸네일 뷰 둘레에
                 잠깐 비추는 액센트 테두리(코드 FlashAlreadyOpen — 타이머 + Visibility 2단계,
                 Storyboard 불사용: 실패해도 강조만 안 보인다). 브러시 키는 DriveStrip이 이미 쓰는
                 AccentFillColorDefaultBrush — 실기기 해석 선례가 있는 테마 리소스만 쓴다. -->
            <Border x:Name="S1FlashBorder" Grid.Column="1"
                    BorderThickness="3"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>

        <!-- 하단 바 (작업표시줄 느낌). 전체화면에서는 코드에서 통째로 숨긴다(v0.21.0) -->
        <Grid x:Name="BottomBar" Grid.Row="1" Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- 현재 모드 칩: 모듈 글리프 + 브랜드명(중립색). 색 구분은 창·트레이 아이콘이 담당(v0.26.0).
                 모듈이 하단 바 줄(ModuleBarHost)을 제공하면 칩은 숨긴다 -->
            <StackPanel x:Name="ModeChip" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <FontIcon x:Name="ModeChipIcon" FontSize="14" />
                <TextBlock x:Name="ModeChipText" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <!-- 모듈 제공 하단 바(동영상 트랜스포트 등) — 메뉴 버튼과 우측 아이콘 사이 (v0.21.0) -->
            <!-- 좌측 Margin 82 = 바 좌측 가장자리 여백 6 + 메뉴 버튼 32(A106) + 간격 6
                 + '오픈 파일' 버튼 32(A90) + 간격 6. 이력: A97(v0.116.0)에서 52→48,
                 A90이 버튼 하나를 더해 48→90, A106(v0.132.0)에서 버튼 36→32라 90→82.
                 가장자리 여백 6·우측 12는 유지. -->
            <ContentControl x:Name="ModuleBarHost"
                            IsTabStop="False"
                            Margin="82,0,12,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" />

            <!-- A27(v0.107.0): 메뉴 버튼도 1칸 공통 규격 — 투명 배경·테두리 0이던 예외를 없애
                 다른 하단 바 버튼과 외곽선을 통일. 규격 이력: 40×40 → 36×36(A97) → 32×32(A106).
                 좌측 여백 6은 유지(ModuleBarHost의 Margin 82가 이 폭 6+32와
                 '오픈 파일' 버튼 32(A90)·간격 6×2를 전제한다). -->
            <!-- 툴팁은 코드(RegisterShortcuts)가 단다 — A34: 키 문자(MenuShortcutHint)와
                 표기를 한 값에서 조립해 어긋날 수 없게 하기 위해서다. -->
            <Button x:Name="StartButton"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="StartFlyout" Placement="TopEdgeAlignedLeft">
                        <Flyout.FlyoutPresenterStyle>
                            <!-- A50(v0.92.0): 프레젠터 기본 패딩(좌우 16의 데드존 포함)을 0으로.
                                 Stretch인 항목 버튼이 메뉴 좌우 가장자리까지 닿아,
                                 포인터가 라벨보다 왼쪽에 있어도 항목이 선택된다.
                                 상하 여백은 아래 StackPanel Padding 4가 대신한다.

                                 A96(v0.116.0) 하단 바 밀착: 메뉴 바탕창이 하단 바에서 떠서
                                 뒤 배경이 얇게 비친다는 지적. WinUI Flyout은 대상 요소와의
                                 간격 오프셋을 속성으로도 테마 리소스로도 내놓지 않으므로,
                                 프레젠터에 음수 아래 여백을 줘 그만큼 끌어내린다
                                 (Flyout 배치는 프레젠터의 DesiredSize 기준이라, 아래 여백이
                                 음수면 그 크기만큼 아래로 내려간다).
                                 값 6의 근거 = 44px 바 안에서 StartButton이 36(A97)이라
                                 위아래로 남는 여백 4 + WinUI 기본 플라이아웃 간격의 합을 상쇄.
                                 ※ A106(v0.132.0)에서 StartButton이 32가 되어 위아래 여백은 6이 됐지만
                                 이 값은 **사용자 지시로 유지**한다(눈으로 맞춘 값이라 산식으로 밀지 않는다).
                                 ⚠️ **실기기에서 눈으로 보고 미세 조정하는 단일 지점**이다 —
                                 더 붙이려면 숫자를 키우고(예: -8), 겹치면 줄인다. 다른 곳은 손대지 말 것. -->
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,-6" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <!-- 항목은 코드(BuildStartMenu)에서 채운다.
                             폭 136(A96/v0.116.0 — v0.35.0의 124에서 +10%): 광고 카드
                             (2:1 이미지가 폭을 꽉 채움, v0.43.0)가 이 폭의 기준이라
                             BuildSponsorCard의 이미지 규격 132×66도 같이 움직인다. -->
                        <StackPanel x:Name="StartMenuPanel" Width="136" Padding="0,4,0,4" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- A90 '오픈 파일' 버튼 — 시작 메뉴 버튼 바로 옆(좌측 44 = 여백 6 + 메뉴 버튼 32 + 간격 6.
                 A106(v0.132.0)에서 버튼 36→32라 48→44).
                 네이티브 파일 대화상자를 띄우지 않고 자체 탐색기(S4 탐색 모드)를 연다 —
                 상태별 분배는 코드 OnOpenFileClick(keymap '오픈 파일' 행).
                 핫키는 배정하지 않는다: A34 키 맵 표(문자 키 전수 배정)가 확정된 뒤 신설된 버튼이라
                 표에 자리가 없다 — 키가 필요해지면 A34 표·keymap과 함께 재론. 그래서 툴팁도
                 A34 "(키)" 표기 없이 설명만 단다. 글리프 E8E5 = 모듈 Open 버튼들과 같은 OpenFile. -->
            <Button x:Name="OpenFileButton"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Margin="44,0,0,0"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Open file"
                    Click="OnOpenFileClick">
                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
            </Button>

            <!-- 인스턴스 번호 배지(A2, v0.58.0 — 메뉴 버튼 위에 겹친 16×16 색상 원)는
