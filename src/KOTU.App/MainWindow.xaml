<Window
    x:Class="KOTU.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Windows 시작 메뉴 스타일 셸(v0.18.0, 기존 좌측 NavigationView 대체):
      하단 바 좌측의 메뉴 버튼을 누르면 위로 플라이아웃이 떠오른다.
      항목 순서(아래→위): 사진·영상·문서 그룹 - 압축 - H/W·Settings - 스폰서(광고).
      하단 바 우측 Info·Settings 아이콘은 제거(v0.28.2) — 시작 메뉴로 일원화.
      창 전체 드롭은 유지: 어떤 파일이든 떨어뜨리면 확장자로 담당 모듈에 라우팅.
    -->
    <!-- ScaleHost: UI 스케일 오버라이드(v0.24.0)의 기준 크기. RootLayout에 ScaleTransform을
         걸고 역수 크기를 줘서 창 전체가 선택 배율로 그려지게 한다(ApplyUiScale). -->
    <Grid x:Name="ScaleHost">
    <Grid x:Name="RootLayout" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- A33: 오버레이 전용 아크릴 — 기본 인앱 아크릴보다 틴트를 크게 약화해
                         배경 콘텐츠가 또렷이 비친다. 아크릴 미지원 시 폴백도 반투명 단색. -->
                    <ResourceDictionary x:Key="Default">
                        <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                      TintColor="#202020" TintOpacity="0.1"
                                      TintLuminosityOpacity="0.4"
                                      FallbackColor="#B3202020" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <AcrylicBrush x:Key="OverlayAcrylicBrush"
                                      TintColor="#F9F9F9" TintOpacity="0.1"
                                      TintLuminosityOpacity="0.4"
                                      FallbackColor="#B3F9F9F9" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- 고정 44px 한 줄(A40): 창 크기·모듈 바 내용과 무관하게 두께 일정.
                 v0.64.2의 "내용에 따라 세로로 자람"(Auto+MinHeight)을 대체. H/W 센서 카드도
                 접히는 대신 1줄 유지로 바뀌었다(HardwareView.LayoutSensorCards).
                 전체화면에서 0으로 만드는 건 코드(AppWindow.Changed) 담당. -->
            <RowDefinition x:Name="BottomBarRow" Height="44" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="ModuleHost"
                        Grid.Row="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <TextBlock Text="Open a file, or use the menu at the bottom left"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"/>
        </ContentControl>

        <!-- 빈 상태 탐색기 (v0.25.0): 모듈을 파일 없이 열면 중앙 영역을 덮는다.
             파일 더블클릭 → 라우팅으로 열리며 자동으로 내려간다. -->
        <Grid x:Name="ExplorerHost" Grid.Row="0" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <!-- Alt 홀드 오버레이 (v0.25.0): 우측 30%에 현재 파일 폴더의 리스트 뷰.
             배경은 약한 틴트 아크릴(A33 — v0.31.0보다 더 투명) — 아래 콘텐츠가 또렷이 비친다.
             Alt 2연타로 고정/해제(v0.32.0, Ctrl 정보 오버레이와 동일 패턴). -->
        <Grid x:Name="AltOverlayRoot" Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Background="{ThemeResource OverlayAcrylicBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="AltListHost" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                    <TextBlock x:Name="AltPinnedText" Grid.Row="1"
                               Text="Pinned — press Alt twice to unpin"
                               Visibility="Collapsed" FontSize="11" Opacity="0.6"
                               Margin="12,4,12,8" />
                </Grid>
            </Border>
        </Grid>

        <!-- Ctrl 홀드 정보 오버레이 (v0.25.0; v0.45.0 Ctrl→Shift, A32에서 Ctrl 회귀 —
             모듈 전환이 숫자 단독 키로 바뀌며 Ctrl이 다시 비었다):
             좌측 30%(A33 — 기존 MinWidth 300~MaxWidth 440 고정형에서 Alt 오버레이와 균등 폭으로)에
             현재 콘텐츠 정보. Ctrl 2연타로 고정/해제. 배경은 약한 틴트 아크릴(A33). -->
        <Grid x:Name="InfoOverlayRoot" Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="InfoOverlay"
                    Background="{ThemeResource OverlayAcrylicBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16" IsHitTestVisible="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="InfoOverlayText" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock x:Name="InfoPinnedText" Text="Pinned — press Ctrl twice to unpin"
                                   Visibility="Collapsed" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 바 (작업표시줄 느낌). 전체화면에서는 코드에서 통째로 숨긴다(v0.21.0) -->
        <Grid x:Name="BottomBar" Grid.Row="1" Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- 현재 모드 칩: 모듈 글리프 + 브랜드명(중립색). 색 구분은 창·트레이 아이콘이 담당(v0.26.0).
                 모듈이 하단 바 줄(ModuleBarHost)을 제공하면 칩은 숨긴다 -->
            <StackPanel x:Name="ModeChip" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <FontIcon x:Name="ModeChipIcon" FontSize="14" />
                <TextBlock x:Name="ModeChipText" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <!-- 모듈 제공 하단 바(동영상 트랜스포트 등) — 메뉴 버튼과 우측 아이콘 사이 (v0.21.0) -->
            <ContentControl x:Name="ModuleBarHost"
                            IsTabStop="False"
                            Margin="52,0,12,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" />

            <Button x:Name="StartButton"
                    Margin="6,0,0,0" Padding="12,6"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Menu">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="StartFlyout" Placement="TopEdgeAlignedLeft">
                        <Flyout.FlyoutPresenterStyle>
                            <!-- A50(v0.92.0): 프레젠터 기본 패딩(좌우 16의 데드존 포함)을 0으로.
                                 Stretch인 항목 버튼이 메뉴 좌우 가장자리까지 닿아,
                                 포인터가 라벨보다 왼쪽에 있어도 항목이 선택된다.
                                 상하 여백은 아래 StackPanel Padding 4가 대신한다. -->
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <!-- 항목은 코드(BuildStartMenu)에서 채운다.
                             폭 124(v0.35.0 사용자 요청 축소): 광고 카드(2:1 이미지가 폭을
                             꽉 채움, v0.43.0)가 이 폭의 기준. -->
                        <StackPanel x:Name="StartMenuPanel" Width="124" Padding="0,4,0,4" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 인스턴스 번호 배지 (A2, v0.58.0): 창이 2개 이상일 때만, 생성 순서 1~9 + 색 구분.
                 메뉴 버튼 우상단에 겹쳐 표시. 값은 WindowManager가 SetInstanceNumber로 준다.
                 제목표시줄 문자열에도 "[n]"으로 함께 표시된다(A56). -->
            <Border x:Name="InstanceBadge"
                    Width="16" Height="16" CornerRadius="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="32,2,0,0"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="InstanceBadgeText"
                           FontSize="10" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
