<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>문서 모듈: 플레인 텍스트 편집·저장(A37, 인코딩 보존) + PDF 뷰어(A16, Windows.Data.Pdf). HWP·오픈오피스는 추후.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <!-- CP949(한글 레거시 텍스트) 디코드용 코드페이지 제공자 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
    <!-- A298: Fit 원본 배율 "1:1" 상자 조립 팩토리(A260 디자인 한 벌). 같은 이유로 소스 링크 공유. -->
    <Compile Include="..\Shared\FitIcons.cs" Link="FitIcons.cs" />
  </ItemGroup>
</Project>
