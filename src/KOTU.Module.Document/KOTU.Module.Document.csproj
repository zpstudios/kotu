<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>문서 모듈: 텍스트 편집·저장, PDF·HWP 5.x 페이지 보기, HWP·HWPX·OpenDocument 본문 미리보기.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <!-- CP949(한글 레거시 텍스트) 디코드용 코드페이지 제공자 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
    <ProjectReference Include="..\KOTU.DocumentModel\KOTU.DocumentModel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
    <!-- A298: Fit 원본 배율 "1:1" 상자 조립 팩토리(A260 디자인 한 벌). 같은 이유로 소스 링크 공유. -->
    <Compile Include="..\Shared\FitIcons.cs" Link="FitIcons.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ToolbarIconGeometry.cs" Link="ToolbarIconGeometry.cs" />
    <Compile Include="..\Shared\ToolbarIcons.cs" Link="ToolbarIcons.cs" />
    <Compile Include="..\Shared\DesignIcons.cs" Link="DesignIcons.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="VirtualEditor\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Licenses\PdfPig-LICENSE.txt" Link="licenses\PdfPig-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Licenses\PdfPig-NOTICES.txt" Link="licenses\PdfPig-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="HwpViewer\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="EditorSource\node_modules\**" />
    <Compile Remove="EditorSource\node_modules\**" />
    <Content Remove="EditorSource\node_modules\**" />
    <EmbeddedResource Remove="EditorSource\node_modules\**" />
  </ItemGroup>
  <Target Name="RestoreHwpRendererContent" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\..\eng\Restore-HwpRenderer.mjs&quot;" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HwpRendererPackage" />
    </Exec>
    <ItemGroup>
      <_HwpEngineSource Include="$(_HwpRendererPackage)\rhwp.js;$(_HwpRendererPackage)\rhwp_bg.wasm;$(_HwpRendererPackage)\LICENSE" />
      <_HwpNoticeSource Include="$(_HwpRendererPackage)\notices\**\*" />
      <Content Include="@(_HwpEngineSource)"
               Link="HwpViewer\engine\%(_HwpEngineSource.Filename)%(_HwpEngineSource.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(_HwpNoticeSource)"
               Link="HwpViewer\engine\notices\%(_HwpNoticeSource.RecursiveDir)%(_HwpNoticeSource.Filename)%(_HwpNoticeSource.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
