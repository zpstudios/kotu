<UserControl
    x:Class="KOTU.Module.Document.DocumentFitControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Width="50" Height="32" Spacing="0">
        <Button x:Name="FitButton" Style="{StaticResource BottomBarFitButtonStyle}"
                IsEnabled="False" Click="Reapply" />
        <DropDownButton x:Name="FitOptionsButton" Style="{StaticResource BottomBarFitOptionsStyle}" IsEnabled="False">
            <DropDownButton.Flyout>
                <MenuFlyout Placement="Top">
                    <MenuFlyoutItem x:Name="OriginalItem" Text="Original" Click="Choose" />
                    <MenuFlyoutItem x:Name="ContainItem" Text="Contain" Click="Choose" />
                    <MenuFlyoutItem x:Name="WidthItem" Text="Fit width" Click="Choose" />
                    <MenuFlyoutItem x:Name="HeightItem" Text="Fit height" Click="Choose" />
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>
