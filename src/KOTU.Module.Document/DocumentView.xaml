<UserControl
    x:Class="KOTU.Module.Document.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Ctrl+S 저장 (A37). 전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 —
         전체화면은 셸의 3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다
         (편집 중 Enter는 줄바꿈이 우선이라 순환하지 않고, Alt+Enter·Esc가 진입·탈출로다).
         버튼에 걸린 단독 문자 키(A 100% · F Fit)는 A34에서 코드(SetupHotkeys)에 있다 —
         에디터(TextBox)에 포커스가 있으면 통과시켜야 해서 공용 통과 규칙을 거친다.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- A37: 뷰어 → 에디터 승격. TextBox 하나가 표시·편집을 겸한다.
             A80(v0.91.0): 구 "MaxWidth 900 + HorizontalAlignment Left"(v0.44.0 뷰어 유래)를
             제거 — 900px보다 넓은 창에서 포커스된 TextBox 배경이 좌측 900px에만 그려져
             우측이 검게 비어 보였다(오버레이와 무관). 그 뒤로 본문이 창 전체 폭을 썼다.
             A120(v0.146.0): 본문 컬럼을 중앙으로 되돌린다 — 더하는 것은 MaxWidth 900 하나뿐이고
             HorizontalAlignment는 기본값 Stretch를 그대로 둔다. 레이아웃 규약상 Stretch는 슬롯보다
             좁게 제약되면 남는 폭을 좌우로 균등 배분한다(Stretch의 constrained fallback = 중앙 배치).
             HorizontalAlignment="Center"를 명시하면 배치 폭이 콘텐츠 폭으로 접혀 900 컬럼 자체가
             무너지므로 절대 쓰지 않는다.
             A80이 걷어낸 것과 이번 것은 별개다: 그때 문제는 "MaxWidth 900 + Left"의 비대칭
             (여백이 우측에만 몰려 포커스 배경이 한쪽만 빈 것)이었고, 이번은 Stretch+MaxWidth라
             여백이 좌우 대칭이다. 900 이하 폭 창은 제약이 걸리지 않아 현행과 픽셀 동일하다.
             아래 DecorLayer에도 같은 MaxWidth 900이 걸려 있어야 A115 장식 좌표계가 맞는다 —
             둘은 반드시 함께 바꿀 것.
             A171(v0.173.0): 아래 MaxWidth 900은 이제 기본값일 뿐이고 실값은 코드가 설정에서 정한다
             (DocumentView.ApplyEditorMaxWidth — 설정 키 document.editorMaxWidth, 0 = 제한 없음).
             그래도 지우지 않는다: 코드가 못 도는 경로(디자이너 · 생성 실패)에서도 현행 모양이 남고,
             기본값 이원화를 막으려고 DocumentModule.DefaultEditorMaxWidth와 같은 값을 유지한다.
             4MB 초과 잘림 표시 파일은 IsReadOnly로 두어 잘린 채 저장되는 사고를 막는다. -->
        <!-- A152: 아래 패딩 68 = 종전 24 + 셸 하단 바 두께 44. 셸이 행 분할을 없애고 바를
             콘텐츠 위 오버레이로 바꿔(중앙 출렁임 제거) 모드1에서는 콘텐츠 하단 44px가 바에
             덮인다 — 스크롤 끝의 마지막 줄·캐럿이 바 뒤에 숨지 않게 스크롤 끝 여백으로 보정한다.
             모드 불변 상수다(모드2/3에서는 스크롤 끝 여분 공간일 뿐) — 모듈이 셸 모드를 알게
             하지 않는다. EditorDecor는 _editor.Padding을 실시간으로 읽으므로 별도 수정 불요. -->
        <!-- A142 ②: FontFamily = Consolas(고정폭, Windows 동봉 폰트라 폴백 걱정 없음).
             TextBox에는 LineHeight·LineStackingStrategy가 없어(TextBlock 전용) 줄 간격을
             속성으로 강제할 수 없다는 A115 조사 판정을 재확인한다 — 고정폭 폰트로 글리프 셀을
             균일화하는 것이 현재 가능한 대응이다. 한글처럼 Consolas에 없는 글자는 시스템 폴백
             글꼴로 그려져 그 줄만 높이가 달라질 수 있으나, 장식(A115)은 줄마다 실측(rect)이라
             정합은 깨지지 않는다. 컨트롤 교체(RichEditBox)는 하지 않는다 — 캐럿 색 한계가
             동일해(A115 ④ 판정) 회귀 위험만 크다. -->
        <TextBox
            x:Name="EditorBox"
            Padding="24,16,24,68"
            MaxWidth="900"
            VerticalAlignment="Stretch"
            FontSize="14"
            FontFamily="Consolas"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Visibility="Collapsed"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="OnEditorTextChanged"
            KeyDown="OnEditorKeyDown" />

        <!-- A115: 장식 레이어(라인 가이드·¶·EOF) — EditorBox 위(z)에 겹치되 IsHitTestVisible=False로
             입력 불간섭. 그리기는 EditorDecor(코드)가 전담한다. 포커스된 TextBox는 템플릿 Focused
             상태가 불투명 배경을 그려(A80 참고) 아래(z) 레이어는 가려진다 — 그래서 위에 얹고
             아주 옅게 긋는다(색·불투명도 상수는 EditorDecor 상단 한 곳).
             A120(v0.146.0): MaxWidth 900 = 위 EditorBox와 같은 값(같은 이유로 Center는 명시하지
             않는다 — Stretch+MaxWidth의 중앙 배치를 그대로 받는다). EditorDecor는
             GetRectFromCharacterIndex가 주는 EditorBox 로컬 좌표를 이 Canvas 로컬에 그대로 찍으므로,
             두 요소의 레이아웃 제약(정렬·최대 폭)이 같아야 원점이 겹친다. 한쪽만 바꾸면 장식이
             본문에서 통째로 어긋난다 — 그리기 산술에 오프셋 보정을 넣지 말고 이 값을 맞출 것.
             A171(v0.173.0): 위 EditorBox와 마찬가지로 여기 900도 기본값이고 실값은 코드가 설정에서
             정한다 — 두 요소에 같은 값을 넣는 지점은 ApplyEditorMaxWidth() 한 곳뿐이다.
             A142 ③: 행 번호 거터도 이 Canvas가 그린다 — 본문 컬럼 왼쪽 여백(캔버스 음수 x)에
             얹힐 뿐 레이아웃(MaxWidth·정렬)은 그대로라 위 계약은 무변경이다. 여백이 거터 폭만큼
             안 나오는 좁은 창에서는 EditorDecor가 거터를 통째로 숨긴다(본문을 덮지 않는다). -->
        <Canvas x:Name="DecorLayer" MaxWidth="900" IsHitTestVisible="False" />

        <!-- PDF 페이지 뷰(A16, PdfPane)는 코드에서 지연 생성해 RootGrid 맨 아래(z 순서상 뒤)에 꽂는다 -->
        <TextBlock
            x:Name="PlaceholderText"
            Text="Open a text, Markdown, or PDF file, or drop one onto the window&#x0A;Plain text files can be edited and saved here (Ctrl+S)"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6" />

        <!-- 하단 상태바: 저장 · 파일명 · 수정됨 · 페이지 · 드라이브 · Fit.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(이미지 v0.27.0과 동일 패턴).
             열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
             1:1 버튼 칸은 A111에서 제거 — 100%가 Fit 플라이아웃 4옵션에 들어갔다.
             전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다. -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Padding="0,2,0,2">
            <!-- ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- 파일명(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- 저장 버튼(A37): 편집 가능한 텍스트가 열려 있고 변경이 있을 때만 활성 -->
                <Button x:Name="SaveButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnSaveButtonClick"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <TextBlock x:Name="FileNameText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="No file open" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 문서가 있는 드라이브" 텍스트를 대체한다 —
                     파일명 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="1"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- 수정됨 표시(A37) — 창 제목의 ●는 셸이 UnsavedChanged로 단다 -->
                <TextBlock x:Name="ModifiedText" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed"
                           Text="● Unsaved" />
                <!-- PDF 현재 페이지/전체 (A16) — PDF가 열려 있을 때만 -->
                <TextBlock x:Name="PageInfoText" Grid.Column="3" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed" />
                <!-- A49: PDF 전용 상태형 Fit(2칸, A30 규격) — 텍스트 에디터 모드(A37)에서는 숨김.
                     Fit 본체 = 마지막 옵션 표시·클릭 시 재적용, 화살표 = A83 4옵션. 내용·툴팁은
                     UpdateFitButton()이 갱신하므로 아래 FontIcon은 초기값(Contain)일 뿐이다.
                     A111(v0.133.0): 1:1 별도 버튼 제거(100%가 플라이아웃 옵션이 됐다) · 구 Auto-fit = 새 Contain.
                     SplitButton은 WinUI가 키 있는 기본 스타일을 노출하지 않아(BasedOn 대상 없음)
                     전역 스타일 대신 2칸 값(84×32)을 그대로 적는다 — A27(v0.107.0),
                     높이는 A97(v0.116.0)에서 40→36, A106(v0.132.0)에서 36→32. 폭 84는 유지. -->
                <!-- 툴팁(키 표기 포함)은 UpdateFitButton()이 상태와 함께 갱신한다 — A34 -->
                <SplitButton x:Name="FitButton" Grid.Column="4" Width="84" Height="32"
                             VerticalAlignment="Center" CornerRadius="4"
                             Visibility="Collapsed" Click="OnFitClicked">
                    <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <!-- A143/v0.174.1: 100% 아이콘 = 인라인 path 문자열(Geometry 타입 속성의
                                 문자열 변환은 파싱마다 새 인스턴스를 만든다). 종전 App.xaml 공유
                                 PathGeometry StaticResource는 런타임 XamlParseException으로 앱을 죽였다
                                 (WinUI Geometry는 부모 1개뿐 — 공유 불가. CI는 컴파일만 하므로 못 잡는다).
                                 좌표 정본 = 이 문자열 + 코드 비하인드 BuildActualSizeIconGeometry().
                                 모양 수정 시 세 모듈(이미지·문서·영상) × 2곳 = 6곳을 함께 고칠 것.
                                 형제는 Segoe 글리프, 여기만 PathIcon(A111 판정 — 맞는 글리프가 없다). -->
                            <MenuFlyoutItem Text="100%" Click="OnFitActualSizeClicked">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon Data="M 2.3,5 L 4.2,3 5,3 5,11.4 3.5,11.4 3.5,5 Z M 1.8,11.4 L 6.7,11.4 6.7,13 1.8,13 Z M 7.4,6 L 8.8,6 8.8,7.4 7.4,7.4 Z M 7.4,9.6 L 8.8,9.6 8.8,11 7.4,11 Z M 10.5,5 L 12.4,3 13.2,3 13.2,11.4 11.7,11.4 11.7,5 Z M 10,11.4 L 14.9,11.4 14.9,13 10,13 Z" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Contain" Click="OnFitContainClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE9A6;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
