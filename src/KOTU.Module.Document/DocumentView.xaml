<UserControl
    x:Class="KOTU.Module.Document.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Ctrl+S 저장 (A37). 전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 —
         전체화면은 셸의 3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다
         (편집 중 Enter는 줄바꿈이 우선이라 순환하지 않고, Alt+Enter·Esc가 진입·탈출로다).
         버튼에 걸린 단독 문자 키(A 100% · F Fit)는 A34에서 코드(SetupHotkeys)에 있다 —
         에디터(TextBox)에 포커스가 있으면 통과시켜야 해서 공용 통과 규칙을 거친다.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         A246: Ctrl+±·Ctrl+넘패드 * 문서 줌 액셀러레이터는 코드 등록(SetupZoomAccelerators) —
         (VirtualKey)187/189 캐스트 키는 XAML로 표기할 수 없다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>

    <!-- A262: Background=Transparent는 폴백 휠 배선(OnRootWheelFallback)의 히트테스트 성립
         조건이다 — 배경 null인 Grid는 자기 영역이 히트테스트에 안 잡혀, 자식이 없는 여백에서
         PointerWheelChanged가 아예 발생하지 않는다. 지우면 여백 데드존이 되살아난다. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- A37: 뷰어 → 에디터 승격. TextBox 하나가 표시·편집을 겸한다.
             A80(v0.91.0): 구 "MaxWidth 900 + HorizontalAlignment Left"(v0.44.0 뷰어 유래)를
             제거 — 900px보다 넓은 창에서 포커스된 TextBox 배경이 좌측 900px에만 그려져
             우측이 검게 비어 보였다(오버레이와 무관). 그 뒤로 본문이 창 전체 폭을 썼다.
             A181(v0.192.0): A120(v0.146.0)의 MaxWidth 900 중앙 컬럼과 A171(v0.173.0)의 폭 설정
             (document.editorMaxWidth)을 함께 폐지 — 본문은 다시 창 전체 폭을 쓰고(A80 이후
             v0.146.0 전까지 출하됐던 상태와 동일), 크기 조절은 줌(Ctrl+휠, FontSize 배율 —
             DocumentView.ApplyZoom)이 대신한다. HorizontalAlignment는 계속 기본값 Stretch —
             Center는 배치 폭을 콘텐츠 폭으로 접고(A120 판정) Left는 우측 검은 띠를 되살린다(A80).
             아래 DecorLayer와 레이아웃 제약(정렬·폭 제한 없음)이 같아야 A115 장식 좌표계가
             맞는다 — 한쪽에만 제약을 더하지 말 것.
             4MB 초과 잘림 표시 파일은 IsReadOnly로 두어 잘린 채 저장되는 사고를 막는다. -->
        <!-- A152: 아래 패딩 68 = 종전 24 + 셸 하단 바 두께 44. 셸이 행 분할을 없애고 바를
             콘텐츠 위 오버레이로 바꿔(중앙 출렁임 제거) 모드1에서는 콘텐츠 하단 44px가 바에
             덮인다 — 스크롤 끝의 마지막 줄·캐럿이 바 뒤에 숨지 않게 스크롤 끝 여백으로 보정한다.
             모드 불변 상수다(모드2/3에서는 스크롤 끝 여분 공간일 뿐) — 모듈이 셸 모드를 알게
             하지 않는다. EditorDecor는 _editor.Padding을 실시간으로 읽으므로 별도 수정 불요.
             A181: 왼쪽 패딩 24는 기본값이다 — 파일을 열면 코드가 행 번호 거터(A142 ③) 폭만큼
             더한 값으로 덮어쓴다(DocumentView.UpdateEditorPadding — 폭 제한 폐지로 컬럼 좌측
             여백이 사라져 거터가 본문 패딩 안쪽으로 들어왔다). FontSize 14도 기본값이다 —
             코드가 줌 배율을 곱해 덮어쓴다(기본 100% = 14, DocumentView.BaseEditorFontSize와
             반드시 같은 값). -->
        <!-- A142 ②: FontFamily = Consolas(고정폭, Windows 동봉 폰트라 폴백 걱정 없음).
             TextBox에는 LineHeight·LineStackingStrategy가 없어(TextBlock 전용) 줄 간격을
             속성으로 강제할 수 없다는 A115 조사 판정을 재확인한다 — 고정폭 폰트로 글리프 셀을
             균일화하는 것이 현재 가능한 대응이다. 한글처럼 Consolas에 없는 글자는 시스템 폴백
             글꼴로 그려져 그 줄만 높이가 달라질 수 있으나, 장식(A115)은 줄마다 실측(rect)이라
             정합은 깨지지 않는다. 컨트롤 교체(RichEditBox)는 하지 않는다 — 캐럿 색 한계가
             동일해(A115 ④ 판정) 회귀 위험만 크다.
             A277(v0.265.0): 그 판정("캐럿을 숨기거나 칠하는 공개 API가 없다")이 잠금 뷰의
             캐럿 처리도 규정한다 — 유일한 수단은 포커스다. 잠금 뷰 진입 시 뷰 루트로 포커스를
             옮겨(EnterViewMode) 자동 에디터 포커스를 피한다. A409: 네이티브 선택·복사를 위해
             IsTabStop은 유지한다(UpdateEditorReadOnly). 명시적 클릭·Tab 진입과 캐럿 탐색은 허용한다. -->
        <TextBox
            x:Name="EditorBox"
            Padding="24,16,24,68"
            VerticalAlignment="Stretch"
            FontSize="14"
            FontFamily="Consolas"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            Background="{ThemeResource TextControlBackground}"
            Foreground="{ThemeResource TextControlForeground}"
            SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}"
            BorderThickness="0"
            CornerRadius="0"
            Visibility="Collapsed"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="OnEditorTextChanged"
            TextChanging="OnSearchEditorTextChanging"
            SelectionChanged="OnEditorSelectionChanged"
            KeyDown="OnEditorKeyDown">
            <TextBox.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="White" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="White" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="TextControlBackground" Color="White" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="White" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="Black" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Black" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Black" />
                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="Black" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource SystemColorButtonTextColor}" />
                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TextBox.Resources>
        </TextBox>

        <!-- A115: 장식 레이어(라인 가이드·¶·EOF) — EditorBox 위(z)에 겹치되 IsHitTestVisible=False로
             입력 불간섭. 그리기는 EditorDecor(코드)가 전담한다. A413: 일반 테마의 Editing 배경은
             검정, Viewing은 기존 테마 바탕이다. 고대비의 시스템 배경에도 보이도록 장식을 위에 얹고
             아주 옅게 긋는다(색·불투명도 상수는 EditorDecor 상단 한 곳).
             EditorDecor는 GetRectFromCharacterIndex가 주는 EditorBox 로컬 좌표를 이 Canvas 로컬에
             그대로 찍으므로, 두 요소의 레이아웃 제약(정렬·폭 제한)이 같아야 원점이 겹친다. 한쪽만
             바꾸면 장식이 본문에서 통째로 어긋난다 — 그리기 산술에 오프셋 보정을 넣지 말 것.
             A181(v0.192.0): A120/A171의 MaxWidth 900(설정 폭)을 위 EditorBox와 함께 폐지 — 이제
             두 요소 다 제약 없는 Stretch로 창 전체 폭을 쓴다(계약은 "같은 제약"이지 특정 값이
             아니다 — 무제한끼리도 원점은 겹친다).
             A142 ③: 행 번호 거터도 이 Canvas가 그린다 — 레이아웃(정렬·폭)은 일절 건드리지 않으므로
             위 계약은 무변경이다. A181: 폭 제한 폐지로 컬럼 왼쪽 여백(캔버스 음수 x)이 사라져,
             거터는 코드가 EditorBox 왼쪽 패딩에 예약해 둔 자리(DocumentView.UpdateEditorPadding)에
             그려진다. 예약보다 자릿수가 더 커지는 등 자리가 안 나오면 EditorDecor가 거터를 통째로
             숨긴다(본문을 덮지 않는다 — 종전과 같은 폴백). -->
        <Canvas x:Name="DecorLayer" IsHitTestVisible="False" />

        <!-- A190: 마크다운 렌더 뷰 — .md/.markdown이 열리면 기본으로 이 판이 보이고(에디터는
             Collapsed) 하단 바 토글로 편집과 오간다. 내용은 코드(MarkdownRenderer)가 파싱 모델
             (워커 — A42)로부터 조립해 RenderStack에 쌓는다. 패딩은 EditorBox와 같은 값 —
             특히 아래 68은 A152(하단 바 44 오버레이) 스크롤 끝 보정의 복제다.
             대용량(A177 임계 초과)·4MB 잘림 md는 렌더를 생략하고 에디터만 쓴다(A178 성능 원칙).
             장식(DecorLayer)은 에디터 전용이라 이 판 위에는 아무것도 그리지 않는다
             (EditorDecor.RenderCore의 에디터 Visibility 게이트가 걷어 준다).
             A225: 렌더 뷰 줌 — 편집 모드와 같은 축(_zoomPercent)을 ScrollViewer ZoomFactor로
             적용한다(PdfPane·ImageViewerView의 ZoomMode 선례). 랩 폭은 코드가 RenderStack.Width를
             "뷰포트 폭 나누기 배율"로 보정한다(ApplyRenderZoom — PdfPane EnsureContentMinWidth의
             A188 역수 폭 관용구. ZoomMode가 켜지면 콘텐츠 측정 제약이 무한이 되므로 명시 폭이
             랩의 유일한 기준이다). Min=Max 핀 고정은 핀치·내장 줌이 10% 단계 축 밖의 배율을
             만들지 못하게 하는 잠금 — 배율 변경은 ApplyRenderZoom의 ChangeView 한 곳뿐이다. -->
        <ScrollViewer x:Name="RenderPane" Visibility="Collapsed" IsTabStop="True"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="1">
            <StackPanel x:Name="RenderStack" Padding="24,16,24,68" />
        </ScrollViewer>

        <!-- PDF 페이지 뷰(A16, PdfPane)는 코드에서 지연 생성해 RootGrid 맨 아래(z 순서상 뒤)에 꽂는다 -->
        <TextBlock
            x:Name="PlaceholderText"
            Text="Open a text, Markdown, HTML, or PDF file, or drop one onto the window&#x0A;Plain text files can be edited and saved here (Ctrl+S)"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6" />

        <!-- A343 ⓑ: 보기 전용 안내판(편집기 대입 상한 초과 — 앞 1MB분만 담겼다).
             에디터 위에 겹치는 상단 오버레이다: 코드가 EditorBox의 위쪽 패딩에 이 높이만큼
             자리를 예약하므로(DocumentView.UpdateEditorPadding — 왼쪽 거터 예약과 같은 관용구)
             첫 줄을 가리지 않는다. ⚠ Height 28은 코드 상수 CappedNoticeHeight와 반드시 같은
             값이다(예약이 실측이 아니라 그 상수를 쓴다 — 첫 레이아웃 전 실측은 0이다).
             문구는 코드가 넣는다(글자 수를 상수에서 뽑는다 — 생성자 한 줄).
             배경은 불투명이어야 아래(z) 에디터 글자가 비치지 않는다 — 브러시 2종은
             저장소 선례 그대로(MainWindow.xaml:65 · ExplorerPane.xaml:86).
             표시 전환·문구 대입은 코드 UpdateCappedNotice 한 곳이고, 초기값 Collapsed가 첫
             프레임(빈 화면) 상태다. 4MB 잘림 문서도 앞 1,048,576자만 담기므로 이 판이 뜨고,
             문구만 "4MB 초과" 갈래로 갈린다 — 그때는 본문 끝의 종전 잘림 안내 줄이 붙지 않는다
             (안내 중복 금지 · IsCappedNoticeVisible). -->
        <Border x:Name="CappedNoticeBar" VerticalAlignment="Top" Height="28"
                Padding="24,0,24,0" Visibility="Collapsed"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="CappedNoticeText" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 하단 상태바(A340/A362 현행): 새 파일(A189) · 저장 · 현재 편집 상태(A340) ·
             편집/뷰 동작(A190) · 파일명(star) · 수정됨 · [A215 표시 토글 2종] · 페이지 ·
             줌(A181) · 인쇄(A211) · Fit.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(이미지 v0.27.0과 동일 패턴).
             열기 버튼 칸은 A99에서 제거 → A223에서 문서 바에 한해 부활 → **A256에서 다시 제거**
             (2026-08-27 사용자 확정 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. 그 위임 계약
             IOpenFileRequestSource도 소비처가 사라져 함께 폐기됐다. 열려 있던 문서의 미저장
             가드(A37)는 종전대로 셸 OpenFile 경로가 갖고 있어 셸 버튼 경유에도 그대로 작동한다).
             1:1 버튼 칸은 A111에서 제거 — 100%가 Fit 플라이아웃 4옵션에 들어갔다.
             전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.
             A245: A215의 star 2개 구조(좌 파일명 star + 우 스페이서 star 사이에 표시 토글)를
             star 1개로 환원 — 표시 토글이 가운데를 떠나 우측 정렬군(줌·페이지 뒤, Fit 앞)으로
             옮겼기 때문이다. 남은 star 하나(파일명 칸)가 좌측군과 우측군 사이의 남는 폭을
             전부 흡수한다. A340 전에는 폭 임계 축약 로직이 없었고, 지금은 편집 상태 라벨만
             620 DIP 아래에서 먼저 접힌다.
             A340은 A362 이후의 10칸 구조에 상태 칸을 하나 더해 뒤 열을 모두 재계수했다.
             A396 현행은 12칸(c0~c11)·star 1개(c4)이며, c6의 검색창은 항상 남는다.
             좁은 폭에서는 가이드·페이지·줌을 More tools로 옮기고 Print/Fit은 직접 유지한다. -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Padding="0,2,0,2">
            <!-- A364: 간격은 표시된 요소의 왼쪽 Margin 6이 소유한다.
                 Collapsed Auto 열은 여백까지 사라지며, Zoom/Print/Fit 실제 폭은 84/32/64다.
                 아래 이력의 상시 비활성 표시는 현재 UpdateToolbarPresentation의 콘텐츠별 표시가 대체한다. -->
            <Grid x:Name="StatusBarGrid" ColumnSpacing="0" SizeChanged="OnStatusBarSizeChanged">
                <Grid.ColumnDefinitions>
                    <!-- A340/A362: New / Save / 현재 편집 상태 / View 동작, 가변 정보,
                         변경/가이드/페이지, Zoom84 / Print32 / Fit70. 상태 라벨은 좁은 폭에서 먼저 접힌다. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- A189 → A247 → A267: 새 텍스트 문서(무제) 시작. 상시 활성(A189의 "빈 상태에서만
                     활성" 반전 — 구 판정 UpdateNewFileButton은 제거, IsEnabled는 XAML 기본값
                     true 그대로. A267도 이 축은 유지). 클릭 2분기는 OnNewFileClick이 가른다 —
                     빈 상태면 이 자리에서 개시, 콘텐츠 위(파일·PDF·무제)면 미저장 여부와
                     무관하게 새 창(A247의 미저장 4선택지 다이얼로그는 A267에서 폐기).
                     빈 상태의 중앙은 셸 썸네일 탐색기(A93)가 차지해 이 뷰의 안내 문구가 안 보이므로
                     진입점은 안내 링크가 아니라 하단 바 버튼이다. 글리프 E7C3 = 문서(빈 파일) —
                     탐색기 파일 타일과 같은 글리프. 핫키 없음(A34 등록 없음 — 툴팁 고정값). -->
                <!-- A256(2026-08-27): Open 버튼 칸 제거 — 셸 S4 'Open file'(A90)과의 병존을
                     해소하고 셸 버튼으로 일원화했다(A223 부분 반전). 위임 계약
                     IOpenFileRequestSource·클릭 핸들러·All Readable 중계도 함께 폐기. -->
                <Button x:Name="NewFileButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnNewFileClick"
                        ToolTipService.ToolTip="New text file">
                    <FontIcon Glyph="&#xE7C3;" FontSize="18" />
                </Button>
                <!-- 저장 버튼(A37): 편집 가능한 텍스트가 열려 있고 변경이 있을 때만 활성 -->
                <Button x:Name="SaveButton" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnSaveButtonClick"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="18" />
                </Button>
                <!-- A211 배치 3(v0.222.0) → A223 → A245: 인쇄 — 규격 정본은 셸 인쇄 절 주석
                     (MainWindow.xaml.cs, 부록 B 78 확정): 1칸(32×32) 버튼 · 툴팁 "Print (Ctrl+P)" ·
                     A34 문자 핫키는 배정하지 않는다(Ctrl+P 셸 액셀러레이터가 유일한 키) · 활성
                     조건 = CanPrintNow. IsEnabled="False"는 "파일 없음"으로 시작하는 초기값일 뿐,
                     이후 값의 단일 출처는 코드의 UpdatePrintButton()이다. 클릭 = PrintRequested
                     발화 한 줄. A223(2026-08-24)에서 우측 끝(구 c8) → 좌측군, A245(2026-08-27)에서
                     편집/뷰 토글 앞으로 이동했다가 A362에서 다시 우측군(c8)으로 갔다.
                     A340의 상태 칸 추가로 현행은 c9다. -->
                <Button x:Name="PrintButton" Grid.Column="10" Margin="6,0,0,0" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnPrintButtonClick"
                        ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" FontSize="18" />
                </Button>
                <!-- A340: 현재 모드는 글자, 버튼은 누르면 갈 동작으로 축을 분리한다. 이 라벨은
                     표시 전용이고 UpdateViewToggle의 _viewMode 한 값에서 버튼 얼굴과 함께 정한다.
                     좁은 폭에서는 버튼보다 먼저 접힌다(UpdateViewModeLabelVisibility). -->
                <TextBlock x:Name="ViewModeText" Grid.Column="2" Margin="6,0,0,0"
                           VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                           Text="Editing" Visibility="Collapsed" />
                <!-- A190 → A224 → A340: 편집 ↔ 뷰 토글(전 텍스트 형식). 텍스트 편집 대상(파일·무제)이
                     있고 잘림이 아니면 활성 — A145 "항상 보이되 비활성" 관용구(판정·글리프·툴팁은
                     UpdateViewToggle). 뷰 모드의 실체는 형식이 정한다: md 렌더 자격이면 렌더 판
                     (A190 그대로), 그 외 텍스트는 잠금 뷰(에디터 그대로 + IsReadOnly). PDF·빈
                     화면·4MB 잘림은 비활성(잘림은 토글이 "편집으로 전환"을 약속하면 안 된다).
                     글리프와 툴팁은 누르면 갈 동작: 편집 중 E890(Switch to view mode) /
                     뷰 중 E70F(Switch to edit mode). 현재 상태는 바로 왼쪽 라벨이 명시한다.
                     핫키 없음(A34 등록 없음 — New 버튼과 같은 부류, 초기 툴팁은 고정값).
                     A245: 좌측군 끝(인쇄 뒤)으로 이동 — 칸만 바뀌고 판정·글리프는 무변경. -->
                <Button x:Name="ViewToggleButton" Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnViewToggleClick"
                        ToolTipService.ToolTip="Switch to view mode">
                    <FontIcon x:Name="ViewToggleIcon" Glyph="&#xE890;" FontSize="18" />
                </Button>
                <TextBlock x:Name="FileNameText" Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="No file open" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 문서가 있는 드라이브" 텍스트를 대체한다 —
                     파일명 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다.
                     A245: star가 하나로 환원돼 스팬이 필요 없어졌다 — 구 c5~c7 스팬은 그 사이에
                     끼어 있던 표시 토글 칸과 우측 스페이서 star를 되찾기 위한 보정이었고, 지금은
                     이 칸 자체가 남는 폭을 전부 먹는 유일한 star다(우측군은 전부 Auto). -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="4" Margin="6,0,0,0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- 수정됨 표시(A37 → A266) — 미저장 시에만 "N changed"(N = 변경 구간별
                     max(제거 폭, 삽입 폭)의 합 — 문자열은 코드(UpdateChangedText)가 편집마다
                     채우므로 여기 Text는 없다). 창 제목의 ●는 셸이 UnsavedChanged로 다는
                     별개 축(A136)이라 이번 개편과 무관하게 그대로다. -->
                <TextBlock x:Name="ModifiedText" Grid.Column="5" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed" MaxWidth="90" TextTrimming="CharacterEllipsis" />
                <!-- A396: The keyword field stays visible even when the change count is hidden. -->
                <StackPanel x:Name="SearchPanel" Grid.Column="6" Margin="6,0,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBox x:Name="FindBox" Width="180" Height="32" MinHeight="32" Padding="8,4"
                             PlaceholderText="Find text" IsEnabled="False" IsSpellCheckEnabled="False"
                             AutomationProperties.Name="Find text" ToolTipService.ToolTip="Find text (Ctrl+F)"
                             TextChanged="OnFindTextChanged" />
                    <StackPanel x:Name="InlineFindNavigation" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="FindCountText" MinWidth="48" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed" />
                        <Button x:Name="FindPreviousButton" Style="{StaticResource BottomBarButtonStyle}" IsEnabled="False"
                                Click="OnFindPreviousClick" AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match (Shift+F3)">
                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                        </Button>
                        <Button x:Name="FindNextButton" Style="{StaticResource BottomBarButtonStyle}" IsEnabled="False"
                                Click="OnFindNextClick" AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match (F3)">
                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="FindOptionsButton" Style="{StaticResource BottomBarButtonStyle}" IsEnabled="False"
                            AutomationProperties.Name="Find and replace options" ToolTipService.ToolTip="Find and replace (Ctrl+H)">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout x:Name="FindFlyout" Placement="Top" Opened="OnFindFlyoutOpened"
                                    Closing="OnFindFlyoutClosing" Closed="OnFindFlyoutClosed">
                                <StackPanel x:Name="FindOptionsPanel" Width="280" Spacing="8" PreviewKeyDown="OnFindPanelKeyDown">
                                    <TextBlock x:Name="FindDetailText" Text="Literal, ignore case" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="PopupPreviousButton" Content="Previous" Click="OnFindPreviousClick" IsEnabled="False" />
                                        <Button x:Name="PopupNextButton" Content="Next" Click="OnFindNextClick" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBox x:Name="ReplaceBox" PlaceholderText="Replace with" AutomationProperties.Name="Replace with"
                                             IsSpellCheckEnabled="False" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="ReplaceCurrentButton" Content="Replace" Click="OnReplaceCurrentClick" IsEnabled="False" />
                                        <Button x:Name="ReplaceAllButton" Content="Replace all" Click="OnReplaceAllClick" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="ReplaceStatusText" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <ContentControl x:Name="SearchToolsInlineHost" Grid.Column="7" Grid.ColumnSpan="3" VerticalAlignment="Center" IsTabStop="False" />
                <Button x:Name="SearchMoreToolsButton" Grid.Column="7" Grid.ColumnSpan="3" Margin="6,0,0,0"
                        Style="{StaticResource BottomBarButtonStyle}" Visibility="Collapsed"
                        AutomationProperties.Name="More document tools" ToolTipService.ToolTip="More document tools">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="SearchToolsFlyout" Placement="Top">
                            <ContentControl x:Name="SearchToolsPopupHost" IsTabStop="False" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- A215(2026-08-24) → A245(2026-08-27) → A264/A265(2026-08-28): 편집 모드 표시
                     토글 2종 — ① 라인 가이드(줄 상/하단 선 — A115 ①) ② 펑츄에이션 마커(¶·EOF —
                     A115 ②). A215의 자리는 좌우 star 사이(바 가운데)였고, A245에서 우측 정렬군으로,
                     A264에서 그 안의 배율·페이지 **앞**으로 옮겼다(사용자 확정 순서 "언세이브드 →
                     라인 가이드 → ¶ → 배율 → Fit").
                     ⚠️ A265(v0.262.0): A249 확정 예외 4종 중 이 1종을 **공식 해제**했다
                     (2026-08-27 사용자 답변 — "무조건 버튼들 다 보이게·사용 못하면 비활성"의
