<UserControl
    x:Class="KOTU.Module.Document.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- Ctrl+S 저장 (A37). 전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 —
         전체화면은 셸의 3단 모드 체계(Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다
         (편집 중 Enter는 줄바꿈이 우선이라 순환하지 않고, Alt+Enter·Esc가 진입·탈출로다).
         버튼에 걸린 단독 문자 키(A 100% · F Fit)는 A34에서 코드(SetupHotkeys)에 있다 —
         에디터(TextBox)에 포커스가 있으면 통과시켜야 해서 공용 통과 규칙을 거친다.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         A246: Ctrl+±·Ctrl+넘패드 * 문서 줌 액셀러레이터는 코드 등록(SetupZoomAccelerators) —
         (VirtualKey)187/189 캐스트 키는 XAML로 표기할 수 없다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>

    <!-- A262: Background=Transparent는 폴백 휠 배선(OnRootWheelFallback)의 히트테스트 성립
         조건이다 — 배경 null인 Grid는 자기 영역이 히트테스트에 안 잡혀, 자식이 없는 여백에서
         PointerWheelChanged가 아예 발생하지 않는다. 지우면 여백 데드존이 되살아난다. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- A37: 뷰어 → 에디터 승격. TextBox 하나가 표시·편집을 겸한다.
             A80(v0.91.0): 구 "MaxWidth 900 + HorizontalAlignment Left"(v0.44.0 뷰어 유래)를
             제거 — 900px보다 넓은 창에서 포커스된 TextBox 배경이 좌측 900px에만 그려져
             우측이 검게 비어 보였다(오버레이와 무관). 그 뒤로 본문이 창 전체 폭을 썼다.
             A181(v0.192.0): A120(v0.146.0)의 MaxWidth 900 중앙 컬럼과 A171(v0.173.0)의 폭 설정
             (document.editorMaxWidth)을 함께 폐지 — 본문은 다시 창 전체 폭을 쓰고(A80 이후
             v0.146.0 전까지 출하됐던 상태와 동일), 크기 조절은 줌(Ctrl+휠, FontSize 배율 —
             DocumentView.ApplyZoom)이 대신한다. HorizontalAlignment는 계속 기본값 Stretch —
             Center는 배치 폭을 콘텐츠 폭으로 접고(A120 판정) Left는 우측 검은 띠를 되살린다(A80).
             아래 DecorLayer와 레이아웃 제약(정렬·폭 제한 없음)이 같아야 A115 장식 좌표계가
             맞는다 — 한쪽에만 제약을 더하지 말 것.
             4MB 초과 잘림 표시 파일은 IsReadOnly로 두어 잘린 채 저장되는 사고를 막는다. -->
        <!-- A152: 아래 패딩 68 = 종전 24 + 셸 하단 바 두께 44. 셸이 행 분할을 없애고 바를
             콘텐츠 위 오버레이로 바꿔(중앙 출렁임 제거) 모드1에서는 콘텐츠 하단 44px가 바에
             덮인다 — 스크롤 끝의 마지막 줄·캐럿이 바 뒤에 숨지 않게 스크롤 끝 여백으로 보정한다.
             모드 불변 상수다(모드2/3에서는 스크롤 끝 여분 공간일 뿐) — 모듈이 셸 모드를 알게
             하지 않는다. EditorDecor는 _editor.Padding을 실시간으로 읽으므로 별도 수정 불요.
             A181: 왼쪽 패딩 24는 기본값이다 — 파일을 열면 코드가 행 번호 거터(A142 ③) 폭만큼
             더한 값으로 덮어쓴다(DocumentView.UpdateEditorPadding — 폭 제한 폐지로 컬럼 좌측
             여백이 사라져 거터가 본문 패딩 안쪽으로 들어왔다). FontSize 14도 기본값이다 —
             코드가 줌 배율을 곱해 덮어쓴다(기본 100% = 14, DocumentView.BaseEditorFontSize와
             반드시 같은 값). -->
        <!-- A142 ②: FontFamily = Consolas(고정폭, Windows 동봉 폰트라 폴백 걱정 없음).
             TextBox에는 LineHeight·LineStackingStrategy가 없어(TextBlock 전용) 줄 간격을
             속성으로 강제할 수 없다는 A115 조사 판정을 재확인한다 — 고정폭 폰트로 글리프 셀을
             균일화하는 것이 현재 가능한 대응이다. 한글처럼 Consolas에 없는 글자는 시스템 폴백
             글꼴로 그려져 그 줄만 높이가 달라질 수 있으나, 장식(A115)은 줄마다 실측(rect)이라
             정합은 깨지지 않는다. 컨트롤 교체(RichEditBox)는 하지 않는다 — 캐럿 색 한계가
             동일해(A115 ④ 판정) 회귀 위험만 크다. -->
        <TextBox
            x:Name="EditorBox"
            Padding="24,16,24,68"
            VerticalAlignment="Stretch"
            FontSize="14"
            FontFamily="Consolas"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Visibility="Collapsed"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="OnEditorTextChanged"
            KeyDown="OnEditorKeyDown" />

        <!-- A115: 장식 레이어(라인 가이드·¶·EOF) — EditorBox 위(z)에 겹치되 IsHitTestVisible=False로
             입력 불간섭. 그리기는 EditorDecor(코드)가 전담한다. 포커스된 TextBox는 템플릿 Focused
             상태가 불투명 배경을 그려(A80 참고) 아래(z) 레이어는 가려진다 — 그래서 위에 얹고
             아주 옅게 긋는다(색·불투명도 상수는 EditorDecor 상단 한 곳).
             EditorDecor는 GetRectFromCharacterIndex가 주는 EditorBox 로컬 좌표를 이 Canvas 로컬에
             그대로 찍으므로, 두 요소의 레이아웃 제약(정렬·폭 제한)이 같아야 원점이 겹친다. 한쪽만
             바꾸면 장식이 본문에서 통째로 어긋난다 — 그리기 산술에 오프셋 보정을 넣지 말 것.
             A181(v0.192.0): A120/A171의 MaxWidth 900(설정 폭)을 위 EditorBox와 함께 폐지 — 이제
             두 요소 다 제약 없는 Stretch로 창 전체 폭을 쓴다(계약은 "같은 제약"이지 특정 값이
             아니다 — 무제한끼리도 원점은 겹친다).
             A142 ③: 행 번호 거터도 이 Canvas가 그린다 — 레이아웃(정렬·폭)은 일절 건드리지 않으므로
             위 계약은 무변경이다. A181: 폭 제한 폐지로 컬럼 왼쪽 여백(캔버스 음수 x)이 사라져,
             거터는 코드가 EditorBox 왼쪽 패딩에 예약해 둔 자리(DocumentView.UpdateEditorPadding)에
             그려진다. 예약보다 자릿수가 더 커지는 등 자리가 안 나오면 EditorDecor가 거터를 통째로
             숨긴다(본문을 덮지 않는다 — 종전과 같은 폴백). -->
        <Canvas x:Name="DecorLayer" IsHitTestVisible="False" />

        <!-- A190: 마크다운 렌더 뷰 — .md/.markdown이 열리면 기본으로 이 판이 보이고(에디터는
             Collapsed) 하단 바 토글로 편집과 오간다. 내용은 코드(MarkdownRenderer)가 파싱 모델
             (워커 — A42)로부터 조립해 RenderStack에 쌓는다. 패딩은 EditorBox와 같은 값 —
             특히 아래 68은 A152(하단 바 44 오버레이) 스크롤 끝 보정의 복제다.
             대용량(A177 임계 초과)·4MB 잘림 md는 렌더를 생략하고 에디터만 쓴다(A178 성능 원칙).
             장식(DecorLayer)은 에디터 전용이라 이 판 위에는 아무것도 그리지 않는다
             (EditorDecor.RenderCore의 에디터 Visibility 게이트가 걷어 준다).
             A225: 렌더 뷰 줌 — 편집 모드와 같은 축(_zoomPercent)을 ScrollViewer ZoomFactor로
             적용한다(PdfPane·ImageViewerView의 ZoomMode 선례). 랩 폭은 코드가 RenderStack.Width를
             "뷰포트 폭 나누기 배율"로 보정한다(ApplyRenderZoom — PdfPane EnsureContentMinWidth의
             A188 역수 폭 관용구. ZoomMode가 켜지면 콘텐츠 측정 제약이 무한이 되므로 명시 폭이
             랩의 유일한 기준이다). Min=Max 핀 고정은 핀치·내장 줌이 10% 단계 축 밖의 배율을
             만들지 못하게 하는 잠금 — 배율 변경은 ApplyRenderZoom의 ChangeView 한 곳뿐이다. -->
        <ScrollViewer x:Name="RenderPane" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="1">
            <StackPanel x:Name="RenderStack" Padding="24,16,24,68" />
        </ScrollViewer>

        <!-- PDF 페이지 뷰(A16, PdfPane)는 코드에서 지연 생성해 RootGrid 맨 아래(z 순서상 뒤)에 꽂는다 -->
        <TextBlock
            x:Name="PlaceholderText"
            Text="Open a text, Markdown, HTML, or PDF file, or drop one onto the window&#x0A;Plain text files can be edited and saved here (Ctrl+S)"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6" />

        <!-- 하단 상태바(A245 배치 확정): 새 파일(A189) · 저장 · 인쇄(A211) · 편집/뷰 토글(A190) ·
             파일명(star) · 수정됨 · 줌(A181) · 페이지 · [A215 표시 토글 2종] · Fit.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(이미지 v0.27.0과 동일 패턴).
             열기 버튼 칸은 A99에서 제거 → A223에서 문서 바에 한해 부활 → **A256에서 다시 제거**
             (2026-08-27 사용자 확정 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. 그 위임 계약
             IOpenFileRequestSource도 소비처가 사라져 함께 폐기됐다. 열려 있던 문서의 미저장
             가드(A37)는 종전대로 셸 OpenFile 경로가 갖고 있어 셸 버튼 경유에도 그대로 작동한다).
             1:1 버튼 칸은 A111에서 제거 — 100%가 Fit 플라이아웃 4옵션에 들어갔다.
             전체화면 ⛶ 칸은 A151에서 제거 — 셸 하단 바 우측 모드 버튼 2개가 대체한다.
             A245: A215의 star 2개 구조(좌 파일명 star + 우 스페이서 star 사이에 표시 토글)를
             star 1개로 환원 — 표시 토글이 가운데를 떠나 우측 정렬군(줌·페이지 뒤, Fit 앞)으로
             옮겼기 때문이다. 남은 star 하나(파일명 칸)가 좌측군과 우측군 사이의 남는 폭을
             전부 흡수한다. 이 바는 폭 임계 축약 로직이 없어 폭 파생 수치는 없다.
             A264(v0.262.0): 우측 정렬군의 순서를 사용자 확정대로 재부여했다 —
             (좌→우) 언세이브드(c5·미저장 시에만) → 라인 가이드·¶(c6) → PDF 페이지(c7) →
             배율 버튼(c8·A263) → Fit(c9). A245의 순서(수정됨·배율·페이지·가이드·¶·Fit)에서
             표시 토글 그룹과 배율의 자리가 맞바뀐 것이 차분이고, 셸 전체화면 버튼은 이 바 밖
             (셸 하단 바)이라 무관하다. 칸 수(10)·star 1개 구조는 그대로다(폭 파생 수치 없음 —
             이 바에는 폭 임계 축약 로직이 없어 star 칸이 남는 폭을 전부 흡수한다). -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Padding="0,2,0,2">
            <!-- ColumnSpacing 6 = A97(v0.116.0) 전 모듈 공통 간격(구 10). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- c0 A189: New text file 버튼 칸(A256에서 Open 칸이 사라져 좌측군 1번째) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c1 저장 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c2 A211→A245: 인쇄 버튼 칸(좌측군 3번째) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c3 A190: 편집/렌더 토글 버튼 칸(1칸 32px — A27 규격. A245에서 좌측군 끝) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c4 파일명(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 —
                         A245: 유일한 star 칸(구 c5·c7 두 star의 환원) -->
                    <ColumnDefinition Width="*" />
                    <!-- c5 수정됨(●) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c6 A215→A245→A264: 표시 토글 그룹(가이드·¶) — 배율 앞으로 당겼다 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c7 PDF 페이지(A264에서도 같은 칸 — 토글과 배율 사이) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c8 A264: 줌 배율 버튼(A263) — Fit 바로 앞 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- c9 Fit 조절기 2버튼 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- A189 → A247: 새 텍스트 문서(무제) 시작. 상시 활성(A189의 "빈 상태에서만
                     활성" 반전 — 구 판정 UpdateNewFileButton은 제거, IsEnabled는 XAML 기본값
                     true 그대로). 콘텐츠 위 클릭의 미저장 3분기는 OnNewFileClick이 지킨다.
                     빈 상태의 중앙은 셸 썸네일 탐색기(A93)가 차지해 이 뷰의 안내 문구가 안 보이므로
                     진입점은 안내 링크가 아니라 하단 바 버튼이다. 글리프 E7C3 = 문서(빈 파일) —
                     탐색기 파일 타일과 같은 글리프. 핫키 없음(A34 등록 없음 — 툴팁 고정값). -->
                <!-- A256(2026-08-27): Open 버튼 칸 제거 — 셸 S4 'Open file'(A90)과의 병존을
                     해소하고 셸 버튼으로 일원화했다(A223 부분 반전). 위임 계약
                     IOpenFileRequestSource·클릭 핸들러·All Readable 중계도 함께 폐기. -->
                <Button x:Name="NewFileButton" Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnNewFileClick"
                        ToolTipService.ToolTip="New text file">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                </Button>
                <!-- 저장 버튼(A37): 편집 가능한 텍스트가 열려 있고 변경이 있을 때만 활성 -->
                <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnSaveButtonClick"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <!-- A211 배치 3(v0.222.0) → A223 → A245: 인쇄 — 규격 정본은 셸 인쇄 절 주석
                     (MainWindow.xaml.cs, 부록 B 78 확정): 1칸(32×32) 버튼 · 툴팁 "Print (Ctrl+P)" ·
                     A34 문자 핫키는 배정하지 않는다(Ctrl+P 셸 액셀러레이터가 유일한 키) · 활성
                     조건 = CanPrintNow. IsEnabled="False"는 "파일 없음"으로 시작하는 초기값일 뿐,
                     이후 값의 단일 출처는 코드의 UpdatePrintButton()이다. 클릭 = PrintRequested
                     발화 한 줄. A223(2026-08-24)에서 우측 끝(구 c8) → 좌측군, A245(2026-08-27)에서
                     편집/뷰 토글 앞(좌측군 3번째)으로 재이동 — 사용자 확정 순서
                     "새 파일 · 저장 · 인쇄 · 편집/뷰". 폭 파생 수치 없음(임계 축약 로직이
                     없는 바 — star 칸이 흡수). -->
                <Button x:Name="PrintButton" Grid.Column="2" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnPrintButtonClick"
                        ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" FontSize="18" />
                </Button>
                <!-- A190 → A224: 편집 ↔ 뷰 토글(전 텍스트 형식). 텍스트 편집 대상(파일·무제)이
                     있고 잘림이 아니면 활성 — A145 "항상 보이되 비활성" 관용구(판정·글리프·툴팁은
                     UpdateViewToggle). 뷰 모드의 실체는 형식이 정한다: md 렌더 자격이면 렌더 판
                     (A190 그대로), 그 외 텍스트는 잠금 뷰(에디터 그대로 + IsReadOnly). PDF·빈
                     화면·4MB 잘림은 비활성(잘림은 토글이 "편집으로 전환"을 약속하면 안 된다).
                     글리프는 누르면 갈 모드: 편집 중 E890(View) / 뷰 중 E70F(Edit).
                     핫키 없음(A34 등록 없음 — New 버튼과 같은 부류, 초기 툴팁은 고정값).
                     A245: 좌측군 끝(인쇄 뒤)으로 이동 — 칸만 바뀌고 판정·글리프는 무변경. -->
                <Button x:Name="ViewToggleButton" Grid.Column="3" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnViewToggleClick"
                        ToolTipService.ToolTip="View">
                    <FontIcon x:Name="ViewToggleIcon" Glyph="&#xE890;" FontSize="14" />
                </Button>
                <TextBlock x:Name="FileNameText" Grid.Column="4" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="No file open" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 문서가 있는 드라이브" 텍스트를 대체한다 —
                     파일명 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다.
                     A245: star가 하나로 환원돼 스팬이 필요 없어졌다 — 구 c5~c7 스팬은 그 사이에
                     끼어 있던 표시 토글 칸과 우측 스페이서 star를 되찾기 위한 보정이었고, 지금은
                     이 칸 자체가 남는 폭을 전부 먹는 유일한 star다(우측군은 전부 Auto). -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="4"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- 수정됨 표시(A37) — 창 제목의 ●는 셸이 UnsavedChanged로 단다 -->
                <TextBlock x:Name="ModifiedText" Grid.Column="5" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed"
                           Text="● Unsaved" />
                <!-- A215(2026-08-24) → A245(2026-08-27) → A264/A265(2026-08-28): 편집 모드 표시
                     토글 2종 — ① 라인 가이드(줄 상/하단 선 — A115 ①) ② 펑츄에이션 마커(¶·EOF —
                     A115 ②). A215의 자리는 좌우 star 사이(바 가운데)였고, A245에서 우측 정렬군으로,
                     A264에서 그 안의 배율·페이지 **앞**으로 옮겼다(사용자 확정 순서 "언세이브드 →
                     라인 가이드 → ¶ → 배율 → Fit").
                     ⚠️ A265(v0.262.0): A249 확정 예외 4종 중 이 1종을 **공식 해제**했다
                     (2026-08-27 사용자 답변 — "무조건 버튼들 다 보이게·사용 못하면 비활성"의
                     문서 적용. 직전 예외 확정의 명시 개정이지 재확인이 아니다). 그래서 이 그룹은
                     이제 **항상 보이고 활성만 갈린다** — 에디터 표면(EditorBox 표시. A224 잠금 뷰
                     포함)에서만 활성, 렌더 뷰·PDF·빈 화면에서는 비활성(UpdateDecorToggles 단일
                     지점). 아래 IsEnabled="False"가 첫 프레임 값이다(초기 상태 = 빈 화면이라 정합.
                     Fit 조절기의 초기 비활성과 같은 형). 활성 전환은 토글 2개에 각각 건다 —
                     StackPanel(Panel)에는 IsEnabled가 없다(Control의 속성이다).
                     상태는 document.* 키 2개로 즉시 저장(A181 줌 관용구). 초기 IsChecked는
                     코드(생성자)가 설정값으로 맞춘다. 이 토글 2종에는 A34 문자 핫키가 없다 —
                     따라서 비활성 시 차단할 키도 없다(HotkeySupport 게이트는 등록된 키에만 건다).
                     글리프: E7A5(가로줄 무리 — 가이드 근사) 대신 실존 확인이 쉬운 표준 글리프를
                     쓴다 — 가이드 = E8A9(AlignLeft류 가로줄), 마커 = 문자 '¶' 텍스트(글리프 탐색
                     불요 — 마커 자신이 최고의 아이콘이다). -->
                <StackPanel x:Name="DecorTogglePanel" Grid.Column="6" Orientation="Horizontal"
                            Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="GuideToggleButton" Style="{StaticResource BottomBarToggleButtonStyle}"
                                  IsEnabled="False"
                                  Click="OnGuideToggleClick"
                                  ToolTipService.ToolTip="Line guides">
                        <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="MarksToggleButton" Style="{StaticResource BottomBarToggleButtonStyle}"
                                  IsEnabled="False"
                                  Click="OnMarksToggleClick"
                                  ToolTipService.ToolTip="Paragraph marks">
                        <TextBlock Text="¶" FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ToggleButton>
                </StackPanel>
                <!-- PDF 현재 페이지/전체 (A16) — PDF가 열려 있을 때만.
                     A264: 칸 번호는 그대로(c7)지만 이웃이 바뀌었다 — 앞이 표시 토글, 뒤가 배율
                     버튼이다(사용자 미언급 자리라 "¶ 뒤·배율 앞" 제안을 채택). -->
                <TextBlock x:Name="PageInfoText" Grid.Column="7" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed" />
                <!-- A181 → A263(v0.262.0): 현재 줌 배율(document.zoom을 퍼센트로).
                     종전 표시 전용 TextBlock(ZoomText)을 프리셋 드롭다운으로 바꿨다 — 값 표기는
                     그대로 하고, 누르면 프리셋 8종(20/50/75/100/125/150/200/500 — 전부 A229 범위
                     20~500 안이라 접힘이 없다)을 고를 수 있다. 선택 = 코드 OnZoomPresetClick의
                     SetZoom 한 줄이라 범위·적용·저장이 기존 단일 경로 그대로다(제3 경로 없음).
                     A263: 표시는 **상시**다 — 종전 "PDF·빈 화면은 빈 문자열"은 폐기했다(값은
                     전역 저장 배율이라 어느 표면에서든 참이다). 못 바꾸는 표면(PDF·빈 화면)은
                     A249 정책대로 비활성으로만 가른다. PDF에 프리셋을 잇지는 않는다 — PDF 줌은
                     PdfPane의 ZoomFactor·Fit이 지배하는 별개 체계다.
                     내용·활성의 갱신은 DocumentView.UpdateZoomText 한 곳(이름 유지).
                     스타일은 FitOptionsButton과 같은 인라인 값 관용구(높이 32) — DropDownButton은
                     키 있는 기본 스타일이 없어 BasedOn을 쓸 수 없다(App.xaml v0.113.1 주석).
                     폭만 Auto다(내용이 "20%"~"500%"로 가변). A34 문자 핫키 없음(FitOptionsButton과
                     같은 부류 — 툴팁은 고정값). 아래 IsEnabled="False"가 첫 프레임 값이다
                     (초기 상태 = 빈 화면). -->
                <DropDownButton x:Name="ZoomButton" Grid.Column="8"
                                Height="32" Padding="8,2" BorderThickness="1" CornerRadius="4"
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Zoom">
                    <TextBlock x:Name="ZoomText" FontSize="12" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="20%" Tag="20" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="50%" Tag="50" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="75%" Tag="75" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="100%" Tag="100" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="125%" Tag="125" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="150%" Tag="150" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="200%" Tag="200" Click="OnZoomPresetClick" />
                            <MenuFlyoutItem Text="500%" Tag="500" Click="OnZoomPresetClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- A30 상태형 Fit — 본체 = 마지막 옵션 표시·클릭 시 재적용, 화살표 = A83 4옵션.
                     내용·툴팁은 코드(ShowPdfFitState/ShowTextFitState/UpdateFitButton)가 갱신하므로
                     아래 FontIcon은 초기값일 뿐이다(생성자에서 곧바로 빈 화면 표시 "1:1" 상자가 된다 — A260).
                     A111(v0.133.0): 1:1 별도 버튼 제거(100%가 플라이아웃 옵션이 됐다) · 구 Auto-fit = 새 Contain. -->
                <!-- A144: Fit 조절기 = 정사각형 버튼 2개(32+32 = 64×32, 간격 0) — 구 SplitButton
                     (84×32)은 본체/화살표 분할 폭을 WinUI 기본 템플릿이 정해 비율 통제가 안 됐다.
                     CornerRadius 좌/우 분리 + 화살표의 왼쪽 테두리 0으로 한 몸처럼 보인다(가운데
                     경계선 = 본체의 오른쪽 테두리 1px 하나). DropDownButton은 키 있는 기본 스타일이
                     없어 BasedOn 불가(v0.113.1 실기기 이력)라 구 SplitButton처럼 인라인 값으로 적는다.
                     화살표는 내용 없이 내장 셰브론만 표시한다(A키·F키는 본체 FitButton에 그대로). -->
                <!-- A145→A214: 조절기는 콘텐츠가 있는 동안 보이고, PDF는 4옵션 전부·텍스트 갈래
                     (파일·무제 — 편집·잠금 뷰·렌더 뷰 공통)는 Fit height만 뺀 3옵션이 활성이다
                     (높이 무한 — 2026-08-24 사용자 지시로 부록 B 67의 "텍스트 비활성"을 반전).
                     A230(v0.234.0) → A249(v0.246.0, 정면 반전): 빈 화면(중앙 = 셸 썸네일 탐색기)
                     에서 조절기 2개를 접던 것을 되돌려 A145의 "항상 보이되 비활성"으로 복귀했다
                     (2026-08-27 사용자 지시 — 전 모듈 통일). 초기 IsEnabled=False가 그 기본
                     상태다(초기 상태 = 빈 화면이라 첫 프레임부터 정합). A·F 키 차단은 가시성이
                     아니라 IsEnabled가 진다 — HotkeySupport의 통과 게이트가 IsEnabled와
                     Visibility를 함께 보기 때문이다(Shared/HotkeySupport.cs:61).
                     활성 전환은 코드 ShowPdfFitState/ShowTextFitState 한 쌍만 한다. -->
                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FitButton" Style="{StaticResource BottomBarButtonStyle}"
                            CornerRadius="4,0,0,4" IsEnabled="False"
                            Click="OnFitClicked">
                        <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    </Button>
                    <DropDownButton x:Name="FitOptionsButton"
                                    Width="32" Height="32" Padding="4"
                                    BorderThickness="0,1,1,1" CornerRadius="0,4,4,0"
                                    VerticalAlignment="Center" IsEnabled="False">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <!-- 계보 = "1:1" 글자 도형(A143) → 네 모서리 꺾쇠 + 중앙 사각(A184) →
                                     텍스트 "100%"·아이콘 없음(A231) → FontIcon(Segoe UI, 두 글자 "OR")
                                     (A253) → A260(5차·확정, 2026-08-27 사용자 지시).
                                     A253의 다문자 Glyph는 저장소 선례 0건의 1순위 위험 후보였고 그대로
                                     현실화됐다 — 실기기에서 아이콘 칸이 비어 나온다는 사용자 보고.
                                     그래서 FontIcon 다문자 형태는 폐기하고 PathIcon 도형으로 간다.
                                     도형 = 16x16 칸에 외곽 사각 링 + 안쪽 "1:1"(세로 막대 2 + 점 2).
                                     전부 축정렬 사각형이라 저해상도에서 뭉개지지 않는다. 본체 버튼의
                                     테두리 상자 + "1:1"(코드 BuildOriginalRatioBox)이 같은 그림의 짝이다.
                                     링에 구멍이 남는 근거 = 바깥 사각과 안쪽 사각의 진행 방향을 반대로
                                     잡았다. 짝홀·비영 어느 채움 규칙에서도 뚫리므로 FillRule 지정이
                                     필요 없다(파스 위험 축 하나를 없앴다).
                                     ⚠ Data 문자열은 사용처마다 새로 적는다 — Geometry를 공유 리소스로
                                     두고 여러 PathIcon.Data에 걸면 런타임에 앱이 죽는다(v0.174.1 실사례.
                                     App.xaml의 경고 주석 참고). 세 모듈이 같은 문자열을 각자 갖는 것은
                                     그래서 의도적이다. Geometry 타입 속성에 거는 문자열 변환은 성립하는
                                     형태다(PathGeometry.Figures에 미니언어를 넣는 쪽이 WMC0055로 막힌다).
                                     최소 복구법 = 이 MenuFlyoutItem.Icon 블록만 지워 A231의 "아이콘 없음"
                                     으로 되돌리기(다른 변경 무관). -->
                                <MenuFlyoutItem Text="Original" Click="OnFitActualSizeClicked">
                                    <MenuFlyoutItem.Icon>
                                        <PathIcon Data="M1,1 L15,1 L15,15 L1,15 Z M2.5,2.5 L2.5,13.5 L13.5,13.5 L13.5,2.5 Z M4.5,5 L6,5 L6,11 L4.5,11 Z M10,5 L11.5,5 L11.5,11 L10,11 Z M7.5,6.25 L8.5,6.25 L8.5,7.25 L7.5,7.25 Z M7.5,8.75 L8.5,8.75 L8.5,9.75 L7.5,9.75 Z" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Contain" Click="OnFitContainClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9A6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- A214: 텍스트 갈래에서는 이 항목만 비활성(높이 무한 — Fit height
                                     불성립. IsEnabled 전환도 ShowPdfFitState/ShowTextFitState 쌍이 한다) -->
                                <MenuFlyoutItem x:Name="FitHeightItem" Text="Fit height" Click="OnFitHeightClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8CB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <!-- A223→A245: 인쇄 버튼은 좌측군(c2)에 있다 — 선언도 좌측군 자리에 있다. -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
