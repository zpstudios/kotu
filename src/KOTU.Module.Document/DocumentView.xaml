<UserControl
    x:Class="KOTU.Module.Document.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (전 모듈 공통 배치), Ctrl+S 저장 (A37) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- A37: 뷰어 → 에디터 승격. TextBox 하나가 표시·편집을 겸한다.
             A80(v0.91.0): 기존 MaxWidth 900 + HorizontalAlignment Left(v0.44.0 뷰어 유래)를
             제거 — 900px보다 넓은 창에서 포커스된 TextBox 배경이 좌측 900px에만 그려져
             우측이 검게 비어 보였다(오버레이와 무관). 본문이 창 전체 폭을 쓴다.
             4MB 초과 잘림 표시 파일은 IsReadOnly로 두어 잘린 채 저장되는 사고를 막는다. -->
        <TextBox
            x:Name="EditorBox"
            Padding="24,16,24,24"
            VerticalAlignment="Stretch"
            FontSize="14"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Visibility="Collapsed"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="OnEditorTextChanged"
            KeyDown="OnEditorKeyDown" />

        <!-- PDF 페이지 뷰(A16, PdfPane)는 코드에서 지연 생성해 RootGrid 맨 아래(z 순서상 뒤)에 꽂는다 -->
        <TextBlock
            x:Name="PlaceholderText"
            Text="Open a text, Markdown, or PDF file, or drop one onto the window&#x0A;Plain text files can be edited and saved here (Ctrl+S)"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6" />

        <!-- 하단 상태바: 열기 · 저장 · 파일명 · 수정됨 · 페이지 · 드라이브 · 1:1 · Fit · 전체화면.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(이미지 v0.27.0과 동일 패턴). -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 파일명(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(40×40)·2칸(84×40) 두 규격만 —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <Button Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnOpenButtonClick"
                        ToolTipService.ToolTip="Open document file">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <!-- 저장 버튼(A37): 편집 가능한 텍스트가 열려 있고 변경이 있을 때만 활성 -->
                <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnSaveButtonClick"
                        ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <TextBlock x:Name="FileNameText" Grid.Column="2" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="No file open" />
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 문서가 있는 드라이브" 텍스트를 대체한다 —
                     파일명 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter x:Name="DriveStripHost" Grid.Column="2"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- 수정됨 표시(A37) — 창 제목의 ●는 셸이 UnsavedChanged로 단다 -->
                <TextBlock x:Name="ModifiedText" Grid.Column="3" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed"
                           Text="● Unsaved" />
                <!-- PDF 현재 페이지/전체 (A16) — PDF가 열려 있을 때만 -->
                <TextBlock x:Name="PageInfoText" Grid.Column="4" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Visibility="Collapsed" />
                <!-- A49: PDF 전용 1:1(1칸)·상태형 Fit(2칸, A30 규격) — 텍스트 에디터 모드(A37)에서는 숨김.
                     Fit 본체 = 마지막 옵션 표시·클릭 시 재적용, 화살표 = 3옵션. 내용·툴팁은 UpdateFitButton()이 갱신.
                     SplitButton은 WinUI가 키 있는 기본 스타일을 노출하지 않아(BasedOn 대상 없음)
                     전역 스타일 대신 2칸 값(84×40)을 그대로 적는다 — A27(v0.107.0). -->
                <Button x:Name="ActualSizeButton" Grid.Column="5" Style="{StaticResource BottomBarButtonStyle}"
                        Content="1:1" FontSize="13" Visibility="Collapsed"
                        ToolTipService.ToolTip="Actual size (100%)" Click="OnActualSizeClick" />
                <SplitButton x:Name="FitButton" Grid.Column="6" Width="84" Height="40"
                             VerticalAlignment="Center" CornerRadius="4"
                             Visibility="Collapsed" Click="OnFitClicked"
                             ToolTipService.ToolTip="Auto-fit to window — whole page fits, or actual size if smaller">
                    <TextBlock Text="A" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Auto-fit" Click="OnFitAutoClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE9A6;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <!-- 1칸(40×40) = 이미지/영상 ⛶와 통일 (v0.53.0 → A27에서 전역 스타일) -->
                <Button Grid.Column="7" Style="{StaticResource BottomBarButtonStyle}"
                        Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
