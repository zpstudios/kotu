<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <!-- unpackaged 배포 (설계 문서 2장 참고: HW 센서 드라이버 제약 때문) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 단일 인스턴스 처리를 위해 Program.Main 직접 정의 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- 1.8: LibVLCSharp.WinUI(동영상 모듈)의 최소 요구 버전에 맞춰 전 프로젝트 통일 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- libvlc 네이티브 엔진(LGPL, dll 동적 링크) — 빌드 출력에 자동 복사됨 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinUtil.Core\WinUtil.Core.csproj" />
    <ProjectReference Include="..\WinUtil.Module.Image\WinUtil.Module.Image.csproj" />
    <ProjectReference Include="..\WinUtil.Module.Archive\WinUtil.Module.Archive.csproj" />
    <ProjectReference Include="..\WinUtil.Module.Video\WinUtil.Module.Video.csproj" />
  </ItemGroup>

  <!--
    dotnet publish가 unpackaged WinUI 앱의 resources.pri(컴파일된 XAML/XBF 병합 리소스)를
    publish 폴더로 복사하지 않는 문제 대응. 없으면 실행 시 MainWindow.InitializeComponent에서
    XamlParseException("XAML parsing failed")으로 조용히 죽는다. (v0.5.5 배포에서 실증)
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish" Condition="Exists('$(OutDir)resources.pri')">
    <Copy SourceFiles="$(OutDir)resources.pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
