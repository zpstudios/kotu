<UserControl
    x:Class="WinUtil.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (v0.50.0 — 전 화면 공통 배치) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- 항목은 코드에서 채운다 (모듈 목록이 런타임에 정해지므로) -->
            <StackPanel
                x:Name="Root"
                Spacing="12"
                Padding="24"
                MaxWidth="680"
                HorizontalAlignment="Left" />
        </ScrollViewer>

        <!-- 하단 바: 좌측 광고(놀던 공간 활용, v0.50.0 사용자 요청) + 우측 ⛶.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다. -->
        <Border x:Name="ControlBar" Grid.Row="1" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 2:1 광고를 바 높이(40)에 맞춰 표시. SPONSOR 미니 배지 오버레이 -->
                <Grid Grid.Column="0" CornerRadius="4" ToolTipService.ToolTip="Sponsor">
                    <Image x:Name="SponsorImage" Height="40" Stretch="Uniform" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                            Background="#59000000" CornerRadius="2" Padding="3,0,3,1">
                        <TextBlock Text="SPONSOR" FontSize="6" Foreground="White" Opacity="0.9" />
                    </Border>
                </Grid>
                <!-- 폭 48 = 다른 모듈 ⛶와 통일 (v0.49.0 기준) -->
                <Button Grid.Column="2" Width="48" Content="⛶" Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
