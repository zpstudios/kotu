<Window
    x:Class="WinUtil.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Windows 시작 메뉴 스타일 셸(v0.18.0, 기존 좌측 NavigationView 대체):
      하단 바 좌측의 메뉴 버튼을 누르면 위로 플라이아웃이 떠오른다.
      항목 순서(아래→위): 사진·영상·문서 그룹 - 여백 - 압축 - 여백x2 - 스폰서(광고).
      하단 바 우측은 Windows 트레이 위치처럼 Info·Settings 아이콘.
      창 전체 드롭은 유지: 어떤 파일이든 떨어뜨리면 확장자로 담당 모듈에 라우팅.
    -->
    <!-- ScaleHost: UI 스케일 오버라이드(v0.24.0)의 기준 크기. RootLayout에 ScaleTransform을
         걸고 역수 크기를 줘서 창 전체가 선택 배율로 그려지게 한다(ApplyUiScale). -->
    <Grid x:Name="ScaleHost">
    <Grid x:Name="RootLayout" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomBarRow" Height="44" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="ModuleHost"
                        Grid.Row="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <TextBlock Text="Open a file, or use the menu at the bottom left"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"/>
        </ContentControl>

        <!-- 하단 바 (작업표시줄 느낌). 전체화면에서는 코드에서 통째로 숨긴다(v0.21.0) -->
        <Grid x:Name="BottomBar" Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- 현재 모드 액센트 스트립: 하단 바 상단 3px, 모듈 색 (v0.20.0) -->
            <Border x:Name="ModeStrip" Height="3"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="Transparent" IsHitTestVisible="False" />

            <!-- 현재 모드 칩: 모듈 글리프 + 브랜드명, 모듈 색 (v0.20.0).
                 모듈이 하단 바 줄(ModuleBarHost)을 제공하면 칩은 숨기고 스트립 색으로만 구분 -->
            <StackPanel x:Name="ModeChip" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <FontIcon x:Name="ModeChipIcon" FontSize="14" />
                <TextBlock x:Name="ModeChipText" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" />
            </StackPanel>

            <!-- 모듈 제공 하단 바(동영상 트랜스포트 등) — 메뉴 버튼과 우측 아이콘 사이 (v0.21.0) -->
            <ContentControl x:Name="ModuleBarHost"
                            IsTabStop="False"
                            Margin="52,0,88,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" />

            <Button x:Name="StartButton"
                    Margin="6,0,0,0" Padding="12,6"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Menu">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="StartFlyout" Placement="TopEdgeAlignedLeft">
                        <!-- 항목은 코드(BuildStartMenu)에서 채운다 -->
                        <StackPanel x:Name="StartMenuPanel" Width="248" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 우측: Info·Settings (아이콘은 코드에서 모듈 글리프로 채운다) -->
            <StackPanel Orientation="Horizontal" Spacing="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button x:Name="InfoButton" Padding="10,6"
                        Background="Transparent" BorderThickness="0"
                        Click="OnInfoClick" />
                <Button x:Name="SettingsButton" Padding="10,6"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Settings"
                        Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</Window>
