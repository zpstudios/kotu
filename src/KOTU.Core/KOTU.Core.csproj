<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>KOTU 공통 계약(IModule)과 서비스. UI 프레임워크 비의존 — 단위 테스트 가능.</Description>
    <DefineConstants Condition="'$(KotuStandalone)' == 'true'">$(DefineConstants);KOTU_STANDALONE</DefineConstants>
    <DefineConstants Condition="'$(KotuTestBuild)' == 'true'">$(DefineConstants);KOTU_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Appearance\IconCenterlines.txt" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
