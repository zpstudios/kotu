<UserControl
    x:Class="KOTU.Module.Image.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    DoubleTapped="OnDoubleTapped">

    <!-- 단축키: ←/→ 탐색, Delete 휴지통 삭제.
         전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 — 전체화면은 셸의 3단 모드 체계
         (Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다. 이 뷰의 더블클릭 전체화면
         토글(OnDoubleTapped)만 뷰 고유 입력으로 남는다(셸이 프레젠터 변화로 모드를 동기화).
         버튼에 걸린 단독 문자 키(R 회전 · A 100% · F Fit)는 A34에서 코드
         (SetupHotkeys)로 옮겼다 — 툴팁 "(키)" 표기와 키를 한 값에서 만들고,
         텍스트 입력·파일 리스트 포커스에서는 통과시켜야 하기 때문.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Left" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- 줌(휠 단독·Ctrl+휠 10%~800% — A98, 핀치는 내장 유지). 기본은 창맞춤(코드에서 MaxWidth/MaxHeight로 제한).
             팬: 스크롤바·터치/펜 패닝은 ScrollViewer 내장, 마우스 좌버튼 드래그는 A148이 코드에서
             (HookZoomWheel이 잡아 둔 콘텐츠 프레젠터에 포인터 캡처) 얹는다. -->
        <ScrollViewer
            x:Name="Scroller"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            SizeChanged="OnScrollerSizeChanged">
            <Image
                x:Name="ImageControl"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <!-- EXIF 회전 + 사용자 회전(R 키) 합산 각도 -->
                    <!-- 이름 주의: "Rotation"은 UIElement.Rotation을 가려 CS0108 발생 -->
                    <RotateTransform x:Name="RotationTransform" />
                </Image.RenderTransform>
            </Image>
        </ScrollViewer>

        <TextBlock
            x:Name="PlaceholderText"
            Text="Open an image file or drop one onto the window"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- 하단 상태바(A149): 좌측 한 덩어리 = 파일명 · 해상도 · 확장자(비트뎁스) · 용량 · 순번 · EXIF 요약,
             그 오른쪽에 줌 레벨(ZoomText) + 전 모듈 공통 버튼.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.27.0, 동영상 v0.21.0과 동일) -->
        <Border
            x:Name="StatusBar"
            VerticalAlignment="Bottom"
            Padding="12,6"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <!-- A97(v0.116.0): 바 안 요소 간격은 전 모듈 6으로 통일 — 개별 Margin(10/12 혼재)을
                 걷어내고 부모 Grid의 ColumnSpacing 한 곳에서 정한다(다시 흩어지지 않게). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- 파일명·메타(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸.
                         열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
                         1:1 버튼 칸은 A111에서 제거 — 100%가 Fit 플라이아웃 4옵션에 들어갔다. -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <!-- A211 배치 2(v0.221.0): 인쇄 버튼 칸(c4) — 아래 PrintButton 주석 참조. -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- A9 → A149: 파일명 + 메타 요약이 남는 공간을 나눠 쓴다. 파일명이 우선(Auto),
                     메타는 남는 폭에서 말줄임(전체 텍스트는 툴팁 — 폭 임계 축약 로직은 두지 않는다).
                     A149 메타 순서 = 해상도 · 확장자(비트뎁스) · 용량 · 순번 · EXIF 요약
                     (A9의 용량·종류·EXIF 순서를 사용자 확정 순서로 재조립. 조립은 BuildMetaText). -->
                <Grid x:Name="FileInfoPanel" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FileNameText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MetaText"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 이미지가 있는 드라이브" 텍스트를 대체한다 —
                     파일명·메타 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter
                    x:Name="DriveStripHost"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <!-- A149: 현재 줌 레벨(Scroller.ZoomFactor를 퍼센트로). 칸 번호는 그대로 1 —
                     이름만 InfoText에서 바꿨다(셸 ContentInfoOverlay.xaml에도 InfoText가 있어 grep이 오염된다).
                     Fit 버튼 본체는 "모드"(1:1/Contain/Fit width/Fit height), 여기는 "실제 배율"이라 역할이 다르다. -->
                <TextBlock
                    x:Name="ZoomText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
                <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): Rotate = 1칸, Fit = 1칸 버튼 2개
                     (A144에서 구 2칸 SplitButton 84×32를 32+32 = 64×32로 재구성).
                     1:1 별도 버튼은 A111에서 제거 — 100%가 Fit 플라이아웃 옵션이 됐다.
                     전체화면 ⛶은 A151에서 셸 하단 바 우측 모드 버튼 2개로 이관. -->
                <Button
                    x:Name="RotateButton"
                    Grid.Column="2"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnRotateButtonClick">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" />
                </Button>
                <!-- A144: Fit 조절기 = 정사각형 버튼 2개(32+32 = 64×32, 간격 0) —
                     구 SplitButton(A111 도입, 84×32)은 본체/화살표 분할 폭을 WinUI 기본 템플릿이
                     정해 비율 통제가 안 됐다. 본체 Button = 마지막 옵션 표시·클릭 시 재적용
                     (내용·툴팁은 UpdateFitButton()이 갱신하므로 아래 FontIcon은 초기값(Contain)일
                     뿐이다), 화살표 DropDownButton = A83 4옵션 플라이아웃.
                     CornerRadius 좌/우 분리 + 화살표의 왼쪽 테두리 0으로 한 몸처럼 보인다
                     (가운데 경계선 = 본체의 오른쪽 테두리 1px 하나). DropDownButton은 키 있는
                     기본 스타일이 없어 BasedOn 불가(v0.113.1 실기기 이력)라 구 SplitButton처럼
                     인라인 값으로 적는다. 화살표는 A34 키가 없어 툴팁을 XAML에 적고,
                     내용 없이 내장 셰브론만 표시한다(A키·F키는 본체 FitButton에 그대로). -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        x:Name="FitButton"
                        Style="{StaticResource BottomBarButtonStyle}"
                        CornerRadius="4,0,0,4"
                        Click="OnFitClick">
                        <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    </Button>
                    <DropDownButton
                        x:Name="FitOptionsButton"
                        Width="32" Height="32" Padding="4"
                        BorderThickness="0,1,1,1" CornerRadius="0,4,4,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Fit options">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <!-- A143/v0.174.1: 100% 아이콘 = 인라인 path 문자열(Geometry 타입 속성의
                                     문자열 변환은 파싱마다 새 인스턴스를 만든다). 종전 App.xaml 공유
                                     PathGeometry StaticResource는 런타임 XamlParseException으로 앱을 죽였다
                                     (WinUI Geometry는 부모 1개뿐 — 공유 불가. CI는 컴파일만 하므로 못 잡는다).
                                     좌표 정본 = 이 문자열 + 코드 비하인드 BuildActualSizeIconGeometry().
                                     모양 수정 시 세 모듈(이미지·문서·영상) × 2곳 = 6곳을 함께 고칠 것.
                                     형제는 Segoe 글리프, 여기만 PathIcon(A111 판정 — 맞는 글리프가 없다.
                                     A184에서 재탐색했지만 뒤집을 글리프를 못 찾아 판정 유지).
                                     A184 도형 = 바깥 네 모서리 꺾쇠 4개(획 1.5) + 가운데 채움 사각형 4x4.
                                     "원본 크기 프레임 그대로"라는 뜻이고, 확대/축소 화살표가 없어 Contain류와
                                     구분된다(종전 "1:1" 글자 형상은 어색하다는 사용자 보고로 폐기). -->
                                <MenuFlyoutItem Text="100%" Click="OnFitActualSizeClick">
                                    <MenuFlyoutItem.Icon>
                                        <PathIcon Data="M 2,2 L 6,2 6,3.5 3.5,3.5 3.5,6 2,6 Z M 14,2 L 10,2 10,3.5 12.5,3.5 12.5,6 14,6 Z M 14,14 L 10,14 10,12.5 12.5,12.5 12.5,10 14,10 Z M 2,14 L 6,14 6,12.5 3.5,12.5 3.5,10 2,10 Z M 6,6 L 10,6 10,10 6,10 Z" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Contain" Click="OnFitContainClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9A6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8CB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <!-- A211 배치 2(v0.221.0): 인쇄 c4 — 규격은 셸 인쇄 절 주석(MainWindow.xaml.cs,
                     부록 B 78 확정)이 정본이다: 1칸(32×32) 버튼 · 툴팁 "Print (Ctrl+P)" ·
                     A34 문자 핫키는 배정하지 않는다(Ctrl+P 셸 액셀러레이터가 유일한 키) ·
                     활성 조건 = IPrintPageProvider.CanPrintNow. 여기 IsEnabled="False"는
                     "파일 없음"으로 시작하는 초기값일 뿐이고, 이후 값의 단일 출처는
                     코드의 UpdatePrintButton()이다. 클릭 = PrintRequested 발화 한 줄
                     (셸이 ShowModule에서 구독해 MainWindow.RequestPrint로 흘린다).
                     A11(영상 루프 c9) 칸 추가 선례와 같은 형 — 새 칸은 오른쪽 끝에 붙인다.
                     ⚠️ 폭 계수(A144·A11의 여유 산식에 해당하는 것): **이 바에는 재계수할 파생
                     수치가 없다.** 영상 바의 축약 임계(UpdateCompactTransport 640)는 고정 폭
                     요소 합에서 나온 수치인데, 이미지 바는 애초에 폭 임계 축약 로직을 두지 않고
                     남는 폭에서 메타 텍스트를 말줄임으로 흡수하는 설계다(위 FileInfoPanel 주석).
                     늘어난 38(버튼 32 + ColumnSpacing 6)은 * 칸(파일명·메타)에서 나온다. -->
                <Button
                    x:Name="PrintButton"
                    Grid.Column="4"
                    Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Print (Ctrl+P)"
                    Click="OnPrintButtonClick">
                    <FontIcon Glyph="&#xE749;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
