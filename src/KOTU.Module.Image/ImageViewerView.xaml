<UserControl
    x:Class="KOTU.Module.Image.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    DoubleTapped="OnDoubleTapped">

    <!-- 단축키: ←/→ 탐색, Delete 휴지통 삭제, F11 전체화면.
         Enter 전체화면(v0.29.0)은 A86(v0.121.0)에서 제거 — Enter는 셸의 오버레이 일괄 토글 키가
         됐고, keymap의 전체화면 예외는 영상 모듈뿐이다(전체화면은 F11로).
         버튼에 걸린 단독 문자 키(R 회전 · A 1:1 · F Fit)는 A34에서 코드
         (SetupHotkeys)로 옮겼다 — 툴팁 "(키)" 표기와 키를 한 값에서 만들고,
         텍스트 입력·파일 리스트 포커스에서는 통과시켜야 하기 때문.
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Left" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- 줌(휠 단독·Ctrl+휠 10%~800% — A98, 핀치는 내장 유지)/팬. 기본은 창맞춤(코드에서 MaxWidth/MaxHeight로 제한) -->
        <ScrollViewer
            x:Name="Scroller"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            SizeChanged="OnScrollerSizeChanged">
            <Image
                x:Name="ImageControl"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <!-- EXIF 회전 + 사용자 회전(R 키) 합산 각도 -->
                    <!-- 이름 주의: "Rotation"은 UIElement.Rotation을 가려 CS0108 발생 -->
                    <RotateTransform x:Name="RotationTransform" />
                </Image.RenderTransform>
            </Image>
        </ScrollViewer>

        <TextBlock
            x:Name="PlaceholderText"
            Text="Open an image file or drop one onto the window"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- 하단 상태바: 파일명 · 해상도 · 몇 번째/전체.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.27.0, 동영상 v0.21.0과 동일) -->
        <Border
            x:Name="StatusBar"
            VerticalAlignment="Bottom"
            Padding="12,6"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <!-- A97(v0.116.0): 바 안 요소 간격은 전 모듈 6으로 통일 — 개별 Margin(10/12 혼재)을
                 걷어내고 부모 Grid의 ColumnSpacing 한 곳에서 정한다(다시 흩어지지 않게). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- 파일명·메타(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸.
                         열기 버튼 칸은 A99에서 제거 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화. -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(36×36)·2칸(84×36) 두 규격만 (A97/v0.116.0에서 40→36) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- A9: 파일명 + 메타 요약(용량·종류·EXIF)이 남는 공간을 나눠 쓴다.
                     파일명이 우선(Auto), 메타는 남는 폭에서 말줄임(전체 텍스트는 툴팁). -->
                <Grid x:Name="FileInfoPanel" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FileNameText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MetaText"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 이미지가 있는 드라이브" 텍스트를 대체한다 —
                     파일명·메타 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter
                    x:Name="DriveStripHost"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="InfoText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
                <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): Rotate·1:1·전체화면 = 1칸,
                     Auto-fit = 2칸 + 핏 옵션 전부 아이콘(A27에서 확정 → A97에서 84×36). -->
                <Button
                    x:Name="RotateButton"
                    Grid.Column="2"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnRotateButtonClick">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" />
                </Button>
                <Button
                    x:Name="ActualSizeButton"
                    Grid.Column="3"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Content="1:1"
                    FontSize="13"
                    Click="OnActualSizeClick" />
                <!-- 기본 클릭 = 자동 맞춤(긴 변이 잘리지 않게). 화살표로 좌우/상하 채움 선택.
                     SplitButton은 WinUI가 키 있는 기본 스타일을 노출하지 않아(BasedOn 대상 없음)
                     전역 스타일 대신 2칸 값(84×36)을 그대로 적는다 — A27(v0.107.0),
                     높이는 A97(v0.116.0)에서 40→36. 폭 84는 유지. -->
                <SplitButton
                    x:Name="FitButton"
                    Grid.Column="4"
                    Width="84" Height="36"
                    VerticalAlignment="Center" CornerRadius="4"
                    Click="OnFitClick">
                    <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button
                    Grid.Column="5"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnFullScreenButtonClick"
                    ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
