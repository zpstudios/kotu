<UserControl
    x:Class="KOTU.Module.Image.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    DoubleTapped="OnDoubleTapped">

    <!-- 단축키: ←/→ 탐색, Delete 휴지통 삭제.
         전체화면 계열(F11·Esc 액셀러레이터)은 A151에서 제거 — 전체화면은 셸의 3단 모드 체계
         (Enter 순환·Alt+Enter·Esc·하단 바 모드 버튼)가 담당한다. 이 뷰의 더블클릭 전체화면
         토글(OnDoubleTapped)만 뷰 고유 입력으로 남는다(셸이 프레젠터 변화로 모드를 동기화).
         버튼에 걸린 단독 문자 키(R 회전 · A 100% · F Fit)는 A34에서 코드
         (SetupHotkeys)로 옮겼다 — 툴팁 "(키)" 표기와 키를 한 값에서 만들고,
         텍스트 입력·파일 리스트 포커스에서는 통과시켜야 하기 때문.
         A111(v0.133.0)에서 1:1 버튼이 사라져 A·F 둘 다 Fit 버튼에 걸린다(의미는 무변경).
         O(열기)는 A99에서 열기 버튼과 함께 소멸 — 파일 열기는 셸 S4 'Open file'(A90)로 일원화.
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Left" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- 줌(휠 단독·Ctrl+휠 10%~800% — A98, 핀치는 내장 유지). 기본은 창맞춤(코드에서 MaxWidth/MaxHeight로 제한).
             팬: 스크롤바·터치/펜 패닝은 ScrollViewer 내장, 마우스 좌버튼 드래그는 A148이 코드에서
             (HookZoomWheel이 잡아 둔 콘텐츠 프레젠터에 포인터 캡처) 얹는다. -->
        <ScrollViewer
            x:Name="Scroller"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            SizeChanged="OnScrollerSizeChanged">
            <Image
                x:Name="ImageControl"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <!-- EXIF 회전 + 사용자 회전(R 키) 합산 각도 -->
                    <!-- 이름 주의: "Rotation"은 UIElement.Rotation을 가려 CS0108 발생 -->
                    <RotateTransform x:Name="RotationTransform" />
                </Image.RenderTransform>
            </Image>
        </ScrollViewer>

        <TextBlock
            x:Name="PlaceholderText"
            Text="Open an image file or drop one onto the window"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- 하단 상태바(A149): 좌측 한 덩어리 = 파일명 · 해상도 · 확장자(비트뎁스) · 용량 · 순번 · EXIF 요약,
             그 오른쪽에 줌 레벨(ZoomText) + 전 모듈 공통 버튼.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.27.0, 동영상 v0.21.0과 동일) -->
        <Border
            x:Name="StatusBar"
            VerticalAlignment="Bottom"
            Padding="12,6"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <!-- A97(v0.116.0): 바 안 요소 간격은 전 모듈 6으로 통일 — 개별 Margin(10/12 혼재)을
                 걷어내고 부모 Grid의 ColumnSpacing 한 곳에서 정한다(다시 흩어지지 않게). -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <!-- A362: 왼쪽 회전, 가변 파일 정보, 오른쪽 Zoom84 / Print32 / Fit70. -->
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(32×32)·2칸(84×32) 두 규격만
                     (A97/v0.116.0에서 40→36, A106/v0.132.0에서 36→32) —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <!-- A34: 핫키가 붙은 버튼의 툴팁은 코드(SetupHotkeys)가 키와 함께 만든다. -->
                <!-- A211 배치 2(v0.221.0) → A252(v0.246.0): 인쇄 c0 — 규격은 셸 인쇄 절 주석
                     (MainWindow.xaml.cs, 부록 B 78 확정)이 정본이다: 1칸(32×32) 버튼 ·
                     툴팁 "Print (Ctrl+P)" · A34 문자 핫키는 배정하지 않는다(Ctrl+P 셸
                     액셀러레이터가 유일한 키) · 활성 조건 = IPrintPageProvider.CanPrintNow.
                     여기 IsEnabled="False"는 "파일 없음"으로 시작하는 초기값일 뿐이고, 이후 값의
                     단일 출처는 코드의 UpdatePrintButton()이다. 클릭 = PrintRequested 발화 한 줄
                     (셸이 ShowModule에서 구독해 MainWindow.RequestPrint로 흘린다).
                     A252: 자리를 맨 끝(구 c4)에서 좌측 정렬군 선두(c0)로 옮겼다 — A211 배치 2의
                     "새 칸은 오른쪽 끝" 결정을 뒤집은 것이고(전 모듈 좌측군 통일), 선언 순서도
                     칸 순서에 맞춰 바 맨 앞으로 옮겼다(영상 A216 루프 칸 이동과 같은 형).
                     ⚠️ 폭 계수: **이 바에는 재계수할 파생 수치가 없다.** 영상 바의 축약 임계
                     (UpdateCompactTransport)는 고정 폭 요소 합에서 나온 수치인데, 이미지 바는
                     애초에 폭 임계 축약 로직을 두지 않고 남는 폭에서 메타 텍스트를 말줄임으로
                     흡수하는 설계다(아래 FileInfoPanel 주석). 버튼 32 + ColumnSpacing 6은
                     자리가 어디든 * 칸(파일명·메타)에서 나온다. -->
                <Button
                    x:Name="PrintButton" Grid.Column="3"
                    Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Print (Ctrl+P)"
                    Click="OnPrintButtonClick">
                    <FontIcon Glyph="&#xE749;" FontSize="18" />
                </Button>
                <!-- A9 → A149: 파일명 + 메타 요약이 남는 공간을 나눠 쓴다. 파일명이 우선(Auto),
                     메타는 남는 폭에서 말줄임(전체 텍스트는 툴팁 — 폭 임계 축약 로직은 두지 않는다).
                     A149 메타 순서 = 해상도 · 확장자(비트뎁스) · 용량 · 순번 · EXIF 요약
                     (A9의 용량·종류·EXIF 순서를 사용자 확정 순서로 재조립. 조립은 BuildMetaText). -->
                <Grid x:Name="FileInfoPanel" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FileNameText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MetaText"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 이미지가 있는 드라이브" 텍스트를 대체한다 —
                     파일명·메타 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter
                    x:Name="DriveStripHost"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <!-- A149: 현재 줌 레벨(Scroller.ZoomFactor를 퍼센트로). 이름만 InfoText에서 바꿨다
                     (셸 ContentInfoOverlay.xaml에도 InfoText가 있어 grep이 오염된다).
                     칸 번호는 A252에서 1 → 2(앞에 인쇄 칸이 들어와 한 칸씩 밀렸다).
                     Fit 버튼 본체는 "모드"(1:1/Contain/Fit width/Fit height), 여기는 "실제 배율"이라 역할이 다르다. -->
                <TextBlock
                    x:Name="ZoomText" Width="84" TextAlignment="Center"
                    Grid.Column="2"
                    VerticalAlignment="Center" />
                <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): Rotate = 1칸, Fit = 1칸 버튼 2개
                     (A144에서 구 2칸 SplitButton 84×32를 32+32 = 64×32로 재구성).
                     1:1 별도 버튼은 A111에서 제거 — 100%가 Fit 플라이아웃 옵션이 됐다.
                     전체화면 ⛶은 A151에서 셸 하단 바 우측 모드 버튼 2개로 이관. -->
                <!-- A251(v0.246.0): 회전은 볼 그림이 있을 때만 활성 — A249 정책("현재 모듈에서 쓰는
                     버튼은 항상 표시, 사용 불가면 비활성")의 이미지 적용분이다. 여기 IsEnabled="False"는
                     "파일 없음"으로 시작하는 초기값일 뿐이고 이후 값의 단일 출처는 코드의
                     UpdateRotateButton()이다(판정 축 = Fit 조절기와 같은 _navigator.Current).
                     R 키는 HotkeySupport가 버튼의 IsEnabled를 보고 자동으로 통과시킨다(:61 게이트) —
                     비활성 버튼에 키가 새지 않는다. 칸 번호는 A252에서 2 → 3. -->
                <Button
                    x:Name="RotateButton" Grid.Column="0"
                    Style="{StaticResource BottomBarButtonStyle}"
                    IsEnabled="False"
                    Click="OnRotateButtonClick">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" />
                </Button>
                <!-- A365: Fit은 독립 버튼32 + 간격6 + 화살표32 = 70폭이다. 두 버튼 모두 전체 테두리와 둥근 모서리를 쓴다. -->
                <!-- A230(v0.234.0) → A249(v0.246.0, 정면 반전): 빈 상태(볼 파일 없음 = 중앙이 셸
                     썸네일 탐색기)에서 조절기 2개를 접던 것을 되돌려 **항상 표시 + 비활성**으로 간다
                     (A145 "항상 보이되 비활성" 원칙의 전 모듈 복원 — 2026-08-27 사용자 지시).
                     초기 IsEnabled=False가 그 기본 상태다: 생성자는 파일 인자가 없으면 그대로 빈
                     상태고, 있으면 폴더 스캔·디코드가 끝난 뒤 UpdateStatusBar가 켠다(첫 프레임
                     정합. 3모듈 일관). A·F 키 차단은 가시성이 아니라 IsEnabled가 진다 —
                     HotkeySupport의 통과 게이트가 IsEnabled와 Visibility를 함께 보기 때문에
                     (Shared/HotkeySupport.cs:61) 비활성만으로 키가 새지 않는다. 칸은 A252에서 3 → 4. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button
                        x:Name="FitButton"
                        Style="{StaticResource BottomBarButtonStyle}"
                        IsEnabled="False"
                        Click="OnFitClick">
                        <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    </Button>
                    <DropDownButton x:Name="FitOptionsButton" Style="{StaticResource BottomBarFitOptionsStyle}"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Fit options">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <!-- 계보 = "1:1" 글자 도형(A143) → 네 모서리 꺾쇠 + 중앙 사각(A184) →
                                     텍스트 "100%"·아이콘 없음(A231) → FontIcon(Segoe UI, 두 글자 "OR")
                                     (A253) → A260(5차·확정, 2026-08-27 사용자 지시) → A310(본체와 통일).
                                     A253의 다문자 Glyph는 저장소 선례 0건의 1순위 위험 후보였고 그대로
                                     현실화됐다 — 실기기에서 아이콘 칸이 비어 나온다는 사용자 보고.
                                     그래서 FontIcon 다문자 형태는 폐기하고 PathIcon 도형으로 갔다.
                                     A310: 그 PathIcon의 Data 인라인 문자열(정사각 링 + 세로 막대 2 + 점 2)을
                                     지우고 아이콘 자체를 코드에서 대입한다 — 도형이 본체 버튼의 상자와
                                     달라 "위아래 1:1이 미세하게 다르다"는 사용자 보고가 났기 때문이다.
                                     이제 두 그림 모두 Shared/FitIcons 한 파일이 그린다
                                     (본체 = BuildOriginalRatioBox · 여기 = BuildOriginalRatioIcon).
                                     x:Name은 그 대입을 위해 붙였다(대입 지점 = 생성자 한 줄.
                                     문서 모듈의 FitHeightItem과 같은 형태다).
                                     ⚠ 아이콘은 항목마다 새 인스턴스여야 한다 — Geometry·요소를 공유
                                     리소스로 두고 여러 부모에 걸면 런타임에 앱이 죽는다(v0.174.1 실사례.
                                     App.xaml의 경고 주석 참고). 팩토리가 호출마다 새로 만들어 돌려주므로
                                     그 규칙은 지켜진다.
                                     최소 복구법 = 생성자의 Icon 대입 한 줄을 지우기(A231의 "아이콘 없음"
                                     으로 되돌아간다. 다른 변경 무관). -->
                                <MenuFlyoutItem x:Name="FitOriginalItem" Text="Original" Click="OnFitActualSizeClick" />
                                <MenuFlyoutItem Text="Contain" Click="OnFitContainClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9A6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8CB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <!-- A362: 인쇄는 공통 오른쪽 c3, 회전은 고유 왼쪽 c0이다. -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
