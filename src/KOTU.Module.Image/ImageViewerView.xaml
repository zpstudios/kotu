<UserControl
    x:Class="KOTU.Module.Image.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    DoubleTapped="OnDoubleTapped">

    <!-- 단축키: ←/→ 탐색, R 회전, Delete 휴지통 삭제, Enter/F11 전체화면(동영상과 동일, v0.29.0).
         PlacementMode=Hidden: 안 그러면 WinUI가 키 이름("Left" 등) 툴팁을 화면 중앙에 띄운다. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="OnPreviousInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnNextInvoked" />
        <KeyboardAccelerator Key="R" Invoked="OnRotateInvoked" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
        <KeyboardAccelerator Key="Enter" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <!-- 줌(Shift+휠 10%~800% — A84, 핀치는 내장 유지)/팬. 기본은 창맞춤(코드에서 MaxWidth/MaxHeight로 제한) -->
        <ScrollViewer
            x:Name="Scroller"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            SizeChanged="OnScrollerSizeChanged">
            <Image
                x:Name="ImageControl"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <!-- EXIF 회전 + 사용자 회전(R 키) 합산 각도 -->
                    <!-- 이름 주의: "Rotation"은 UIElement.Rotation을 가려 CS0108 발생 -->
                    <RotateTransform x:Name="RotationTransform" />
                </Image.RenderTransform>
            </Image>
        </ScrollViewer>

        <TextBlock
            x:Name="PlaceholderText"
            Text="Open an image file or drop one onto the window"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <!-- 하단 상태바: 파일명 · 해상도 · 몇 번째/전체.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(v0.27.0, 동영상 v0.21.0과 동일) -->
        <Border
            x:Name="StatusBar"
            VerticalAlignment="Bottom"
            Padding="12,6"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- 파일명·메타(파일 있음) / 드라이브 줄(파일 없음, A22) 공용 칸 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A27(v0.107.0): 하단 바 버튼은 1칸(40×40)·2칸(84×40) 두 규격만 —
                     치수·테두리·수직 중앙은 앱 전역 스타일(App.xaml)이 정한다. -->
                <Button
                    Grid.Column="0"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Margin="0,0,12,0"
                    Click="OnOpenButtonClick"
                    ToolTipService.ToolTip="Open image file">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <!-- A9: 파일명 + 메타 요약(용량·종류·EXIF)이 남는 공간을 나눠 쓴다.
                     파일명이 우선(Auto), 메타는 남는 폭에서 말줄임(전체 텍스트는 툴팁). -->
                <Grid x:Name="FileInfoPanel" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FileNameText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MetaText"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- A22(v0.108.0): 파일이 열려 있지 않을 때만 뜨는 공용 드라이브 줄(셸이 주입).
                     v0.47.0의 "현재 이미지가 있는 드라이브" 텍스트를 대체한다 —
                     파일명·메타 칸과 같은 자리를 쓰고 둘은 서로 배타적으로 표시된다. -->
                <ContentPresenter
                    x:Name="DriveStripHost"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="InfoText"
                    Grid.Column="2"
                    Margin="12,0"
                    VerticalAlignment="Center" />
                <!-- 우측 공통 메뉴(v0.53.0 사용자 스펙): Rotate·1:1·전체화면 = 1칸,
                     Auto-fit = 2칸 + 핏 옵션 전부 아이콘(A27에서 84×40으로 확정). -->
                <Button
                    Grid.Column="3"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Click="OnRotateButtonClick"
                    ToolTipService.ToolTip="Rotate 90° clockwise (R)">
                    <FontIcon Glyph="&#xE7AD;" FontSize="18" />
                </Button>
                <Button
                    Grid.Column="4"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Margin="10,0,0,0"
                    Content="1:1"
                    FontSize="13"
                    Click="OnActualSizeClick"
                    ToolTipService.ToolTip="Actual size (100%)" />
                <!-- 기본 클릭 = 자동 맞춤(긴 변이 잘리지 않게). 화살표로 좌우/상하 채움 선택.
                     SplitButton은 WinUI가 키 있는 기본 스타일을 노출하지 않아(BasedOn 대상 없음)
                     전역 스타일 대신 2칸 값(84×40)을 그대로 적는다 — A27(v0.107.0). -->
                <SplitButton
                    Grid.Column="5"
                    Margin="10,0,0,0"
                    Width="84" Height="40"
                    VerticalAlignment="Center" CornerRadius="4"
                    Click="OnFitClick"
                    ToolTipService.ToolTip="Auto-fit to window — long edge fits, nothing cropped">
                    <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Fit width" Click="OnFitWidthClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Fit height" Click="OnFitHeightClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8CB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button
                    Grid.Column="6"
                    Style="{StaticResource BottomBarButtonStyle}"
                    Margin="10,0,0,0"
                    Click="OnFullScreenButtonClick"
                    ToolTipService.ToolTip="Full screen (Enter)">
                    <FontIcon Glyph="&#xE740;" FontSize="18" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
