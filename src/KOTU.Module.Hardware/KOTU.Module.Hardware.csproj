<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Description>하드웨어 모듈: WMI 기반 스펙 표시(CPU·메인보드·메모리·그래픽·저장장치) + 센서 모니터링 그래프(A17). 스트레스는 Phase 5c.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <!-- WMI 조회(Win32_Processor 등) — 관리자 권한 불필요.
         LibreHardwareMonitorLib 계열이 10.0.2+ 하한을 요구 — 직접 참조가 더 낮으면 NU1605.
         와일드카드로 항상 최신 10.0.x를 잡아 전이 하한과의 충돌을 피한다. -->
    <PackageReference Include="System.Management" Version="10.0.*" />
    <!-- 센서 수집(온도·전력·팬 등, A17) — MPL-2.0. 0.9.5부터 WinRing0가 제거되고 별도 설치형
         서명 드라이버 PawnIO 기반(A47 조사): 드라이버 본체는 동봉되지 않고 서명 모듈(.bin)만
         내장한다. CPU MSR·SuperIO 계열 센서는 관리자 권한 + PawnIO 설치가 모두 있어야 잡히고
         SMART 온도는 관리자 권한만 필요하다(빠지면 해당 채널만 조용히 null). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KOTU.Core\KOTU.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A34(v0.112.0): 버튼 핫키 공용 지원(키 등록·툴팁 표기·통과 판정). KOTU.Core는 UI 비의존이라 소스 링크로 공유한다. -->
    <Compile Include="..\Shared\HotkeySupport.cs" Link="HotkeySupport.cs" />
  </ItemGroup>
</Project>
