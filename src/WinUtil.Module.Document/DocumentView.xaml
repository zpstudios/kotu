<UserControl
    x:Class="WinUtil.Module.Document.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- F11 전체화면 토글, Esc는 전체화면일 때만 복귀 (전 모듈 공통 배치) -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock
                x:Name="ContentText"
                Padding="24,16,24,24"
                MaxWidth="900"
                HorizontalAlignment="Left"
                FontSize="14"
                LineHeight="22"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
        </ScrollViewer>

        <TextBlock
            x:Name="PlaceholderText"
            Text="Open a text or Markdown file, or drop one onto the window&#x0A;(PDF and HWP support is on the way)"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6" />

        <!-- 하단 상태바: 열기 · 파일명 · 전체화면.
             셸이 TakeBottomBar()로 떼어가 하단 바 한 줄에 얹는다(이미지 v0.27.0과 동일 패턴). -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Padding="0,2,0,2">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnOpenButtonClick"
                        ToolTipService.ToolTip="Open document file">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <TextBlock x:Name="FileNameText" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="No file open" />
                <Button Grid.Column="2" Content="⛶" Click="OnFullScreenButtonClick"
                        ToolTipService.ToolTip="Full screen (F11)" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
