+static bool RequiresInitialWindowFrame(const std::vector<RECORDING_SOURCE *> &sources)
+{
+	return std::any_of(sources.begin(), sources.end(), [](const RECORDING_SOURCE *source) {
+		return source && source->Type == RecordingSourceType::Window && source->IsVideoCaptureEnabled.value_or(true);
+	});
+}
+
+static CAPTURE_RESULT WaitForInitialWindowFrame(ScreenCaptureManager *capture, HANDLE errorEvent,
+	const Concurrency::cancellation_token &token)
+{
+	const ULONGLONG started = GetTickCount64();
+	while (true) {
+		if (token.is_canceled())
+			return CAPTURE_RESULT(HRESULT_FROM_WIN32(ERROR_CANCELLED), L"Window recording was canceled before its first frame.");
+		if (WaitForSingleObjectEx(errorEvent, 0, FALSE) == WAIT_OBJECT_0)
+			return CAPTURE_RESULT(E_FAIL, L"Window capture failed before its first frame.");
+		const ULONGLONG elapsed = GetTickCount64() - started;
+		if (elapsed >= 5000)
+			return CAPTURE_RESULT(HRESULT_FROM_WIN32(ERROR_TIMEOUT), L"The selected window did not provide a frame within 5 seconds. Show the window and try again.");
+		const INT64 slice = static_cast<INT64>(std::min<ULONGLONG>(100, 5000 - elapsed)) * 10000;
+		// Frame은 capture 소유의 빌린 포인터이므로 보관하거나 Release하지 않는다.
+		CAPTURED_FRAME frame{};
+		const HRESULT hr = capture->AcquireNextFrame(slice, slice, token, &frame);
+		if (token.is_canceled())
+			return CAPTURE_RESULT(HRESULT_FROM_WIN32(ERROR_CANCELLED), L"Window recording was canceled before its first frame.");
+		if (FAILED(hr) && hr != DXGI_ERROR_WAIT_TIMEOUT)
+			return CAPTURE_RESULT(hr, L"Window capture failed before its first frame.");
+		if (WaitForSingleObjectEx(errorEvent, 0, FALSE) == WAIT_OBJECT_0)
+			return CAPTURE_RESULT(E_FAIL, L"Window capture failed before its first frame.");
+		if (GetTickCount64() - started >= 5000)
+			return CAPTURE_RESULT(HRESULT_FROM_WIN32(ERROR_TIMEOUT), L"The selected window did not provide a frame within 5 seconds. Show the window and try again.");
+		if (SUCCEEDED(hr) && capture->IsInitialFrameWriteComplete())
+			return CAPTURE_RESULT(S_OK);
+	}
+}
